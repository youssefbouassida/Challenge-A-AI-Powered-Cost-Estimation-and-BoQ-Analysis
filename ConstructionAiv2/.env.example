# ---------- STEP 1: Azure Content Understanding (Foundry) ----------
AZURE_CU_ENDPOINT=https://ai-hub-tum-summarizer.openai.azure.com/
AZURE_CU_KEY=your-azure-key
# Same analyzer as your existing JSON ("analyzerId"), or prebuilt-layout (text + tables, no LLM cost)
AZURE_CU_ANALYZER=prebuilt-layout
# Same version as your existing JSON ("apiVersion"); 2025-11-01 is the GA version
AZURE_CU_API_VERSION=2025-11-01

# ---------- STEP 2: LLM that decides what is a material ----------
# Option A – Azure OpenAI
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Option B – Claude (comment option A out)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-claude-key
# LLM_MODEL=claude-sonnet-5-5
