                <Itemlist>
                  <Remark ID="R44">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt">Sicherheit Kunststoffmantelrohr</span><br/><span style="text-align:left; font-style:italic; font-size:10pt"/><br/></Text>
