                    <Qty>3</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Spülen der Entnahmestelle Hydrant DN50</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Medium [PERSON_029], Rohr aus PE, DN50</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
