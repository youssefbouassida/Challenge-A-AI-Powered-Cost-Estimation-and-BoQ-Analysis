                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Sand, natürliche Gesteinskörnung TL Gestein, Körnung 0/2, liefern, für Einbettung von Rohrleitungen DIN EN 1610, Außendurchmesser bis 100 mm, profilgerecht einbauen und verdichten, in Graben, Schichtdicke über 15 bis 20 cm, Ausführung gemäß Einzelbeschreibung, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-484">
                            <ComplCaption><span>Einzelbeschreibungs-Nr </span></ComplCaption>
                            <ComplBody><span> </span><br/><span>Sandbett, in Graben profilgerecht in 2 Lagen einbauen, für alle Tiefen.</span><br/><span>Die Leitung ist ausreichend zu unterstopfen.</span><br/><span>Arbeiten mit Hand- u. Kleingeräten. </span><br/><span>Abrechnung nach Volumenaufmaß.</span><br/><span/><br/><span>Material: Brechsand 0/2 </span><br/><span>Auflager: 15 cm</span><br/><span>Überdeckung: mind. 20 cm </span><br/><span>Verwendung: Wasserleitung </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Sand Einbettung Rohr AD bis 100mm einbauen verdichten D 15-20cm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
