                      <SubDNo>1</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Fertigbogen nach nach EN 10253-2, 90 Grad, geschweißt DIN EN 10217, Schenkellänge 1 x 1m, [PERSON_129] A, Reihe 1, Bauart 3, Außendurchmesser Innenrohr 273 mm, Außendurchmesser Ummantelung 400 mm, ausschäumen der Muffen mit Ortschaum, einschl. Messleitung zur Meldung und Ortung von Feuchte in der Dämmung, nach dem Laufzeit-Messverfahren, mit Leitung aus Kupfer, 2 x 1,5 mm², 1 x blank, 1 x verzinnt,  einschl. wärmebeständigem Anschluss des Messelements, Anschlussdose und Verbindungsleitung sowie Messleitungsverbindungen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Fertigbogen DIN EN 448, 90 Grad, Schenkellänge 1,0 x 1,0m</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
