                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Vorhandene Kabel im Baustellenbereich vor Baubeginn mittels Kabelortungsgerät orten und vor Ort markieren.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Niederspannungskabel und Mittelspannungskabel</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bei den zuständigen Versorgern und Leitungseigentümern die Bestandsplanunterlagen vorab einholen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Geortete Kabel in übergebene Werkpläne bzw. Lageplan eintragen mit Bezugsmaße zu vorhandenen Gebäuden.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abrechnung nach Größe der Ortungsfläche (Länge der einfachen Bautrasse x Breite der Bautrasse).</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Kabelortung Nieder- und Mittelspannung, Markierung</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
