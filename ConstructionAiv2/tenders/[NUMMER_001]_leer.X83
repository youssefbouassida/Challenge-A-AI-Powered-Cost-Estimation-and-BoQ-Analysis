                  <Item ID="I81" RNoPart="3">
                    <UPBkdn>No</UPBkdn>
                    <Qty>85</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Bordstein aus Beton, Form TB 10/25, Farbton grau, gebraucht, seitlich lagernd, mit Fundament und einseitiger Rückenstütze aus Beton.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Sämtliche Stossfugen, abweichend von der Geraden, sind auf Gehrung zu schneiden.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettung: 20 cm  Normalbeton C25/30 (LP) XF2 DIN EN 206, DIN 1045-2</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Rückenkeil: senkrecht, Dicke 10 cm durchgehend, einseitig</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugen: 1 cm Mörtel MG III</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bewegungsfugen: Abstand maximal 8 m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Betonbord TB10/25 grau gebraucht seitl. lagernd Fundament </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Rückenstütze C20/25 D 20cm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I82" RNoPart="4">
                    <UPBkdn>No</UPBkdn>
                    <Qty>60</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Bordstein aus Beton, Form TB 10/25, Farbton grau, mit Fundament und einseitiger Rückenstütze aus Beton.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Sämtliche Stossfugen, abweichend von der Geraden, sind auf Gehrung zu schneiden.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stein: Tiefbord T10 x 25</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbe: grau</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Oberfläche: unbearbeitet</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Vorsatz: hochfeste Quarzkörnung</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbpigmente: UV-beständig</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Material: Beton DIN EN 1340</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Qualitätsklasse: D T I</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Kanten: mit Fase</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettung:  20 cm Normalbeton C25/30 (LP) XF2 DIN EN 206, DIN 1045-2</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Rückenkeil: senkrecht, Dicke 10 cm durchgehend, einseitig</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugen: 1 cm Mörtel MG III</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bewegungsfugen: Abstand maximal 8 m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Betonbord TB10/25 grau Fundament Rückenstütze C20/25 D 20cm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I83" RNoPart="5">
                    <UPBkdn>No</UPBkdn>
                    <Qty>6</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Straßenkappe einschl. Tragplatte Beton DIN 3580-1, höhenverstellbar, für Absperrschieber oder Entleerung/Entlüftung in Kältefernleitung, DIN 3582.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Beschriftung: Fernkälte</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Gehäuse und Deckel: Gusseisen GG</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bolzen und Steg: nichtrostender Stahl</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Oberflächenschutz: Bitumenemulsion, kaltgetaucht</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Größe: 2</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Belastungsklasse: E600 DIN EN 124 / DIN 1229</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Straßenkappe höhenverstellbar Fernkälteltg Absperrschieber oder Entleerung/Entlüftung</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="R16">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Deckenbau</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Deckenbau</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R17">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Alle Belagsmaterialien sind mit mindestens zwei Produkten verschiedener Hersteller vor der Bestellung durch den Auftragnehmer zu bemustern.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Mindestgröße der Belagsmuster bei Pflaster, Pflasterplatten, Rasengitter etc. 0,5 m2.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Füllmaterial wie Splittist ebenfalls mit einer Eimerprobe ca. 2 L zu bemustern.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung - Bemusterung</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I84" RNoPart="6">
                    <UPBkdn>No</UPBkdn>
                    <Qty>400</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">STLB-Bau 04/2020 080 TA</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke, barrierefrei DIN 18040-3, aus Pflastersteinen aus Beton, ungebundene Bauweise, Tragschicht wird gesondert vergütet, Maße L/B 200/100 mm, Dicke 100 mm, gebrauchte Steine, seitlich lagernd, in Reihen mit versetzten [PERSON_016], Farbton grau, in Fahrbahnnebenflächen, Bettung aus Gesteinskörnung Körnung 2/5 aus natürlichen gebrochenen Gesteinskörnungen (Splitt), Dicke 4 +/-1 cm, Gesteinskörnung für [PERSON_016], Körnung 1/3 aus natürlichen gebrochenen Gesteinskörnungen (Splitt) einbringen, Ausführung gemäß Einzelbeschreibung:</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke gem. TL Pflaster StB. Einzupassende Steine sind mit einem geeigneten Schneidegerät in der gesamten Stärke zu durchschneiden. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Pflasterfläche ist nach dem Verlegen und Abrütteln solange durch Einschlämmen zu verfugen, bis die [PERSON_016] dicht geschlossen bleiben. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abrechnung nach Flächenaufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stein: Verbundpflasterstein</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-weight:bold; font-family:Arial">Beispiel Betonpflaster siehe Anlage 4</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steingrösse: ca. 20 x 10 x 10 cm (LxBrxD) inkl. Rand- und Endsteinen </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Kanten: mit Fase</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abstandhalter: vorhanden</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettungsmaterial: Basalt- oder Diabas-Splitte 2/5 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenbreite: mind. 5 mm, max. 7 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenfüllung: 2-lagig </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">untere Fugenfüllung: Edelsplitt 1/3 mm bis 3 cm unter OK Pflasterstein nach Abrütteln</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">obere Fugenfüllung: Granit-Brechsand 0/3, eingeschlämmt bis OK Pflasterstein</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbton: grau</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_083] gebraucht seitl.lagernd L/B 200/100mm D 100mm </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I85" RNoPart="7">
                    <UPBkdn>No</UPBkdn>
                    <Qty>15</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke, barrierefrei DIN 18040-3, aus Pflastersteinen aus Beton, TL Pflaster-StB, ungebundene Bauweise, Tragschicht wird gesondert vergütet, Maße L/B 200/100 mm, Dicke 100 mm, in Reihen mit versetzten [PERSON_016], Farbton grau, in Fahrbahnnebenflächen, Bettung aus Gesteinskörnung Körnung 2/5 aus natürlichen gebrochenen Gesteinskörnungen (Splitt), Dicke 4 +/-1 cm, Gesteinskörnung für [PERSON_016], Körnung 1/3 aus natürlichen gebrochenen Gesteinskörnungen (Splitt) einbringen, Fugenbreite 5 bis 8 mm, Ausführung gemäß Einzelbeschreibung:</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke aus [PERSON_083] gem. TL Pflaster StB herstellen. Einzupassende Steine sind mit einem geeigneten Schneidegerät in der gesamten Stärke zu durchschneiden. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Pflasterfläche ist nach dem Verlegen und Abrütteln solange durch Einschlämmen zu verfugen, bis die [PERSON_016] dicht geschlossen bleiben. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abrechnung nach Flächenaufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stein: Verbundpflasterstein wie Bestandspflaster </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-weight:bold; font-family:Arial">Beispiel Betonpflaster siehe Anlage 4</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbe: grau </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Oberfläche: unbearbeitet </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Vorsatz: hochfeste Quarzkörnung </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbpigmente: UV-beständig </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Material: Beton DIN EN 1338 </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Qualitätsklasse: D I bzw. K D I </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steingrösse: ca. 20 x 10 x 10 cm (LxBrxD) inkl. Rand- und Endsteinen </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Kanten: mit Fase </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abstandhalter: vorhanden </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettungsdicke: 3-4 cm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettungsmaterial: Basalt- oder Diabas-Splitte 2/5 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenbreite: mind. 5 mm, max. 7 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenfüllung: 2-lagig </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">untere Fugenfüllung: Edelsplitt 1/3 mm bis 3 cm unter OK Pflasterstein nach Abrütteln </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">obere Fugenfüllung: Granit-Brechsand 0/3, eingeschlämmt bis OK Pflasterstein </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbton: grau</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
