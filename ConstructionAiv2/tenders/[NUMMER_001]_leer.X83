    <AddText>
      <OutlineAddText><span>Ergänzung der Angebotsanforderung</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Ergänzung der Angebotsanforderung</span><br/><br/><span style="font-size:10pt;font-family:Arial;">In diesem Leistungsverzeichnis verwendete Einheiten</span><br/><span style="font-size:10pt;font-family:Arial;">cm</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Zentimeter</span><br/><span style="font-size:10pt;font-family:Arial;">cm2   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Quadratzentimeter</span><br/><span style="font-size:10pt;font-family:Arial;">d     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Tag</span><br/><span style="font-size:10pt;font-family:Arial;">h     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stunde</span><br/><span style="font-size:10pt;font-family:Arial;">Jr    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Jahr</span><br/><span style="font-size:10pt;font-family:Arial;">kg   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;"> Kilogramm</span><br/><span style="font-size:10pt;font-family:Arial;">km    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Kilometer</span><br/><span style="font-size:10pt;font-family:Arial;">km2   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Quadratkilometer</span><br/><span style="font-size:10pt;font-family:Arial;">kwh   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Kilowattstunde</span><br/><span style="font-size:10pt;font-family:Arial;">l     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Liter</span><br/><span style="font-size:10pt;font-family:Arial;">m     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Meter</span><br/><span style="font-size:10pt;font-family:Arial;">m2    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Quadratmeter</span><br/><span style="font-size:10pt;font-family:Arial;">m3    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Kubikmeter</span><br/><span style="font-size:10pt;font-family:Arial;">Mt    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Monat</span><br/><span style="font-size:10pt;font-family:Arial;">psch  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Pauschal</span><br/><span style="font-size:10pt;font-family:Arial;">St    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück</span><br/><span style="font-size:10pt;font-family:Arial;">t     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Tonne</span><br/><span style="font-size:10pt;font-family:Arial;">Wo    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Wochen</span><br/><span style="font-size:10pt;font-family:Arial;">md    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x Tag</span><br/><span style="font-size:10pt;font-family:Arial;">mMt   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x Monat</span><br/><span style="font-size:10pt;font-family:Arial;">mWo   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x Woche</span><br/><span style="font-size:10pt;font-family:Arial;">m2d   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x Tag</span><br/><span style="font-size:10pt;font-family:Arial;">m2Mt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x Monat</span><br/><span style="font-size:10pt;font-family:Arial;">m2Wo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x Woche</span><br/><span style="font-size:10pt;font-family:Arial;">m3d   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 x Tag</span><br/><span style="font-size:10pt;font-family:Arial;">m3Mt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 x Monat</span><br/><span style="font-size:10pt;font-family:Arial;">m3Wo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 X Woche</span><br/><span style="font-size:10pt;font-family:Arial;">Sth   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück x Stunde</span><br/><span style="font-size:10pt;font-family:Arial;">Std   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück x Tag</span><br/><span style="font-size:10pt;font-family:Arial;">StMt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück x Monat</span><br/><span style="font-size:10pt;font-family:Arial;">StWo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück x Woche</span><br/><span style="font-size:10pt;font-family:Arial;">St/M  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück pro Monat</span><br/><span style="font-size:10pt;font-family:Arial;">St/J  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">Stück pro Jahr</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Ende der Ergänzung der Angebotsanforderung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Weitere Besondere Vertragsbedingungen -  Fortsetzung zu Formblatt 214 H</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Fortsetzung Weitere Besondere Vertragsbedingungen</span><br/><span style="font-size:10pt;font-family:Arial;">siehe  Formblatt 214.H - Besondere Vertragsbedingungen - </span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.1   Beginn der Leistung</span><br/><span style="font-size:10pt;font-family:Arial;">Beginn der Leistung im Sinne des Formblattes 214.H, Nr. 1 ist die Aufnahme der ausgeschriebenen Leistungen. Hierzu zählen auch Aufmaße, Planungen (z.B. Werkstatt- und Montagezeichnungen) und Ermittlungen bzw. Vorarbeiten. Diese sind auf Verlangen dem Auftraggeber vorzulegen.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.2    Nachtragsangebote (§ 2)          </span><br/><span style="font-size:10pt;font-family:Arial;">Alle Nachtragsangebote sind einschließlich der notwendigen begründenden Unterlagen (Kalkulationen, Aufmaße, etc.) 1-fach beim Auftraggeber rechtsgültig und zugleich 1-fach beim Ingenieurbüro zur inhaltlichen Prüfung einzureichen.</span><br/><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">10.3    Werbung der Firma / Bautafel (§ 4 Abs. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">Auf der Baustelle ist Firmenwerbung grundsätzlich verboten. </span><br/><span style="font-size:10pt;font-family:Arial;">Dies betrifft auch Gerüste, Container und Schutzvorrichtungen. Ausnahmen bedürfen der schriftlichen Genehmigung des AG.</span><br/><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">Auf der bauseitigen  Bautafel  kann der Auftragnehmer auf eigene Kosten Zusatzschilder in der vorgesehenen Form anbringen lassen.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.4    Besichtigung von Baustellen (§ 4 Abs. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">Die Besichtigung von Baustellen durch Dritte bedarf der vorherigen Zustimmung des Auftraggebers.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.5    Übernachtungsverbot (§ 4 Abs. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">Auf der gesamten Baustelle besteht striktes Übernachtungsverbot</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6    Ergänzung zu § 4 Nr. 4 VOB/B:</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.1  Anschlußmöglichkeiten für Bauwasser und Baustrom</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Bauwasser kann aus dem einem Hydranten östlich der Immerwahrstraße neben dem Fußweg in unmittelbarer Nähe zur  an der Baustelle entnommen werden, Entferrnung ca. 100 m;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">2 Festkupplung B Din 14318.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Nach der Entnahme ist der Anschluss wieder ordnungsgemäß abzusperren. Ein geeigneter Schlauch ist vom Auftragnehmer mitzubringen. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat die Entnahme bei der technischen Abteilung der FAU zu beantragen. Zähler, oder soweit erforderlich Standrohr, sind vom Auftragnehmer zu stellen. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Die Baustromversorgung erfolgt bauseits aus dem Gebäude 114 (Gebäude Werkstoffwissenschaften) östlich der Immerwahrstraße, in unmittelbarer Nähe zur Baustelle, Entfernung ca. 100 m.Anschlußwert 400 V, Absicherung max 63 Amp.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Die Leistungen für die Überquerung der Immerwahrstraße </span><span style="font-size:10pt;font-family:Arial;">siehe dazu "Baustelleneinrichtung".</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">10.6.2  Die Kosten des Verbrauchs für Strom und [PERSON_029] übernimmt der AG. Ausgenommen sind die Kosten für Eigenbedarf des AN (Containerversorgung etc.). Diese sind vom AN zu tragen. Entsprechende Zwischenzähler sind vom AN zu setzen. Die Zählerstände (Beginn und Ende der Nutzungsdauer) sind gemeinsam mit der Bauleitung des AG zu dokumentieren.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.3  Notwendige Lager- und Arbeitsplätze werden von der Bauleitung zugewiesen.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.4 Sanitäranlagen stehen auf der Baustelle keine bereit.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Sanitäranlagen sind vom AN zuliefern, siehe dazu "Baustelleneinrichtung".</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Die Sanitäreinrichtungen werden auch durch eine Dritte benutzt</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.5 Lager- und Aufenthaltscontainer stehen bauseits nicht zur Verfügung. Diese sind bei Bedarf des Auftragnehmers von diesem auf seine Kosten zu liefern..</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.7    Nachunternehmereinsatz (§ 4 Abs. 8)</span><br/><span style="font-size:10pt;font-family:Arial;">Für die Leistungen, auf die der Betrieb des AN eingerichtet ist, besteht zunächst nach § 4 Abs. 8 VOB/B die Selbstausführungspflicht. Ausgenommen hiervon sind diejenige Nachunternehmer, die bereits vor Auftragsvergabe namentlich für konkrete Teilleistungen benannt wurden.</span><br/><span style="font-size:10pt;font-family:Arial;">Jeglicher Nachunternehmerwechsel ist vor Aufnahme der Tätigkeiten auf der Baustelle durch den Auftraggeber genehmigen zu lassen. Dabei gilt jede Abweichung zu den zur Vergabe genannten Nachunternehmern als Wechsel.</span><br/><span style="font-size:10pt;font-family:Arial;">Für die Genehmigung sind die kompletten Eignungsnachweise nach Formblatt 124, sowie die Eigenerklärung oder ein Nachweis der Eintragung in die Liste des Vereins für die Präqualifikation von [FIRMA_008] (Präqualifikationsverzeichnis) für jeden einzelnen Nachunternehmer so rechtzeitig vorzulegen, dass eine ordnungsgemäße Prüfung der Unterlagen durch den Auftraggeber während der üblichen Geschäftszeiten möglich ist.</span><br/><span style="font-size:10pt;font-family:Arial;">Einem Wechsel des Nachunternehmers wird grundsätzlich nur zugestimmt, wenn ein triftiger Grund für einen Wechsel des Nachunternehmers vorliegt. Ein solcher wird unterstellt, wenn eine Kündigung des bisherigen Nachunternehmers durch den Hauptunternehmer nach § 8 VOB/B gerechtfertigt ist.</span><br/><span style="font-size:10pt;font-family:Arial;">Die Verträge mit Nachunternehmern sind nach VOB/B zu schließen. Verstöße gegen diese Vertragsklausel berechtigen den Auftraggeber zur Kündigung aus wichtigem Grund und führen ggf. zum Verlust der Präqualifikation. </span><br/><span style="font-size:10pt;font-family:Arial;">Der Vergabe von Leistungen aus dem Vertrag an Nach-Nachunternehmer wird grundsätzlich nicht zugestimmt.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.8   Rechnungen (§ 14)</span><br/><span style="font-size:10pt;font-family:Arial;">Alle Rechnungen sind 1-fach beim Auftraggeber rechtsgültig und zugleich 1-fach einschließlich der notwendigen begründenden Unterlagen (Aufmaße, Abrechnungszeichnung, etc.) beim Ingenieurbüro zur inhaltlichen Prüfung einzureichen. Rechnungen sind ihrem Zweck nach als Abschlags-, oder Schlussrechnungen zu bezeichnen.</span><br/><span style="font-size:10pt;font-family:Arial;">Die Rechnungen sind kumulierend und fortlaufend aufzustellen. </span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.9   Anordnung von Stundenlohnarbeiten (§ 15)</span><br/><span style="font-size:10pt;font-family:Arial;">Die Stundenlohnzettel sind wöchentlich einzureichen.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.10   Bauleiter</span><br/><span style="font-size:10pt;font-family:Arial;">Auf der Baustelle muss ständig eine fachlich qualifizierte deutsch sprechende Aufsichtsperson des Auftragnehmers anwesend sein.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.11   Baustellenbesprechungen</span><br/><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat zu den Baustellenbesprechungen, die der Auftraggeber regelmäßig durchführt, einen bevollmächtigten deutsch sprechenden Vertreter zu entsenden. </span><br/><span style="font-size:10pt;font-family:Arial;">Die Besprechungen finden jeweils nach Abstimmung bei Baubeginn statt.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.12  Sicherheits- und Gesundheitsschutzplan</span><br/><span style="font-size:10pt;font-family:Arial;">Zur Durchführung der Maßnahme wird durch den AG und den SIGE-Koordinator ein Sicherheits- und Gesundheitsschutzplan erstellt.</span><br/><span style="font-size:10pt;font-family:Arial;">Der AN hat seine Beschäftigten über den SIGE-Plan zu informieren.</span><br/><span style="font-size:10pt;font-family:Arial;">Der SIGE-Plan ist zu beachten und in der Firmenbauleitung bereitzuhalten.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.13  Übergabe von Ausführungszeichnungen</span><br/><span style="font-size:10pt;font-family:Arial;">Die Ausführungszeichnungen werden in [PERSON_097]  und in digitaler Form (PDF) übergeben.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.14  Herstellen von Zeichnungen und Unterlagen</span><br/><span style="font-size:10pt;font-family:Arial;">- Vorgaben des Auftraggebers -</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Der Auftraggeber stellt als Grundlage für die vom Auftragnehmer zu erstellenden Planunterlagen folgende Unterlagen in digitaler Form zur Verfügung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><br/><span style="font-size:10pt;font-family:Arial;">- P5_15145_F_07.043_LP-LTG_VAM-OST_[PERSON_133] Bestand + Planung</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.15   Herstellen von Zeichnungen und Unterlagen</span><br/><span style="font-size:10pt;font-family:Arial;">- Formerfordernisse -</span><br/><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat die Zeichnungen und Unterlagen normgerecht herzustellen. Die Zeichnungen sind in einem DIN A - Format zu fertigen. Das größte zulässige Format ist DIN A 0.</span><br/><span style="font-size:10pt;font-family:Arial;">Der Planstempel des Auftraggebers ist nach dessen Anweisung anzuwenden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">- Vermessungsleistungen, Aufmaßverfahren - </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Für alle Leistungen des AN sind Abrechnungspläne und Abrechnungsskizzen auf der Basis der übergebenen Werkpläne zu erstellen und 2-fach zu übergeben. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Die Vermessungsleistungen sind im UTM-Koordinatensystem anzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Für die einzelnen Positionen sind jeweils getrennte Aufmassblätter anzulegen. Die verlegten Rohrleitungen und [PERSON_017] sind digital aufzumessen bezüglich Lage und Tiefe und digital im DWG-Format und PDF-Fortmat  mit Punktliste an die Bauüberwachung zu übergeben. Die Übergabe der digitalen [PERSON_118] muß vor Endabnahme erfolgen</span><span style="font-size:10pt;color:#FF0000;font-family:Arial;">.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.16   Baufristenplan</span><br/><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat auf Basis des vom AG vorgelegten Bauablaufplanes einen Baufristenplan für seine vertraglichen Leistungen zu erstellen, anhand dessen die Einhaltung der Vertragsfristen nachgewiesen und überwacht werden kann.</span><br/><span style="font-size:10pt;font-family:Arial;">Die Festlegungen des Auftraggebers, z.B. zur baufachlichen oder terminlichen Koordinierung mit den übrigen Leistungsbereichen, sind zu berücksichtigen. Bei Änderungen der Vertragsfristen oder bei erheblichen Abweichungen von sonstigen Festlegungen ist der Plan durch den Auftragnehmer unverzüglich fortzuschreiben. Der Plan ist dem Auftraggeber 12 Werktage nach Auftragserteilung, bei Überarbeitungen unverzüglich jeweils in 2 Fertigungen zu übergeben.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.17   Abnahme</span><br/><span style="font-size:10pt;font-family:Arial;">Eine förmliche Abnahme der Leistung wird verlangt.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Ende der Weiteren Besonderen Vertragsbedingungen</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>ZTV-Angaben und Sonstige Regelungen</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:12pt;font-weight:bold;font-family:Arial;">Zusätzliche Technische Vertragsbedingungen (ZTV)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">Zusätzliche Technische Vertragsbedingungen (ZTV)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">Zusätzliche Technische Vertragsbedingungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">im Sinne von § 1 Abs. 2 Nr 4 VOB/B  sind</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- für [ORT_030]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- für Straßen- und Wegebaubauarbeiten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- für Landschaftsbauarbeiten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">im Formblatt 9002.StB_ZTV des VHB Bayern geregelt. Die dort genannten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">ZTV werden Vertragsbestandteil</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:10pt;font-family:Arial;">Ende der Zusätzlichen Technischen Vertragsbedingungen (ZTV)</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Allgemeine Baubeschreibung - Tiefbauarbeiten</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:12pt;color:#000000;font-weight:bold;font-family:Arial;">Baubeschreibung - Tiefbauarbeiten</span></p><p style="text-indent:-126pt;margin-left:126pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-141pt;margin-left:141pt;margin-top:0pt;margin-bottom:0pt;width:482pt;line-height:100%;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.    ALLGEMEINE BESCHREIBUNG DER LEISTUNG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.1   Bauvorhaben</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">D-[ORT_001] / Immerwahrstraßestraße  </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Neubau Neue Technische Chemie</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Vorbereitende Arbeiten:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ergänzung [PERSON_132] - Haupttrasse</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ergänzung Brunnenwasserleitung</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ergänzung [PERSON_132] - Anschluss an Rohbau</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-21pt;margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.    ANGABEN ZUR BAUSTELLE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-21pt;margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.1  Lage der Baustelle</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">91058 [ORT_022], FAU-Gelände Süd</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Baustelle befindet sich in am südöstlichen Stadtrand von [ORT_022] auf dem Gelände der Friedrich-Alexander-Universität [ORT_022]-[ADRESSE_001] (FAU) östlich und westlich der Immerwahrstraße, entlang der Feuerwehrumfahrt an der Nordseite des IZNF-Gebäudes und der Zentralwerkstatt</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Innerhalb des Baufeldes bestehen beengte Verhältnisse; vorhandener Baumbestand seitlich der Feuerwehrumfahrt und den Freiflächen der Institutsgebäude.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">[PERSON_133] siehe Anlage 1</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Lageplan der Baumaßnahme siehe Anlage 2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.2  Vorhandene öffentliche Verkehrswege </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Zufahrt zur Baustelle erfolgt über Cauerstraße und Immerwahrstraße von Westen.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.3 Parallel stattfindende Baumaßnahmen </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Parallel zur Verlegung der [PERSON_132] und der Brunnenwasserleitung finden auf der zukünftigen Baufläche NTC, westlich der Immerwahrstraße, Tiefbauarbeiten zur Freimachung des Baugeländes statt. Diese Arbeiten finden vorwiegend im nördlichen und westlichen Bereich des Baufeldes NTC statt.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Eine temporäre Nutzung des südlichen Baufeldes NTC für die Zwischenlagerung von Erdmaterial und Rohrmaterial ist nach Abstimmung mit der Bauüberwachung und der auf dem Baufeld tätigen Baufirma möglich.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.4  Erddeponien</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Es bestehen zwei temporäre Zwischenlager für Bodenmaterial auf die jedoch nur Rohboden und Oberboden ohne jegliche Betonteile oder sonst. Abbruchstoffe zwischengelagert werden darf.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Bodenlager 1:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Überschüssiger Rohboden der im Zuge der [ORT_030] wieder </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">unmittelbar</span><span style="font-size:10pt;font-family:Arial;"> gebraucht wird, kann westlich der Immerwahrstraße, gegenüber der Einmündung Feuerwehrumfahrt, in einer Entfernung ca.100 - 200 m in geordneten Haufwerken / Mieten, in Abstimmung mit der Bauüberwachung, zwischengelagert werden.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Lagerfläche westlich der Immerwahrstraße wird während der Bauzeit parallel auch von einer Drittfirma benutzt. Hier finden Grabarbeiten und temporäre Ablagerung von Bodenmaterial statt, daher sind alle Tätigkeiten auf dieser Fläche mit der Bauüberwachung vorher abzustimmen.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Bodenlager 2:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ein weiteres, temporäres Zwischenlager für Bodenmaterial das später, nach Beprobung  entsorgt werden muß, befindet sich in einem Waldstück der FAU in einer Entfernung von ca. 850 m; Zufahrt zum Zwischenlager über Kurt-Schuhmacher-Straße, gegenüber Weißenseelinie (Forst Tennenlohe).</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der Weg in das Zwischenlager selbst ist nicht befestigt </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Zufahrt zum Bodenlager 2 siehe Anlage Nr. 3</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.5  Seitenentnahmen und Ablagerungsstelle</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Für die Auffüllarbeiten in der Verfüllzone soll möglichst Material aus dem Rohrgrabenaushub verwendet werden. Sollte díeser Bodenaushub nicht geeignet sein dann ist verdichtungsfähiger Rohboden zu verwenden, der aus einer Seitenentnahme im Baufeld oder aus dem temporären Zwischenlager auf dem Gelände der FAU stammt,</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.6  Schutzbereiche und Schutzobjekte</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der vorhandene Baumbestand außerhalb des Baufeldes muss erhalten und entsprechend geschützt werden. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.7  Anlagen im Baubereich</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Vorhand. Versorgungs- u. Entsorgungseinrichtungen</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die in den Plänen eingetragene Lage von bestehenden Leitungen, Kabeln, Dränagen, Kanälen u. dgl. dienen nur zur Information über das Vorhandensein von Leitungen u. dgl. Der Auftragnehmer hat sich unabhängig von den nachfolgend aufgeführten Hinweisen vor Beginn der Bauarbeiten und falls erforderlich auch während der laufenden Arbeiten genau über Lage und Tiefe eventuell vorhandener Leitungen u. dgl. beim Anlagenbetreiber bzw. bei den für die Ver- und Entsorgungsanlagen zuständigen Trägern eigenständig und umfassend zu unterrichten und gegebenefalls in die Leitungstrassen einweisen zu lassen.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Elektroleitungen:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im direkten Baubereich sind  Elektroleitungen bekannt.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Telekomleitungen, Fernmeldekabel:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im direkten Baubereich sind Fernmeldeleitungen bekannt.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Kälteleitungen:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">I</span><span style="font-size:10pt;font-family:Arial;">m direkten Baubereich sind Kälteleitungen vorhanden. </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Wasserleitungen:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im direkten Baubereich sind Wasserleitungen bekannt.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Brunnenwasserleitung verläuft ebenfalls im Baubereich. Informationen zu dieser Leitung sind bei der technischen Abteilung der FAU erhältlich.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Kanalleitungen:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im Baufeld sind keine Schmutzwasserleitungen bekannt.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.8  Öffentlicher Verkehr im Baubereich</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im Umfeld des Baufeld findet öffentlicher Verkehr statt - Fußgänger und Radfahrer - für die jedoch Umleitungen eingerichtet werden.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ende der Allgemeinen Baubeschreibung</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Technische Angaben - Tiefbauarbeiten</span></OutlineAddText>
      <DetailAddText><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:37px 188px 302px 453px 604px 756px 831px 907px 982px 1058px 1134px 1209px 1285px 1360px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">. </span><span style="font-size:10pt;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">ANGABEN ZUR AUSFUEHRUNG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.1 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Verkehrsführung, Verkehrssicherung</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Zufahrtsmöglichkeiten zur Baustelle für die Feuerwehr muß freigehalten werden. </span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der AN muß seine Baustelle so einrichten, dass am Wochenende und nachts wenn die Baustelle nicht besetzt ist wechselweise Zufahrten für die Feuerwehr möglich sind.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat für die Verkehrssicherheit auf der Baustelle zu sorgen; dies gilt auch für die unmittelbar angrenzenden Flächen, soweit er in diesen Flächen durch den Baustellenbetrieb eine Gefahrenstelle geschaffen hat oder durch seinen Baubetrieb möglicherweise verursachen könnte.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat täglich eigenständig für eine Säuberung der durch seinen Baubetrieb verschmutzten Gehwege und Fahrbahnen zu sorgen.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Baustelle selbst ist ebenfalls geordnet zu betreiben, insbesondere zum Feierabend sowie zu den Wochenenden ist die Baustelle geordnet und gesäubert von Abfällen etc. zu verlassen und gegen unbefugtes Betreten zu sichern.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Verkehrsrechtliche Anordnung</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Obwohl es sich bei dem Bauglände insgesamt um ein Privatgelände der FAU handelt, ist eine verkehrsrechtliche Anordnung erforderlich. Der Auftragnehmer hat diese bei der Stadt [ORT_022] zu beantragen und die verkehrsrechtl. Anordnung während der Bauzeit ständig auf der Baustelle vorzuhalten.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Für die Baumaßnahme sind auch innerhalb der halböffentlichen Bereiche verkehrsrechtlich wirksame Absperrungen und Sicherungen vorzusehen. </span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Notwendige Absperrungen und Beschilderungen sowie deren baubedingte Veränderungen während der Bauzeit sind im Leistungsverzeichnis beschrieben.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.2 </span><span style="font-size:10pt;font-weight:bold;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Bauablauf</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In einem ersten Abschnitt ist die neue [PERSON_132], zusammen mit der Brunnenwasserleitung herzustellen.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In einem zweiten, zeitlich versetzten Abschnitt ist dann die [PERSON_132] zwischen dem bereits verlegten Teilstück unter der Immerwahrstraße und dem Keller des Rohbaus NTC herzustellen. Diese Leistung kann erst erfolgen, wenn der Keller des Neubaus fertiggestellt ist. Zwischen dem Ende der Bauarbeiten für Haupttrasse [PERSON_132] und dem Beginn der  Anschlussarbeiten an den Rohbau liegen ca. 9 Monate - Ausführung August 2024.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.3 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Wasserhaltung</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Nach dem Bodengutachten tritt das Grundwasser unterhalb der Baugrundsohle auf. Um eventuell auftretendes [PERSON_149] abzufangen enthält das Lesitungsverzeichnis Leistungen für eine Wasserhaltung. Das eventuell abzupumpende [PERSON_029] kann auf der Ostseite der Immerwahrstraße in ein Versickerungsbecken nördlich des IZNF-Gebäudes gepumpt werden. Unter diesem Versickerungsbecken gibt es eine Rigole zur Versickerung von Niederschlagswasser.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.4 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Beweissicherung</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Vor Baubeginn wird mit dem Auftragnehmer und der Bauüberwachung des Auftraggebers eine gemeinsame Begehung durchgeführt zur Dokumentation des Baustellenzustands. Die Begehung wird mittels Fotodokumentation und Protokoll gemeinsam dokumentiert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.5 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Sicherungsmaßnahmen / Baustellensicherung</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Das Baufeld, ist mit einem Bauzaun abzusperren.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Aufgrund des längere Zeit offenen Rohrgrabens ist dieser so abzusperren, dass Fußgänger in jedem Fall geschützt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;background-color:#000000;font-weight:bold;font-family:Arial;"/></p><page/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.6 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Bautagesberichte</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Der Auftragnehmer hat Bautagesberichte zu führen und dem Auftraggeber täglich zu übergeben. Die Bautages- berichte müssen alle Angaben enthalten, die für die Ausführung und Abrechnung des Auftrages von Bedeutung sein können.</span></p><p style="margin-left:26pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.7 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Prüfungen</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Für die angegebenen Verdichtungsleistungen und für alle Verfüllarbeiten ist die Einhaltung der geforderten Verdichtungswerte vom AN unmittelbar nach Erstellung schriftlich zu dokumentieren und nachzuweisen.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Ende der Technischen Angaben</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Allgemeine Beschreibung der technischen Anlagen [PERSON_127]</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">T</span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">echnische Anlagen [PERSON_127] in Außenanlagen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><br/><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Ringschluss Brunnenwasserleitung</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Die Brunnenwasserleitung wird  im gesamten Bereich der Kältetrasse neu verlegt und damit der Ringschluss hergestellt. Eine neue Zapfstelle (Unterflurhydrant DN50) wird in Wegnähe vor dem Gebäude 114.01 Werkstoffwissenschaften gebaut. </span><br/><br/><span style="font-size:10pt;font-family:Arial;">Der Anschluss an die Hauptversorgungsleitung DN160 in der Immerwahrstraße erfolgt durch Anbohren unter dem Betriebsdruck.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Die für den Anschluss erforderliche Betriebsunterbrechung ist mindestens 1 Woche zuvor der</span><br/><span style="font-size:10pt;font-family:Arial;">Betriebstechnik und dem [FIRMA_001] anzukündigen.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Die Arbeiten zum Rohranschluss führen zu einer Betriebsunterbrechung. Die bestehende Leitung muss</span><br/><span style="font-size:10pt;font-family:Arial;">abgesperrt und entleert werden. Der Absperrschieber befindet sich nicht unmittelbar im Anschlussbereich,</span><br/><span style="font-size:10pt;font-family:Arial;">sondern am Rohrabzweig an der Cauerstraße. Der Anschluss an die Versorgungsleitung PE 2", an der östlichen Seite des Ringschlusses, erfolgt durch den Einbau eines T-Stücks in die Hauptversorgungsleitung.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Kältetechnische Anlagen, Anschluss Kälteverbund</span><br/><span style="font-size:10pt;font-family:Arial;">Für die Kälteversorgung des NTC werden die Anschlussleitungen im Außenbereich vorbereitet.</span><br/><span style="font-size:10pt;font-family:Arial;">Der Anschluss erfolgt an den Kälteverbund in der Dimension DN 250.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">Der Anschluss an das Liegenschaftsnetz erfolgt an einen vorhandenen Abgang zwischen den [ADRESSE_011] (118.01 Zentralwerkstatt) und 6 (115.01 Elektrotechnik). Die Verlegung erfolgt zwischen den [ADRESSE_011] (118.01 Zentralwerkstatt)  und [ADRESSE_015] (114.01 Werkstoffwissenschaft) bis zur Immerwahrstraße. Im Bereich der Immerwahrstraße wird der Anschluss des Gebäudes "Neubau Technische Chemie" vorbereitet und eine Vorhaltung für den Weiterbau vorgesehen. Die Rohre werden im Außenbereich erdverlegt. </span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Ende der Baubeschreibung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"/></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Technische Angaben - [PERSON_127]</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Technische Angaben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Befestigung von Rohrleitungen/Konsolen etc.</span><br/><span style="font-size:10pt;font-family:Arial;">Die Befestigung von Rohrleitungen, Kabeltrassen, Konsolen etc. beinhaltet auch das Bohren von Löchern und sämtliche erforderlichen zugelassenen Befestigungsmittel. </span><br/><span style="font-size:10pt;font-family:Arial;">Diese Leistungen sind in die jeweiligen Positionen mit einzukalkulieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Abfallmaterial</span><br/><span style="font-size:10pt;font-family:Arial;">Aus dem Bereich des AN (Baustellenabfälle, z.B. Verpackungsmaterial, Reststoffe usw.) ist entsprechend den rechtlichen Vorschriften (z.B. örtliche Abfallsatzung), zu entsorgen. Wertstoffe sind auszusondern, in getrennten Fraktionen zu erfassen und der Wiederverwertung zuzuführen. (Nebenleistung nach Nr. 4.1.11  DIN 18 299).</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Vor der Abnahme hat der AN nachstehende allgemeine Leistungen zu erfüllen:</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Dokumentation</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Ohne besondere Vergütung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Inbetriebnahme und Probebetrieb der Anlage</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Einweisung des Bedienungspersonals</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Übergabe folgender Unterlagen an den AG (3-fach):</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Listen über vorzuhaltende Ersatzteile und spezielle Hilfsmittel sowie deren Bezugsquellen.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><br/><span style="font-size:10pt;font-family:Arial;">Gegen Vergütung, gemäß gesonderter LV-Positionen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Mängelfreie Abnahme-, Prüf- und Genehmigungsunterlagen einschließlich der Protokolle über durchgeführten Messungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Bedienungs-, Betriebs- und Wartungsanweisungen einschl. Hinweis zum Eingriff im Störungsfall</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Anlage- und Funktionsbeschreibung der gesamten Anlage als auch Einzelaggregate bzw. komplexer Bauteile mit Übersichtsplänen, techn.Datenblättern und Schemen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Bestandspläne über Führung von Kabeln, Leitungen, Kanälen und Trassen sowie über Einbau-, bzw.  Aufstellungsorte der Anlagen und ihrer Bauteile mit Angaben der Leistungsdaten und Positionsnummern wesentlicher Anlagenteile, erforderliche Einzelpläne wie Fließ-, Schaltschema-, Stromlauf-, Klemmübersichtspläne und dergleichen (DIN-gerecht) Papier DIN A4, im Ordner dreifache Ausfertigung.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_118] wie vor beschrieben, jedoch als cad - file im Format *.dwg und *.pdf.</span><br/><span style="font-size:10pt;font-family:Arial;">Die Struktur der Ausführungspläne muss beibehalten werden, insbesondere die Layerstruktur, externe Referenzen, Zeichnungseinheit, Einfügepunkt und die Dateinamenskonvention</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><br/><span style="font-size:10pt;font-family:Arial;">Ende der Technischen Angaben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"/></DetailAddText>
    </AddText>
    <BoQ ID="B273960">
      <BoQInfo>
        <Name>[NUMMER_001]</Name>
        <LblBoQ>RINGSCHLUSS BRUNNENWASSER, [PERSON_132]</LblBoQ>
        <Date>2023-03-10</Date>
        <OutlCompl>AllTxt</OutlCompl>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <LblBoQBkdn>Abschnitt</LblBoQBkdn>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <LblBoQBkdn>Titel</LblBoQBkdn>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Item</Type>
          <LblBoQBkdn>Position</LblBoQBkdn>
          <Length>4</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Index</Type>
          <LblBoQBkdn>Pos-Index</LblBoQBkdn>
          <Length>1</Length>
          <Num>No</Num>
        </BoQBkdn>
        <Ctlg>
          <CtlgID>CX0</CtlgID>
          <CtlgType>cost unit</CtlgType>
          <CtlgName>noname</CtlgName>
        </Ctlg>
        <Ctlg>
          <CtlgID>CX1</CtlgID>
          <CtlgType>locality</CtlgType>
          <CtlgName>noname</CtlgName>
        </Ctlg>
        <Ctlg>
          <CtlgID>CX2</CtlgID>
          <CtlgType>miscellaneous</CtlgType>
          <CtlgName>noname</CtlgName>
        </Ctlg>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="C0" RNoPart="1">
          <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">Baustelleneinrichtung Tiefbau + [PERSON_127] allgemein</span><br/></LblTx>
          <BoQBody>
            <BoQCtgy ID="C1" RNoPart="1">
              <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">Baustelleneinrichtung</span><br/></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R0">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Auftragnehmer hat auf dem vom AG zur Verfügung gestellten Grundstück oder einerTeilfläche seine Baustelleneinrichtung aufzubauen, zu unterhalten und nach Beendigung der Baumaßnahme wieder zu räumen.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Material-, Werkstatt- und/oder Mannschaftscontainer entsprechend Erfordernis des Bieters einschl. Krangestellung, Beistellung von Elt-Kabeln zum Anschluss der BE an die Baustromverteilung.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Die Baustelle ist so einzurichten, dass bauliche Anlagen ordnungsgemäß errichtet oder geändert werden können und dass keine Gefahren, vermeidbare Nachteile oder vermeidbaren Belästigungen entstehen.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Für die Ver- und Entsorgung der Baustelle ist vom AN ein Sanitärcontainer zu liefern, aufzustellen, vorzuhalten und zu räumen; Abrechnung in eigenen Positionen.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Sanitärcontainer wird auch von einer auf der Baufläche tätigen Drittfirma mitbenutzt.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Baustelleneinrichtung Tiefbau- u. [PERSON_127]</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R1">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Bauwasser kann aus dem einem Hydranten östlich der Immerwahrstraße neben dem Fußweg in unmittelbarer Nähe zur  an der Baustelle entnommen werden: 2 Festkupplung B DIN 14318.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Nach der Entnahme ist der Anschluss wieder ordnungsgemäß abzusperren. Ein geeigneter Schlauch ist vom Auftragnehmer mitzubringen. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Auftragnehmer hat die Entnahme bei der technischen Abteilung der FAU zu beantragen. Zähler, oder soweit erforderlich Standrohr, sind vom Auftragnehmer zu stellen.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Die Baustromversorgung erfolgt bauseits aus dem Gebäude 114 (Gebäude Werkstoffwissenschaften) östlich der Immerwahrstraße, in unmittelbarer Nähe zur Baustelle, Entfernung ca. 100 m.Anschlußwert 400 V, Absicherung max. 63 Amp.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Leistungen zur Überquerung Immerwahrstraße siehe "Baustelleneinrichtung Tiefbau + [PERSON_127]"</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Anschlußmöglichkeiten für Bauwasser und Baustrom</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I0" RNoPart="1">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Sanitärcontainer, aufstellen und räumen, beheizbar, elektrisch, Energiekosten Heizung werden vom AG übernommen, doppelwandig, isoliert, Einzelcontainer-Länge 5 m, Einzelcontainer-Breite bis 2,1 m, Standplatz herrichten und räumen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Sanitärcontainer zur Mitbenutzung durch Drittfirma auf der Baustelle.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Herstellen und Räumen der Ver- und Entsorgungsanschlüsse des Containers innerhalb der Baustelleneinrichtung werden gesondert vergütet, Warten und Betreiben werden gesondert vergütet, für Wasch- und Toilettenraum, 2 Toiletten mit Handwaschbecken, für Damen und Herren getrennt, Wasserversorgung mit Kalt- und Warmwasser, zwei Urinale, für eine Entnahmestelle innen, Raum eingerichtet, einschl. Beleuchtung.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Sanitärcontainer aufstellen räumen doppelwandig, isoliert L 5m </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">B 2,1m Standplatz herrichten räumen, Benutzung mit Drittfirma</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I1" RNoPart="2">
                    <UPBkdn>No</UPBkdn>
                    <Qty>28</Qty>
                    <QU>Wo</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">STLB-Bau 04/2020 000</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Sanitärcontainer Ver- und Entsorgungseinrichtungen warten und betreiben einschl. Reinigen, 2 x wöchentlich und Heizung, Energiekosten Heizung werden vom AG übernommen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abrechnung nach Wochen Bauzeit</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Heizung Ver-/Entsorgungseinr. warten betreiben reinigen 2x </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">wöchentlich</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I2" RNoPart="3">
                    <UPBkdn>No</UPBkdn>
                    <Qty>30</Qty>
                    <QU>m</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2020-04</VersDate>
                          <WCtg>000</WCtg>
                          <Group>4433</Group>
                        </STLBBauCtlg>
                        <STLBBauID>
                          <ArtChrIdent>2136</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>2</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>8304</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>86</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5180</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>251</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2770</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>6160</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>9</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>4058</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>200</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>-484</ArtChrIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">[PERSON_078] zwischen dem Netz der öffentlichen Ver- und Entsorgungsträger und der Übergabestelle auf der Baustelle bzw. dem Baugrundstück, für die Entwässerung, DN 100, nach Anweisung der öffentlichen Ver- und Entsorgungsbetriebe verlegen und räumen, Ausführung gemäß Einzelbeschreibung, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-484">
                            <ComplCaption><span>Einzelbeschreibungs-Nr </span></ComplCaption>
                            <ComplBody><span> </span><br/><span>Schmutzwasseranschluss DN 150 liegt auf dem Baugrundstück westl. Immerwahrstraße / Sohlhöhe 290,88 ü. NN, Geländehöhe ca. 293,90 ü.NN. [ORT_030] für Herstellung des Rohranschlusses sind einzukalkulieren.  </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Anschlussltg Entwässerung DN100 verlegen räumen</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I3" RNoPart="4">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Anschluss Schmutzwasserleitung an vorhandenen SW-Stichleitung auf dem Baugrundstück herstellen und vorhalten, einschließlich [ORT_030]; Übergabestelle auf der Baustelle bzw. dem Baugrundstück, für die Entwässerung Sanitärcontainer.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Ausführung gemäß Einzelbeschreibung,:</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Schmutzwasseranschluss DN 150 liegt auf dem Baugrundstück westl. Immerwahrstraße / Sohlhöhe 290,88 ü. NN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Geländehöhe ca. 293,90 ü.NN. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">[ORT_030] für Herstellung des Rohranschlusses sowie Rohranschluss sind einzukalkulieren.  </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Anschluss für SW-Leitung DN100 an vorhand. SW-Leitung herstellen und vorhalten</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I4" RNoPart="5">
                    <UPBkdn>No</UPBkdn>
                    <Qty>840</Qty>
                    <QU>mWo</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2020-04</VersDate>
                          <WCtg>000</WCtg>
                          <Group>4433</Group>
                        </STLBBauCtlg>
                        <STLBBauID>
                          <ArtChrIdent>2136</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>18</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>8304</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>86</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5180</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>251</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2770</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
