                      <CompleteText>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Abbruch der Befestigung ohne [PERSON_147] aus Schotter-Splitt-Brechsand-Gemisch, in Fahrbahnnebenflächen, im Rahmen einer Teilabbruchmaßnahme, Wichte des Abbruchstoffes DIN EN 1991-1-1 20 kN/m3, Dicke über 20 bis 30 cm, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Geräteeinsatz ist möglich, max. Gesamtgewicht bis 20 t, Ausführung erschütterungsarm DIN 4150, lärmarm, Lärmpegel max. 80 dB(A), </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe sammeln, auf LKW des AN laden, transportieren, entsorgen, zum Lager/zur Anlage nach [PERSON_125] des AN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Bidder" MarkLbl="11" ArtChrIdent="-43">
                            <ComplCaption><span>Anlage (Bezeichnung/Ort) </span></ComplCaption>
                            <ComplBody><span/><br/><span/><br/><span>  .......................... </span></ComplBody>
                            <ComplTail><span>vom Bieter einzutragen</span></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">vom Bieter einzutragen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, Zuordnung Z 0 (uneingeschränkter Einbau), Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170504 Boden/Stein, Mengenermittlung nach Aufmaß, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Vergütung der Entsorgung übernimmt AN.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Befestigung ohne [PERSON_147] Schotter-Splitt-Brechsand-Gemisch Fahrbahnnebenfläche abbrechen 20kN/m3 D 20-30cm Geräteeinsatz mgl. laden transp. LKW AN entsorgen nicht schadstoffbelastet AVV170504 Vergüt.Entsorg. AN</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I45" RNoPart="7">
                    <UPBkdn>No</UPBkdn>
                    <Qty>150</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Pflanzliche Bodendecke einschl. oberster Bodenschicht abräumen, aufnehmen, fördern und auf LKW AN laden, Vergütung der Entsorgung übernimmt AN., </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Schichtdicke über 5 cm bis 10 cm, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bewuchs Gras-Kraut-Aufwuchs, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Wuchshöhe bis 15 cm, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Pflanzl.Bodendecke abräumen aufnehmen fördern auf LKW AN laden D 5-10cm Gras-Kraut-Aufwuchs Wuchs-H bis 15cm, Vergüt.Entsorg. AN</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
