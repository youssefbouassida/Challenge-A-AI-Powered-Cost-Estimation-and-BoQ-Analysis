            <BoQCtgy ID="C28" RNoPart="2">
              <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">Sonstige Leistungen Wasseranlagen</span><br/></LblTx>
              <BoQBody>
                <Itemlist>
                  <Item ID="I208" RNoPart="1">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Anbohren einer Druckrohrleitung aus PE 100, einschl. Entfernung des Außenschutzes, für Trinkwasser, unter Druck, Hauptrohr d160, Anbohrung d63 . von oben unter 90°</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Rohr anbohren PE Anbohrung d63</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I209" RNoPart="2">
                    <UPBkdn>No</UPBkdn>
                    <Qty>2</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Zustandsprüfung Einbindung Bestand</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Sichtprüfung nach DVGW W 400-2 an [ORT_031] aus PE, für Wasserleitung, für Betriebsdrücke bis PN16</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Prüfungen sind schriftlich zu dokumentieren.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Sichtprüfung hat in Beisein der Bauüberwachung des AG zu erfolgen</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Prüfung des Anschlussbereiches AD 63 bis 160 mm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Das Protokoll zur Sichtprüfung ist als pdf auf einem Datenträger mit abzulegen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Zustandsprüfung Einbindung Bestand</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I210" RNoPart="3">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Anzeige Betriebsunterbrechung Brunnenwasser Referat G2 - Anlagen- und Maschinentechnik.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Absperrung sowie die Dauer der Betriebsunterbrehung soll bei dem Netzbetreiber und StBA ER schriftlich angezeigt werden. Die Anzeige soll mindesten 2 Wochen vor der Ausführung der Maßnahame erfolgen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Anzeige ist mittels Protokoll zu dokumentieren.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Absperren der Teilstrecke Bestandsleitung Brunnenwasser PE 2"  nach Abstimmung mit Betreiber mit Anzeige der Absperrung 2 Wochen vor Ausführung</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Anzeige Betriebsunterbrechung Brunnenwasser Referat G2 - </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Anlagen- und Maschinentechnik</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I211" RNoPart="4">
                    <LumpSumItem>Yes</LumpSumItem>
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Außerbetriebnahme und Entleerung der abgesperrten Teilstrecke BW PE 2", Rohrlänge ca. 250m. Trennen der Rohrleitung, einschließlich Verschließen der Rohrenden</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Medium Brunnenwasser, [PERSON_029] ist aus der Baugrube abzuleiten</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Wiederinbetriebnahme in Abstimmung mit dem Betreiber</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">nach Abschluss der Arbeiten</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Entleerung + Außerbetriebnahme + Wiederinbetriebnahme</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I212" RNoPart="5">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Abstecken der zu errichtenden Rohrleitungsanlage im</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Baufeld, Einmessen der Rohrachsen vor der Verlegung mit</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Höhen- und Lagebezug</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
