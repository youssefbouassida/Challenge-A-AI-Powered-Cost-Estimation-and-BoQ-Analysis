                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Fertigabzweig, 90°-senkrecht DN 250/50</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
