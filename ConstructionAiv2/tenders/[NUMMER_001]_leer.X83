                    <UPBkdn>No</UPBkdn>
                    <Qty>15</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Vorhandenen Pflasterbelag ausbauen, Betonpflaster in Reihen, säubern und seitlich auf Paletten zur Wiederverwendung lagern, in Fahrbahnnebenflächen, im Rahmen einer Teilabbruchmaßnahme.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Ausführung lärmarm, Lärmpegel max. 80 dB(A).</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Mengenermittlung nach Aufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Breite Ausbaufläche:  über 2,5 bis 3,0 m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterart: Betonpflaster, in Reihen</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Dicke: 100 mm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Betonpflaster ausbauen zur Wiederverwendung, Reihen, D 100mm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
