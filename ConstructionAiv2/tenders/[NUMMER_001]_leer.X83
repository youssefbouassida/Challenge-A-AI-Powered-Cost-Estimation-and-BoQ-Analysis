                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Kreuzungsschale, elastische elektrisch nichtleitende Zwischenlage, für Bereiche mit Leitungskreuzungen</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">zur Verhinderung einer leitfähigen Verbindung zwischen kreuzenden Leitungen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
