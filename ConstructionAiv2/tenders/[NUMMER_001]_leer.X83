                          <ChVIdent>60</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3631</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>139</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>786</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>21</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Abbruch des Bordsteins aus Beton, im Rahmen einer Teilabbruchmaßnahme, Form TB 10/25, einschl. Fundament aus Beton und einseitige Rückenstütze, Bettungsdicke 20 cm, Dicke der Rückenstütze 10 cm, Wichte des Abbruchstoffes DIN EN 1991-1-1 24 kN/m3, Geräteeinsatz ist möglich, max. Gesamtgewicht bis 20 t, Ausführung erschütterungsarm DIN 4150, lärmarm, Lärmpegel max. 80 dB(A), </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe sammeln, auf LKW des AN laden, transportieren, entsorgen, zum Lager/zur Anlage nach [PERSON_125] des AN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Bidder" MarkLbl="11" ArtChrIdent="-43">
                            <ComplCaption><span>Anlage (Bezeichnung/Ort) </span></ComplCaption>
                            <ComplBody><span/><br/><span/><br/><span>  .......................... </span></ComplBody>
                            <ComplTail><span>vom Bieter einzutragen</span></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">vom Bieter einzutragen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, Zuordnung Z 0 (uneingeschränkter Einbau), Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170101 Beton, Mengenermittlung nach Aufmaß, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Vergütung der Entsorgung übernimmt AN.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Bordstein Beton abbrechen TB10/25 24kN/m3 Geräteeinsatz mgl. laden transp. LKW AN entsorgen nicht schadstoffbelastet AVV170101 Vergüt.Entsorg. AN</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I106" RNoPart="2">
                    <UPBkdn>No</UPBkdn>
                    <Qty>5</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Rückbau des Bordsteins aus Beton zur späteren Wiederverwendung, im Rahmen einer Teilabbruchmaßnahme, Form TB 10/25, ausgebauten Bordstein säubern und seitlich auf Paletten zum späteren Wiedereinbau lagern.  Fundament aus Beton und einseitige Rückenstütze abbrechen, Bettungsdicke 20 cm, Dicke der Rückenstütze 10 cm, Wichte des Abbruchstoffes DIN EN 1991-1-1 24 kN/m3, Geräteeinsatz ist möglich, max. Gesamtgewicht bis 20 t, Ausführung erschütterungsarm DIN 4150, lärmarm, Lärmpegel max. 80 dB(A), aufgenommene Stoffe zur Entsorgung sortieren, sammeln, </span><span style="text-align:left; font-size:10pt; font-family:Arial">auf LKW des AN laden, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe sammeln, auf LKW des AN laden, transportieren, entsorgen, zum Lager/zur Anlage nach [PERSON_125] des AN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Bidder" MarkLbl="11" ArtChrIdent="-1">
                            <ComplCaption><span>Anlage (Bezeichnung/Ort) </span></ComplCaption>
                            <ComplBody><span/><br/><span/><br/><span>  .......................... </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">vom Bieter einzutragen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, Zuordnung Z 0 (uneingeschränkter Einbau), Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170101 Beton, Mengenermittlung nach Aufmaß, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Vergütung der Entsorgung übernimmt AN.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Rückbau Bordstein Beton zur Wiederverwendung TB10/25 24kN/m3 Geräteeinsatz mgl. TB10/25 24kN/m3, laden transp. LKW AN entsorgen nicht schadstoffbelastet AVV170101 Vergüt.Entsorg. </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I107" RNoPart="3">
                    <UPBkdn>No</UPBkdn>
                    <Qty>4</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Vorhandenen Asphaltbelag mit Schneidegerät vollkommen und glattkantig durchtrennen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Mengenermittlung nach Aufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Dicke des Belages:</span><span style="text-align:left; font-size:10pt; font-family:Arial">bis 15 cm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Asphaltbelag schneiden bis 15 cm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I108" RNoPart="4">
                    <UPBkdn>No</UPBkdn>
                    <Qty>4</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Abbruch der Asphalttrag- und Deckschicht in Fahrbahnen, im Rahmen einer Teilabbruchmaßnahme, Dicke über 10 bis 20 cm, in einem Streifen entlang Bordstein Cauerstraße, Breite ca. 50 bis 80 cm, Geräteeinsatz ist möglich, max. Gesamtgewicht bis 20 t, </span><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe sammeln, auf LKW des AN laden, transportieren, entsorgen, zum Lager/zur Anlage nach [PERSON_125] des AN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Bidder" MarkLbl="11" ArtChrIdent="-1">
                            <ComplCaption><span>Anlage (Bezeichnung/Ort) </span></ComplCaption>
                            <ComplBody><span/><br/><span/><br/><span>  .......................... </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">vom Bieter einzutragen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, RuVA-StB Verwertungsklasse A, Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170302 Bitumengemische,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">die Entsorgungsgebühren werden vom AG übernommen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Asphaltschicht Fahrbahn abbrechen D 10-20cm Geräteeinsatz mgl. laden transp. LKW AN entsorgen bis 20km nicht schadstoffbelastet AVV170302 Entsorg.-[PERSON_062]. AG</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I109" RNoPart="5">
                    <UPBkdn>No</UPBkdn>
                    <Qty>2</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Fräsen der bitumenhaltigen [FIRMA_101], im Rahmen einer Teilabbruchmaßnahme, in Fahrbahnen, mit Asphaltdeckschicht aus Splittmastixasphalt, in Streifen, Breite 50 cm, Tiefe über 3 bis 3,5 cm, Ränder senkrecht abkanten, Flächen reinigen, nicht festhaftende Schichten lösen, </span><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe sammeln, auf LKW des AN laden, transportieren, entsorgen, zum Lager/zur Anlage nach [PERSON_125] des AN, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Bidder" MarkLbl="11" ArtChrIdent="-1">
                            <ComplCaption><span>Anlage (Bezeichnung/Ort) </span></ComplCaption>
                            <ComplBody><span/><br/><span/><br/><span>  .......................... </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">vom Bieter einzutragen,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, RuVA-StB Verwertungsklasse A, Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170302 Bitumengemische,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">die Entsorgungsgebühren werden vom AG übernommen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[FIRMA_101] fräsen Fahrbahn B 50cm T 3-3,5cm laden transp. LKW AN entsorgen bis 20km nicht schadstoffbelastet AVV170302 Entsorg.-[PERSON_062]. AG</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I110" RNoPart="6">
                    <UPBkdn>No</UPBkdn>
                    <Qty>2</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">STLB-Bau 04/2020 084</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abbruch der Befestigung ohne [PERSON_147] aus Schotter-Splitt-Brechsand-Gemisch, in Fahrbahnflächen, im Rahmen einer Teilabbruchmaßnahme, Wichte des Abbruchstoffes DIN EN 1991-1-1 20 kN/m3, Dicke über 20 bis 30 cm,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Geräteeinsatz ist möglich, max. Gesamtgewicht bis 20 t, Ausführung erschütterungsarm DIN 4150, lärmarm, Lärmpegel max. 80 dB(A),</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">aufgenommene Stoffe zur Wiederverwendung sortieren, sammeln, wiederverwendbare Stoffe seitlich lagern, nicht wiederverwendbare Stoffe sammeln, und auf der Baustelle lagern,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abfall ist nicht gefährlich, nicht schadstoffbelastet, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Zuordnung Z 0 (uneingeschränkter Einbau), </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Mengenermittlung nach Aufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Befestigung ohne [PERSON_147] </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Schotter-Splitt-Brechsand-Gemisch Fahrbahnflächen </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">abbrechen 20kN/m3 D 20-30cm Geräteeinsatz mgl. </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">wiederverwendb Stoffe lagern nicht schadstoffbelastet</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="C17" RNoPart="2">
              <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">[ORT_030]</span><br/></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R25">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] Kanalgraben, Leitungsgraben</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] Kanalgraben, Leitungsgraben</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R26">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Baugrundverhältnisse</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Ein Bodengutachten liegt für die unmittelbar benachbarte Baustelle NTC-Hauptgebäude vor. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Angabe zu den Homogenbereichen siehe Anlage Nr. 5</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Grundwasserstand liegt lt. Gutachten im Bereich Baufeld NTC in Tiefen zwischen 290,00 müNN bis 289,53 müNN. Die Oberfläche des Baugeländes liegt ungefähr bei 293,90 müNN.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Es liegen sandige Deckschichten, generell mitteldicht gelagert vor. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Die Hauptleitungstrasse verläuft überwiegend unter der derzeitigen Feuerwehrumfahrt, nördlich der Zentralwerkstatt und des IZNF,mit einem Fahrbahnaufbau, Pflasterbelag und Tragschichten in der Dicke von ca. 60-70 cm.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Baugrundverhältnisse, Angabe zu den Homogenbereichen</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R27">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung Abrechnung Breite Grabenaushub</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Je nach Rohrleitungsart oder Kabelart wird die Mindestgrabenbreite entsprechend DIN 4124 oder DIN EN 1610 abgerechnet. Abrechnung senkrecht.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">In Bereichen mit Schalungs- und Verbaukonstruktionen können zusätzlich zur Breite 2 x 15cm mit abgerechnet werden.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung Abrechnung Breite Grabenaushub</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R28">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standardbeschreibung</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Mengenermittlung der Bodenbewegungen nach Aufmaß an der</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Einbaustelle in eingebautem Zustand.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standardbeschreibung</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
