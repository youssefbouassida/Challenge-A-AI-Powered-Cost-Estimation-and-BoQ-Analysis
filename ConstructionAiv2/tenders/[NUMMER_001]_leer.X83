                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">[PERSON_129] Broen DN 250 (273,0/400)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stahlqualität P235 GH, Schlüsselweite 27/70</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">nach EN 10217 geschweißt</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">PEHD-Mantel, inkl. IPS</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">reduzierter Durchgang</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Kugel aus [PERSON_115], Zapfengelagert</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Druckstufe PN 25</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">produziert nach EN 488</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_129] Broen DN 250</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
                    <SubDescr>
                      <SubDNo>2</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Spindelverlängerung [PERSON_129] [PERSON_115]</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"> / [PERSON_089] verzinkt, kürzbar</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">mittel Schlüsselweite 27/70mm, L = 2,00m,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">sind für die Getriebenutzung geeignet,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Anpassung Spindellänge in Werk- und Montageplanung</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
