                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-6476">
                            <ComplCaption><span>Positionsmenge = Produkt aus </span></ComplCaption>
                            <ComplBody><span> </span><br/><span>15 m</span><br/><span>(Vorhaltemenge)</span><br/><span>mal  </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">(Vorhaltemenge)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Owner" MarkLbl="12" ArtChrIdent="-6477">
                            <ComplCaption><span>mal </span></ComplCaption>
                            <ComplBody><span> </span><br/><span>28 wochen </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">(Vorhaltedauer).</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Leitungsbehelfsbrücke L 10-15m H 4-4,5m B 4,5-6m vorhalten</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
