                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">ELE/ELÜ-Rohr DN 50 (60,3/125), [PERSON_129] 1A</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">L = 2,0 m, Druckstufe PN 25</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stahlqualität P235 GH, geschweißt</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">PEHD-Mantel, inkl. IPS</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Broen [PERSON_115] 1.4404 red. Durchgang SE/IG</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Blindstopfen, produziert nach EN 488,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Anpassung Anschlussrohrleitung in Werk- und Montageplanung</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
