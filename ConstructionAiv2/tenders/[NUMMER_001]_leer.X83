                    <Qty>15</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">STLB-Bau 04/2020 080 TA</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke, barrierefrei DIN 18040-3, aus Pflastersteinen aus Beton, ungebundene Bauweise, Tragschicht wird gesondert vergütet, Maße L/B 200/100 mm, Dicke 100 mm, gebrauchte Steine, seitlich lagernd, in Reihen mit versetzten [PERSON_016], Farbton grau, in Fahrbahnnebenflächen, Bettung aus Gesteinskörnung Körnung 2/5 aus natürlichen gebrochenen Gesteinskörnungen (Splitt), Dicke 4 +/-1 cm, Gesteinskörnung für [PERSON_016], Körnung 1/3 aus natürlichen gebrochenen Gesteinskörnungen (Splitt) einbringen, Ausführung gemäß Einzelbeschreibung:</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pflasterdecke gem. TL Pflaster StB. Einzupassende Steine sind mit einem geeigneten Schneidegerät in der gesamten Stärke zu durchschneiden. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Die Pflasterfläche ist nach dem Verlegen und Abrütteln solange durch Einschlämmen zu verfugen, bis die [PERSON_016] dicht geschlossen bleiben. </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abrechnung nach Flächenaufmaß.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Stein: Pflasterstein</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steingrösse: ca. 20 x 10 x 10 cm (LxBrxD) inkl. Rand- und Endsteinen </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Kanten: mit Fase</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Abstandhalter: vorhanden</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Bettungsmaterial: Basalt- oder Diabas-Splitte 2/5 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenbreite: mind. 5 mm, max. 7 mm </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Fugenfüllung: 2-lagig </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">untere Fugenfüllung: Edelsplitt 1/3 mm bis 3 cm unter OK Pflasterstein nach Abrütteln</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">obere Fugenfüllung: Granit-Brechsand 0/3, eingeschlämmt bis OK Pflasterstein</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Farbton: grau</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Pflasterdecke gebraucht seitl.lagernd L/B 200/100mm D 100mm </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
