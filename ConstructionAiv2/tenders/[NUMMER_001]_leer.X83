                  <Item ID="I214" RNoPart="7">
                    <UPBkdn>No</UPBkdn>
                    <Qty>220</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Druckrohrleitung vor Inbetriebnahme spülen, für [PERSON_029],</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Rohrleitung aus PE DN 65.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Wasser ist vor Ort vorhanden (Bauwasseranschluss)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">notwendiges Hilfsmaterial: Schlauch, ca. 200 m inkl. Verschraubungen liefern, montieren, verwenden und nach Abschluss der Arbeit demontieren</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Über das Spülen der Leitungsanlage ist vom Auftragnehemer ein Protokoll zu erstellen, das vom Auftragnehmer und vom Auftraggeber bzw. dessen Beaftragten zu unterschreiben ist.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Druckrohr spülen [PERSON_029] bis DN65</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I215" RNoPart="8">
                    <UPBkdn>No</UPBkdn>
                    <Qty>500</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">STLB-Bau 04/2020 043</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Druckprüfung DIN EN 805, als Vorprüfung, Druckabfallprüfung und Hauptdruckprüfung nach dem Druckverlustverfahren, an [ORT_031] aus PE, für [PERSON_029], Nenndruck 1,6 MPa (16 bar), bis DN/OD 63, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Rohrleitungslänge </span><span style="text-align:left; font-size:10pt; font-family:Arial"> 250 </span><span style="text-align:left; font-size:10pt; font-family:Arial"> m, [PERSON_029] wird beigestellt und ist </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">abzuleiten.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
