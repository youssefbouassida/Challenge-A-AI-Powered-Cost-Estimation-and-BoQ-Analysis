                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Gewölbter Boden Klöpperform Kohlenstoffstahl Schweißen </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_044] AD 273mm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                    <SumDescr>Yes</SumDescr>
                    <SubDescr>
                      <SubDNo>1</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Aufschweißung Rohrstück DN25, Stahlgewinderohr DIN EN 10255, mind. 0,1 m, einseitiges Gewinde, Gedichtetes Aufschrauben eines Messingskugehahns mit demontierbarer Betätigung, Gedichtetes Aufschrauben Rohrstück DN25 0,15 m lang mit beidseitigem Gewinde, dichter Verschluss offenes Ende mit Schraubverschlussdeckel aus [PERSON_176], einschl. kompletter Umantelung mit Korrosionsschutzband für die aufgeschweißte Zusatzaustatttung Gewölbter Boden.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Hinweis: Dient als Füllvorrichtung</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Zusatzausstattung</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
                  </Item>
                  <Item ID="I176" RNoPart="13">
                    <UPBkdn>No</UPBkdn>
                    <Qty>2</Qty>
