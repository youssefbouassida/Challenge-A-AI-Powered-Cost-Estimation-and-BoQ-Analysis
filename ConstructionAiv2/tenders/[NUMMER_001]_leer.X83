                        <STLBBauID>
                          <ArtChrIdent>9153</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Stammschutz durch 40 mm dicken Bohlenmantel einschl. Polsterung gegen den Baum, Stammumfang in 1 m Höhe gemessen über 0,5 bis 1 m, Mindestabstand vom Stamm 10 cm, Mindesthöhe 2 m, herstellen.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Stammschutz Ummantelung Bohlen Polsterung U 0,5-1m H 2m </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">herstellen</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I50" RNoPart="12">
                    <UPBkdn>No</UPBkdn>
                    <Qty>3</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Schutz der bestehenden Mastleuchten durch Pfahl-Dreibock mit zwei Rahmen aus Halbrundhölzern oder Brettern, Pfahllänge 250 cm, Mindesthöhe 2 m, herstellen.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Höhe erster Rahmen: ca. 1m über OK Gelände</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Höhe zweiter Rahmen: 2m über OK Gelände</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Schutz Mastleuchte Bestand H 2m </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">herstellen</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="C8" RNoPart="2">
              <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">[ORT_030]</span><br/></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R8">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] Kanalgraben, Leitungsgraben</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] Kanalgraben, Leitungsgraben</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R9">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Baugrundverhältnisse</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Ein Bodengutachten liegt für die unmittelbar benachbarte Baustelle NTC-Hauptgebäude vor. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Angabe zu den Homogenbereichen siehe Anlage Nr. 5</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Grundwasserstand liegt lt. Gutachten im Bereich Baufeld NTC in Tiefen zwischen 290,00 müNN bis 289,53 müNN. Die Oberfläche des Baugeländes liegt ungefähr bei 293,90 müNN.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Es liegen sandige Deckschichten, generell mitteldicht gelagert vor. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Die Hauptleitungstrasse verläuft überwiegend unter der derzeitigen Feuerwehrumfahrt, nördlich der Zentralwerkstatt und des IZNF,mit einem Fahrbahnaufbau, Pflasterbelag und Tragschichten in der Dicke von ca. 60-70 cm.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Baugrundverhältnisse, Angabe zu den Homogenbereichen</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R10">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung Abrechnung Breite Grabenaushub</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Je nach Rohrleitungsart oder Kabelart wird die Mindestgrabenbreite entsprechend DIN 4124 oder DIN EN 1610 abgerechnet. Abrechnung senkrecht.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">In Bereichen mit Schalungs- und Verbaukonstruktionen können zusätzlich zur Breite 2 x 15cm mit abgerechnet werden.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung Abrechnung Breite Grabenaushub</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R11">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standardbeschreibung</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Mengenermittlung der Bodenbewegungen nach Aufmaß an der</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Einbaustelle in eingebautem Zustand.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standardbeschreibung</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R12">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Vorbemerkung - Erd- und Grabenarbeiten - Baumwurzeln</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">kleine Teilflächen waren oder sind bei Baubeginn mit</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Waldbäumen bestockt.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Bei den [ORT_030] bzw. Grabenarbeiten ist davon</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">auszugehen, dass in unterschiedlichen Tiefen</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Baumwurzeln der noch vorhandenen oder der</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">eingeschlagenen Bäume vorgefunden werden.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Der Rückschnitt der größeren Baumwurzeln wird in eigener Position vergütet.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">FAU - Kälteverbund Vorbemerkung: Erd- und Grabenarbeiten, Baumwurzeln</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
