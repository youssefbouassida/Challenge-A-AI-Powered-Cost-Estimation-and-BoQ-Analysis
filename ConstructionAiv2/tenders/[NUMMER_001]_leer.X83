                  <Item ID="I13" RNoPart="14">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Witterungsschutz-Zelt, für Tiefbauarbeiten, einzuhaltende Innentemperatur mind. 10 Grad C, bei einer Außentemperatur unter 10 Grad C bis 0 Grad C, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">für lichte Grabenbreite bis 3m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Länge bis 8m, Höhe 2,3 m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">aufstellen und räumen, aussteifen und verankern an den am Bauwerk vorh. Vorrichtungen, bekleiden mit transparenten Baustoffen Baustoffklasse DIN 4102-1 B2 (normalentflammbar), einschl. Unterkonstruktion, Aussteifung und Befestigung, verbinden der Stöße regen- und windsicher, aufblähen durch Wind vermeiden, Randanschlüsse allseitig regen- und windsicher, Standfläche waagerecht, direkt belastbar, Untergrund Erdreich.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Witterungsschutz-Zelt 10GradC aufstellen räumen</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
