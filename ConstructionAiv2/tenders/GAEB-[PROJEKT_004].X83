ily:Arial;">für UHPC-Stahlbetonrohre</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">liefern und versetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) DN 900 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">FBS - Böschungsstück DN 900 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2233" RNoPart="0006"><Qty>2.000</Qty><QU>Stk.</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bestehende Betonrohre</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">schneiden, mit Schneidgerät,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_047] in Eigentum des AN übernehmen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und von der Baustelle entfernen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) DN 800 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bestehende Betonrohre DN 800 schneiden</span></p></TextOutlTxt></OutlTxt></Outli