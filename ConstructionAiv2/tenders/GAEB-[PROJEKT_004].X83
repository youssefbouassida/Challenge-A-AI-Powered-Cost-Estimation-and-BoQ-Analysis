<?xml version='1.0' encoding='UTF-8'?>
<!-- GXML Toolbox V3.3 R20200224;  [URL_012]  --><GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2025-05-16</Date><Time>13:37:20</Time><ProgSystem>/ GXML Toolbox V3.3 R20200224</ProgSystem><ProgName>ORCA AVA 23.2.1 - Professional Edition 23.02.01</ProgName></GAEBInfo><PrjInfo><NamePrj>152516</NamePrj><LblPrj>[PROJEKT_004]</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>83</DP><AwardInfo><Cat>SelectCall</Cat><Cur>EUR</Cur><CurLbl>Euro</CurLbl><SubmLoc/></AwardInfo><AddText><OutlineAddText><span>Vorbemerkungen</span></OutlineAddText><DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Die </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Gemeinde Maierhöfen,</span><span style="font-size:10pt;font-family:Arial;"> [ADRESSE_016], vertreten durch den 1. Bürgermeister [PERSON_031] beabsichtigt die Erneuerung und Vergrößerung des Bachdurchlasses in Neppen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Die derzeitige Verrohrung hat einen Durchmesser von 600 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Die geplante Verrohrung besteht aus Stahlbetonrohren DN 800/900 mm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">mit zwei Tangential-Schächten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Die Gesamtlänge beträgt 121 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Bauablauf :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Baustelle einrichten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Asphaltaufbruch bei Straßenquerung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Erstellen Rohrgraben für Stahlbetonrohre,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Im Zuge [ORT_030], Ausbau der bestehenden Bachverrohrung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Wasserhaltung, [PERSON_139] Bach.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Abbruch bestehendes Bauwerk,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Übergang von 800er-Betonrohre auf neue 800er-Stahlbetonrohre mit VPC-Kupplung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Verlegen Stahlbetonrohre DN 800/900 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Asphalteinbau bei Straßenquerung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Humusierungsarbeiten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Baustelle räumen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Bauzeit :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Der Baubeginn ist variabel (nach [PERSON_125] AN).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Der Fertigstellungstermin wird festgelegt auf :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">28.11.25</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Beweissicherung :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Vor Baubeginn (d.h. vor Einrichtung der Baustelle) ist über den Zustand der angrenzenden Wege und Hofflächen, Bäume und Einfriedungen etc. eine Beweissicherung durch Fotoaufnahmen und Beschreibung des Zustandes durchzuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Die Aufwendungen hierfür werden nicht seperat vergütet und sind in die Einheitspreise einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Der Planung und Bauausführung zugrunde gelegte Normen </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Regelwerk und DIN-Normen des </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">DVGW</span><span style="font-size:10pt;font-family:Arial;">, Deutscher Verein des Gas- und Wasserfaches</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Vergabe- und Vertragsordnung für Bauleistungen, VOB A, B, C, Ausgabe 2019</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Abnahme :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Voraussetzung für eine Abnahme ist die Einverständniserklärung der jeweiligen Grundstückseigentümer, dass diese mit dem hinterlassenen Zustand ihrer Grundstücke einverstanden sind.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Diese Erklärungen sind vom AN einzuholen und vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/></DetailAddText></AddText><BoQ ID="id1848"><BoQInfo><Name>01</Name><LblBoQ>[PROJEKT_004]</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Titel</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Bereich</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn><NoUPComps>2</NoUPComps><LblUPComp1 Type="Materials">Material</LblUPComp1><LblUPComp2 Type="Wages">Lohn</LblUPComp2><LblTime>Stunden</LblTime></BoQInfo><BoQBody><BoQCtgy ID="id1850" RNoPart="01"><LblTx><p><span>Baustelleneinrichtung und -räumung</span></p></LblTx><BoQBody><Itemlist><Remark ID="id1851"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Vorbemerkung SiGeKo :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Aktivitäten nach der Baustellenverordnung (SiGeKo) :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Der Auftraggeber (AG) geht davon aus, dass der Auftragnehmer (AN) alle Bauleistungen im eigenen Betrieb ausführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Damit sind keine (weiteren) Aktivitäten gemäß Baustellenverordnung erforderlich.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Falls der Auftragnehmer Bauleistungen an Nachunternehmer überträgt, werden Aktivitäten gemäß Baustellenverordnung erforderlich.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Beauftragung eines, dann erforderlichen, SiGe-Koordinator erfolgt durch den AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Kosten hierfür werden nicht seperat vergütet und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sind in die Einheitspreise einzurechnen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:496pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Vorbemerkung SiGeKo</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id1852" RNoPart="0001"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Einrichten und Räumen der Baustelle für sämtliche</span><br/><span style="font-size:10pt;font-family:Arial;">in der Leistungsbeschreibung aufgeführten Leistungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">An- und Abtransport der erforderlichen Baumaschinen,</span><br/><span style="font-size:10pt;font-family:Arial;">Geräte, Werkzeuge, Baubüros und Lagerräume.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Strom-, Wasseranschluss, sowie Entsorgungseinrichtungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und dgl. für die Baustelle, soweit erforderlich, herstellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Beschaffen und Anlegen von Lager- und Arbeitsflächen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Flächen nach Beendigung der Baumaßnahme wieder </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in den ursprünglichen Zustand versetzen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Baustelleneinrichtung und -räumung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id1853"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrsregelungen</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrsregelungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id1854" RNoPart="0002"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrszeichen und Beschilderungen</span><br/><span style="font-size:10pt;font-family:Arial;">nach den Vorgaben der verkehrsrechtlichen</span><br/><span style="font-size:10pt;font-family:Arial;">Anordnung liefern, aufstellen, vorhalten</span><br/><span style="font-size:10pt;font-family:Arial;">und abbauen,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">verkehrsrechtliche Genehmigung beantragen,</span><br/><span style="font-size:10pt;font-family:Arial;">Baustelle den Vorschriften entsprechend</span><br/><span style="font-size:10pt;font-family:Arial;">fortwährend sichern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Gefahrenquellen nachts, nach sicherheitstechnischen</span><br/><span style="font-size:10pt;font-family:Arial;">Vorgaben, beleuchten.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Abrechnung einmalig für die Dauer der</span><br/><span style="font-size:10pt;font-family:Arial;">gesamten Bauzeit.</span><br/></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrsregelung und -sicherung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id1855" RNoPart="0003"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrssicherung</span><br/><br/><span style="font-size:10pt;font-family:Arial;">(1) Durch Baustellenverkehr verschmutzte</span><br/><span style="font-size:10pt;font-family:Arial;">Zufahrtsstraßen und -wege nach Bedarf, evt. mehrmals</span><br/><span style="font-size:10pt;font-family:Arial;">täglich mit Kehrmaschine (Unimog) ordnungsgemäß</span><br/><span style="font-size:10pt;font-family:Arial;">nass reinigen.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">(2) Offene Rohrgräben bzw. sonstige Gefahrenquellen</span><br/><span style="font-size:10pt;font-family:Arial;">mittels mobilem Bauzaun aus Stahlgitterelementen sichern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bauzaun aufbauen, vorhalten, versetzen und abbauen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Verkehrssicherung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2055" RNoPart="0004"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnungsunterlagen, prüffähig erstellen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnungslageplan,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">unter Verwendung der Ausführungsunterlagen auf Grundlage der Landeskoordinaten (UTM 32),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">UTM-Koordinaten ermitteln.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die UTM-Koordinaten sind möglichst am offenen Graben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">zu bestimmen oder anhand von Sicherungen und Markierungen durch den Polier.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abgabe der Pläne als Datei</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">im Format DWG bzw. DXF und 2-fach als Farb-Plot.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Ausführungsunterlagen werden dem AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in digitaler Form kostenfrei zur Verfügung gestellt.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnungsunterlagen erstellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id2152" RNoPart="02"><LblTx><p><span>Tiefbauarbeiten</span></p></LblTx><BoQBody><Itemlist><Item ID="id2165" RNoPart="0001"><Qty>70.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt schneiden, mit Fugenschneidgerät,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">senkrechter Schnitt, Restdicke trennen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach [PERSON_125] des AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Asphaltstärke bis 15 cm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt schneiden, bis 15 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2166" RNoPart="0002"><Qty>12.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphaltaufbruch,</span><br/><span style="font-size:10pt;font-family:Arial;">Aufbruchverfahren </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">mittels Bagger</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">oder sonstigem geeigneten Gerät,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphaltbruch in Eigentum des </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">AN übernehmen und von der Baustelle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">entfernen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Asphaltstärke bis 15 cm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphaltaufbruch bis 15 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2211" RNoPart="0003"><Qty>260.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Oberboden,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Homogenbereich B 0, DIN 18300,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">abtragen, mit geeignetem Gerät,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abtragstärke bis 25 cm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abtragbreite in Abstimmung mit Bauleitung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Oberboden seitlich fachgerecht in Mieten lagern,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wieder auftragen und planieren</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Oberbodenabtrag- und auftrag</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2212" RNoPart="0004"><Qty>1300.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Benutzte Wiesenflächen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">(Humusierte Flächen und Lagerflächen)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">fachgerecht auflockern, abrechen und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">entsteinen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">mit Wiesen-Saatgutmischung in Abstimmung</span><br/><span style="font-size:10pt;font-family:Arial;">mit Grundstückseigentümer ansäen,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Ansaatbreite in Abstimmung mit Bauleitung.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Begrünungsarbeiten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2213" RNoPart="0005"><Qty>270.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Rohrgrabenaushub für Kanäle und Schächte,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Homogenbereich B1 und B2,</span><br/><span style="font-size:10pt;font-family:Arial;">(vormals Bodenklasse 3-5, DIN 18300)</span><br/><span style="font-size:10pt;font-family:Arial;">ausheben, seitlich lagern, wieder verfüllen</span><br/><span style="font-size:10pt;font-family:Arial;">und verdichten,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnung ab UK Humus bzw. Asphalt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Mehraushub für Schächte, über Regelbreite hinaus,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wird nicht gesondert vergütet und ist einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Rohrgrabensohle fachgerecht verdichten,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Aushub mit Verbau oder geböscht, nach [PERSON_125] des AN,</span><br/><span style="font-size:10pt;font-family:Arial;">Abrechnung in jedem Fall senkrecht, nach Regelbreite,</span><br/><span style="font-size:10pt;font-family:Arial;">Mehraushub für Böschungen ist einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Regelbreite :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">RB DN 800/900 mm = 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Aushubtiefe bis 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Aushub </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">seitlich lagern</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sofern geotechnisch geeignet,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wiederverfüllen und verdichten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Rohrgrabenaushub, bis 2m, seitlich lagern, wieder einbauen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2214" RNoPart="0006"><Qty>130.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wie vor, jedoch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">02) Aushub verfahren</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und auf AG-Lagerplatz in Haufwerken,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">zur Beprobung zwischenlagern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Transportentfernung bis 2 km.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Rohrgrabenaushub, Abfuhr auf AG-Zwischenlager</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2215" RNoPart="0007"><Qty>100.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wie vor, jedoch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">03) [PERSON_093], unbelastet, Z 0,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">direkt auf AN-Kippe abfahren</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">einschließlich Kippgebühr.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Rohrgrabenaushub, Z0, auf AN-Kippe abfahren</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2216" RNoPart="0008"><Qty>130.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Aushub von AG-Zwischenlager</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">aufnehmen, verladen auf LKW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Abfuhr Aushub, </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">unbelastet, Z 0</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">auf AN-Kippe, einschl. Kippgebühr.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Anmerkung :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Haufwerke werden bauseits beprobt</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und auf Schadstoffbelastung hin, analysiert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Entsorgungskosten für belastete Böden</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">obliegen dem AG.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Aushub von Lager aufnehmen, Abfuhr Z 0 auf AN-Kippe</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2220" RNoPart="0009"><Qty>230.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Rohrauflager (Bettung),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Auflagerwinkel 120°,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Schichtdicke : 15 cm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und Seitenverfüllung und Abdeckung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Schichtdicke : 20 cm über Rohrscheitel</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">herstellen, nach DIN EN 1610,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Einbau innerhalb der Regelbreite,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Verdrängung durch Schächte und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Rohre werden abgezogen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Verwendung von</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Feinkies (Planiekies) 0/32 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Kanäle DN 800/900 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Rohrauflager und -einbettung, Feinkies 0/32 mm, bis DN 900 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2234" RNoPart="0010"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Rohrauflager für Einlauf-Bauwerk,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">mit Beton (Betonauflager) herstellen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Stärke 20 cm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Beton C 12/15 liefern und höhengerecht</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">einbauen und verdichten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Betonauflager für Einlaufbauwerk, Stärke 20 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2217" RNoPart="0011"><Qty>35.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bodenaustausch innerhalb Rohrgraben</span><br/><span style="font-size:10pt;font-family:Arial;">herstellen, Austauschmaterial liefern,</span><br/><span style="font-size:10pt;font-family:Arial;">höhengerecht einbauen und verdichten,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnung senkrecht,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach Regelbreite (RB) :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">RB DN 800/900 mm = 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Mehrbreiten durch Böschungen sind</span><br/><span style="font-size:10pt;font-family:Arial;">einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">01) Rollkies 16/32 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bodenaustausch Rohrgraben - Rollkies 16/32 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2218" RNoPart="0012"><Qty>50.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wie vor, jedoch</span><br/><span style="font-size:10pt;font-family:Arial;">02) Grubenkies (bindiges Wandkies),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Körnung 0/X, nicht frostsicher</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bodenaustausch Rohrgraben - Grubenkies</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2194" RNoPart="0013"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Zuschlag auf [ORT_030] für </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">[PERSON_121]</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Tiefe bis 1,25 m,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">zu querende Leitungen, Kabel und Kanäle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">maschinenunterstütztem Handaushub</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach Vorschrift des jeweiligen Versorgungsträgers</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sorgfältig freilegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Freilegen bis </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Oberkante</span><span style="font-size:10pt;font-family:Arial;"> der jeweiligen Sparte.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die vollständige Freilegung der Sparte in</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Handarbeit (Handaushub) wird in der Position "Unterfahren" vergütet.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Zuschlag für [PERSON_121]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2195" RNoPart="0014"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Unterfahren von freigelegten Leitungen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Kabel und Kanälen (freigelegt bis OK),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Leitungen, Kabel und Kanäle (Hindernisse)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">vollständig in </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">maschinenunterstützter Handarbeit</span><span style="font-size:10pt;font-family:Arial;"> freilegen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Hindernisse fachgerecht, nach den</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Vorschriften des jeweiligen Versorgungsträger</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sichern,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Wiederherstellung der Auflager und [PERSON_072]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_072] liefern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Unterfahren quer, innerhalb Rohrgrabenbreite</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Unterfahren von Leitungen, Kabel und Kanälen, quer</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2196" RNoPart="0015"><Qty>20.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">wie vor, jedoch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">02) Unterfahren längs, innerhalb Baugrube</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnung nach lfdm.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Unterfahren von Leitungen, Kabel und Kanälen, längs</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2177" RNoPart="0016"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Wasserhaltung Bach,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach [PERSON_125] AN durchführen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Wasserhaltung durch [PERSON_139]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> oder Umleitung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">mittels Ableitungskanal,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Länge Ableitungskanal bis 10 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Ableitungskanal erstellen, vorhalten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und abbauen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sämtliches Material bleibt im Eigentum</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">des AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Förder- bzw. Umleitungsmenge</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">bis 150 l/s.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Wasserhaltung Bach bis 150 l/s</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2180" RNoPart="0017"><Qty>100.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bauteile, welche im Zuge Aushubarbeiten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">freigelegt werden, ausbauen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Material in Eigentum des AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">übernehmen und von der Baustelle entfernen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Betonrohre DN 600 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bestehende Bachverrohrung DN 600 Beton ausbauen, entsorgen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2192" RNoPart="0018"><Qty>4.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bestehendes Bauwerk (Zwischenschacht)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">abbrechen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Boden, Wände und Decke</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">aus Stahlbeton,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abbruch mit geeignetem Gerät</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach [PERSON_125] des AN, maschinell und von Hand.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_047] (Beton und Armierungseisen) laden,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">verfahren innerhalb Baustelle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und in Haufwerken (Chargen) in Abstimmung mit Bauleitung lagern.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bauwerk abbrechen, Schutt zwischenlagern</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2193" RNoPart="0019"><Qty>10.000</Qty><QU>to</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_047] (Beton und Armierungseisen)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in Haufwerken gelagert, nach Deklaration</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">aufnehmen, in </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Eigentum des AN übernehmen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und einer ordnungsgemäßen Entsorgung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">gemäß RC-Leitfaden zuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Deklaration wird bauseits durchgeführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Material unbelastet, gemäß RC-Leitfaden</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Anmerkung :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Haufwerke werden bauseits beprobt</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">und auf Schadstoffbelastung hin, analysiert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Die Entsorgungskosten für belastetes Material</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">obliegen dem AG.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_047] aufnehmen und entsorgen - Einstufung :  RW 1</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2182" RNoPart="0020"><Qty>25.000</Qty><QU>to</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Wasserbausteine</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">liefern und fachgerecht versetzen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">zur Sicherung Böschung Happacher Bach,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Hohlräume zwischen den</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">aufgeschichteten Wasserbausteinen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">mit Feinkies/Sand verfüllen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Feinkies/Sand liefern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Wasserbausteine C 200/400</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Wasserbausteine C 200/400 liefern und versetzen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2201" RNoPart="0021"><Qty>50.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Frostschutzschicht (FSS) herstellen,</span><br/><span style="font-size:10pt;font-family:Arial;">Frostschutzkies, Körnung 0/56 mm liefern,</span><br/><span style="font-size:10pt;font-family:Arial;">höhen- und profilgerecht nach Regelprofil einbauen</span><br/><span style="font-size:10pt;font-family:Arial;">und verdichten,</span><br/><span style="font-size:10pt;font-family:Arial;">herstellen einer Feinplanie mit zu lieferndem</span><br/><span style="font-size:10pt;font-family:Arial;">Planiekies 16/32 mm.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Verformungsmodul Ev2 min. 120 MN/m2</span><br/><span style="font-size:10pt;font-family:Arial;">Verhältniswert der Verformungsmoduln Ev2/Ev1 max 2,2</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Gesamtstärke der ungebundenen Tragschicht bis 52 cm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Abrechnung nach tatsächlicher Einbaustärke.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Einschl. Nachweis des geforderten Verformungs-</span><br/><span style="font-size:10pt;font-family:Arial;">module mittels </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">dynamischer</span><span style="font-size:10pt;font-family:Arial;"> Lastplattenversuche.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Anzahl der Lastplattenversuche in Abstimmung mit</span><br/><span style="font-size:10pt;font-family:Arial;">Bauleitung.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Frostschutzschicht herstellen, Stärke bis 52 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2203" RNoPart="0022"><Qty>70.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalttragschicht aus [PERSON_173]</span><br/><span style="font-size:10pt;font-family:Arial;"> 70/100,</span><br/><span style="font-size:10pt;font-family:Arial;">in wechselnden Breiten auf Frostschutzschichten</span><br/><span style="font-size:10pt;font-family:Arial;">maschinell (Fertiger) und von Hand,einbauen,</span><br/><span style="font-size:10pt;font-family:Arial;">Unebenheiten der Oberfläche max. 6 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Einbau zwischen Randeinfassungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) AC 32 TN, Einbaustärke 10 cm (250 kg/m2)</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bitukies AC 32 TN - Stärke 10 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2205" RNoPart="0023"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Bestehende Asphaltdecke</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">abfräsen, mit Fräse,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">auf gesamte Fahrbahnbreite,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Frässtärke mind. 4 cm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Fräsgut bleibt Eigentum des AG.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Abrechnung nach m3</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Fräsgut auf LKW laden,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">auf AG-Kippe abfahren und abladen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Transportentfernung einfach bis 3 km.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt fräsen, 4 cm - Fräsgut auf AG-Lagerplatz</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2207" RNoPart="0024"><Qty>90.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt</span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">deck</span><span style="font-size:10pt;font-family:Arial;">schicht AC 11 DN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">aus [PERSON_173]</span><br/><span style="font-size:10pt;font-family:Arial;"> 50/70,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach ZTV Asphalt-StB,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Unebenheiten der Oberfläche max. 6 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">liefern, höhengerecht einbauen und verdichten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Einbaustärke 4 cm (100 kg/m2)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Einbau mit Fertiger und von Hand</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphaltbeton 0/11 mm, Stärke 4 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2208" RNoPart="0025"><Qty>30.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Anschluss an bestehende Decken in der</span><br/><span style="font-size:10pt;font-family:Arial;">Dicke der Asphaltdeckschicht mit anschmelzbarem</span><br/><span style="font-size:10pt;font-family:Arial;">Fugenband (TOK-Band) herstellen,</span><br/><span style="font-size:10pt;font-family:Arial;">Längs- und Querfuge, Breite mind. 10 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">01) Dicke der Deckschicht 40 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">TOK-Band 40 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2202" RNoPart="0026"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Kiesbankette herstellen,</span><br/><span style="font-size:10pt;font-family:Arial;">liefern, einbauen und verdichten von</span><br/><span style="font-size:10pt;font-family:Arial;">Bankettkies 0/22 mm,</span><br/><span style="font-size:10pt;font-family:Arial;">Einbaubreite bis 50 cm, Stärke 5-8 cm,</span><br/><span style="font-size:10pt;font-family:Arial;">Einbau mit Querneigung 6%,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">gemäß Regelprofil.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Kiesbankette herstellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id2153" RNoPart="03"><LblTx><p><span>Stahlbetonrohre, Schächte, Einlaufbauwerk</span></p></LblTx><BoQBody><Itemlist><Item ID="id2221" RNoPart="0001"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">UHPC-Stahlbetonrohre,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">nach EN 1916 und DIN V 1201 [PERSON_129] 2,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">mit FBS-Zulassung und statischem Nachweis,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">liefern und fachgerecht verlegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Herstellungslänge :  3,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Mit in der Muffe fest eingebauter Kompressions-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Gleitringdichtung aus Elastomeren mit dichter</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Struktur,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Betongüte C 80/95</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Betonfestigkeit bsi 120 N/mm2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Betonbiegezugfestigkeit &gt; 16 N/mm2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Lastklasse über LC 250,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">E-Modul (38 kN/mm2), duktiles Verhalten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Expositionsklassen : </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">XC4, XD3, XF4, XA2, XM2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Hersteller :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[FIRMA_084] &amp; Co. KG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Betonwarenfabriken</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Stolzenseeweg 9</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">88353 Kisslegg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Tel. [TELEFON_077]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="ma