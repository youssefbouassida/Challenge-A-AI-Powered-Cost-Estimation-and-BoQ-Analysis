<?xml version='1.0' encoding='UTF-8'?>
<!-- GXML Toolbox V3.3 R20220330;  [URL_012]  --><GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2024-02-27</Date><Time>13:41:47</Time><ProgSystem>/ GXML Toolbox V3.3 R20220330</ProgSystem><ProgName>ORCA AVA 25.0.4 - Professional Edition 25.00.04</ProgName><Certific>Available</Certific></GAEBInfo><PrjInfo><NamePrj>8209.003</NamePrj><LblPrj>[PROJEKT_002]</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>83</DP><AwardInfo><Cur>EUR</Cur><CurLbl>Euro</CurLbl></AwardInfo><BoQ ID="id2"><BoQInfo><Name>01</Name><LblBoQ>Maschinentechnik - Anlagenbau</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Titel</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Bereich</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn><NoUPComps>4</NoUPComps><LblUPComp1 Type="Wages">Lohn</LblUPComp1><LblUPComp2 Type="Materials">Material</LblUPComp2><LblUPComp3 Type="Plant">Gerät</LblUPComp3><LblUPComp4 Type="Miscellaneous">Sonstiges</LblUPComp4><LblTime>Stunden</LblTime></BoQInfo><BoQBody><BoQCtgy ID="id185" RNoPart="01"><LblTx><p><span>Baustelleneinrichtung - Montagepläne - Inbetriebnahme</span></p></LblTx><BoQBody><BoQCtgy ID="id186" RNoPart="01"><LblTx><p><span>Baustelleneinrichtung und Dokumentation</span></p></LblTx><BoQBody><Itemlist><Item ID="id187" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vollständige Einrichtung der Baustelle, vorhalten und nach Ende der Baumaßnahme räumen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nach Massgabe aller angegebenen Leistungen, mit allen für den Baubetrieb und die maschinentechnische Montage erforderlichen Anlagen, Geräten und Maschinen, sowie Räumung derselben nach Beendigung der Baumaßnahme.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Kosten für das Vorhalten und den Betrieb o. g. Anlagen, Geräte und Maschinen sind in die betreffenden Einheitspreise einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sicherung der Baustelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gestellung von Bau- und Montagebeleuchtung und aller erforderlichen Hebezeuge, Montage- und Schutzgerüste</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit einer Arbeitsbühnenhöhe entsprechend den Erfordernissen sind einzukalkulieren. Der Auftragnehmer kann nicht davon ausgehen, dass Gerüste, Hebezeuge etc. von anderen auf der Baustelle tätigen Gewerken zur Verfügung stehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Transport- und Krankosten für Lieferung und Einbau aller Bauteile im Umfang dieses Leistungsverzeichnisses.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schützen von Behältern, Rohrleitungen, Aggregaten während der Bauzeit bis zur Inbetriebnahme, soweit nicht in anderen Positionen enthalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromanschluss und Baustellen-WC werden vom Gewerk Baumeisterarbeiten eingerichtet und zur Verwendung durch Folgegewerke bereitgestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Vorhandensein eines Wasseranschlusses für den Montagezeitraum kann zum jetzigen Zeitpunkt nicht garantiert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschl. Nebenkosten für Übernachtung,Verpflegung, Reisekosten, Wegegelder.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschl. Zwischentransport der Materialien auf der Baustelle zu den einzelnen Einbaustellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnungsmodus:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Prozentual nach Baufortschritt (also im Verhältnis der Summe der weiteren ausgeführten Leistungen zum Gesamtumfang der Leistungen).</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung und -räumung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id188" RNoPart="2"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrleitungs- und Instrumentenfließbild in der Anlagen- und Verfahrenstechnik (RI-Fließbild) auf Grundlage des Fließbildes Stand "Ausführungsplanung", das vom AG im pdf-Format und bei Bedarf im dwg-Format zur Verfügung gestellt wird.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Durch den Auftragnehmer muss spätestens 4 Wochen nach Auftragserteilung ein Schemaplan in Einstrichdarstellung über die Technische Ausrüstung des Wasserwerks im Umfang dieser Leistungsbeschreibung vorgelegt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Schema enthält folgende Informationen sämtlicher Anlagenteile:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Art und Bezeichnung der Apparate, Maschinen, Antriebe, und Behälter als Symbol,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrleitungen, Armaturen mit Nennweiten, Druckstufen, Werkstoffen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufgaben der Einrichtungen zum Messen, Steuern, Regeln</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusatzinformationen, wie z. B. Höhenlagen der Apparate, weitere Werkstoffe, sind anzugeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aus dem Schema muss die Funktionsweise der maschinellen, hydraulischen und lufttechnischen Ausrüstung der Anlage klar und übersichtlich erkennbar sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Allen im Schemaplan enthaltenen Betriebsmitteln (Symbolen) muss ein klarer Schlüssel (Kennzahl) zugeordnet werden, mit dessen Hilfe jedes Betriebsmittel eindeutig bestimmt und erkannt werden kann.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Schemaplan ist im dwg-Format zu erstellen. Der Plan muss sowohl in [PERSON_097] als auch als CAD-Datei (dwg-Format) und als pdf-Datei vorgelegt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vorlage in einfacher Ausfertigung.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrleitungs- und Instrumentierungsfließbild</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id189" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Übersicht über die gesamte Aufbereitungsanlage mit angeschlossenen Funktionseinheiten (wie Druckpumpwerk) ist nach Fertigstellung ein komplettes Fliessbild zu liefern, das alle Anlagenteile (Apparate, Rohrleitungen, Armaturen, Messgeräte etc.) unter Angabe von Nennweite, Druckstufe, [PERSON_094] und weiterer wichtiger technischer Daten sowie mit Angabe sämtlicher Kurzbezeichnungen enthält.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Plan ist auf Grundlage der Position "Rohrleitungs- und Instrumentierungsfließbild" in optisch hochwertiger Form mit "Präsentationscharakter" auf eine stabile Kunststoffplatte auflaminiert oder in einem optisch hochwertigen Glasbilderrahmen jeweils mit zwei Aufhängern für Wandaufhängung zu liefern. Werbung ist auf diesem Plan nur in Form der Logos von Auftraggeber, Planungsbüro und Auftragnehmer (ausführende Firma) erlaubt.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übersichts-Fließbild für Wandaufhängung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id190" RNoPart="4"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Auftragnehmer hat verbindlich zu den vertraglichen Einzelfristen sowie rechtzeitig vor Materialbestellung nachfolgend aufgeführte Unterlagen bei der Bauleitung zur Prüfung und Freigabe vorzulegen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anfertigen von Bau- und Montageplänen, Aussparungs-, Fundament- und Einbauzeichnungen und kompletten Installationsplänen, welche auch die größten Maße der Maschinen mit Zubehör enthalten müssen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nach diesen Plänen werden die erforderlichen Aussparungen etc. - soweit nicht im Umfang dieses Leistungsverzeichnisses enthalten - bauseitig hergestellt. Übersichtliche Darstellung in Ansichten, Schnitten und Detailzeichnungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschließlich Fertigungszeichnungen für Behälter und Sonderbauteile für den gesamten Leistungsumfang, hier insbesondere:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Filterkessel, Reinwassertanks, Druckstosskessel, lüftungstechnische Bauteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einzukalkulieren ist das mehrmalige Ausmessen der relevanten Bauwerks- und Anschlussmaße vor Ort.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschl. Fortschreibung zu Bestandsplänen mit allen wichtigen, festgestellten Maßen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Auftragnehmer haftet für die Richtigkeit seiner Zeichnungen sowie für die richtigen Angaben über Fundamente, Aussparungen, Durchbrüche, Schächte, Kanäle sowie Leerrohre für Kleinleitungen von Maschinen- und Elektroanlagen, für Meßeinrichtungen, usw.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pläne von allen Einbauteilen und maschinentechnischen Einrichtungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">anfertigen im Maßstab 1:50 oder größer, als CAD-Farbplott</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">und auf CD-ROM oder USB-Stick im DWG/DXF-Format sowie im pdf-Format.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rechtzeitiges Vorlegen der Montage-/Fertigungspläne Zug um Zug entsprechend dem geplanten Baufortschritt bzw. zu den vertraglich festgelegten Einzelfristen. Sie sind erst nach Genehmigung durch den Auftraggeber verbindlich.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschießlich Fertigung und Vorlage eines Bauzeitenplans mit detailliertem Bauablaufplan mit Angabe der wesentlichen Vorraussetzungen für die einzelnen Teilschritte. Regelmäßige Überarbeitung und Aktualisierung entsprechend dem Baufortschritt. Als Grundlage wird der Bauzeitenplan Stand Ausführungsplanung zur Verfügung gestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übergabe in einfacher Ausfertigung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung pauschal.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zeit-, Montage- und [PERSON_118]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id191" RNoPart="5"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die elektrische Schaltanlage wird als seperates Gewerk ausgeschrieben, so dass eine Kooperation mit dem Auftragnehmer E-Technik zwingend erforderlich ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dies umfasst folgenden Mindestumfang:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1. Technische Unterlagen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übergabe der technischen Unterlagen aller Aggregate / Messungen /Signalgeber / etc. mit Schnittstellen zur E-Technik und beinhaltet folgende Informationen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Energieanschluss (Anschlusswerte, wie Nennleistung, Anlaufart, Nennstrom sowie Vorgaben für Schutzeinrichtungen, z. B. Drehmomente, max. Ströme etc.)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerkontakte</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Messsignale, Messbereiche</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussbilder</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">alle sonstigen, die E-Technik betreffende Informationen.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Unterlagen müssen für jede(s) Aggregat / Messung als eigenständiges Papierdokument / pdf-Datei übergeben werden, und eine eindeutige Klartextbezeichnung, sowie einen Querverweis zur Position-Nr. im Maschinentechnik-LV und dem R&amp;I-Schema haben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Zusätzlich sind die Aggregate, Messungen, etc. übersichtlich in einer </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Betriebsmittelliste </span><span style="font-size:10pt;font-family:Arial;">zusammengestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sofern erforderlich, wird hierfür auch das Vefahrensschema für das Gewerk Elektrotechnik zur Verfügung gestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2. Funktonsbeschreibung Einzel-Aggregte / Messungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Übergabe einer detaillierten Funktionsbeschreibung aller Einzelaggregate / -Messungen / Signalgeber, etc. als "</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Pflichtenheft</span><span style="font-size:10pt;font-family:Arial;">" für die Programmerstellung (SPS-Programmierung).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3. Funktionsbeschreibung Gesamt-Anlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Übergabe einer detaillierten Funktionsbeschreibung der Gesamtanlage unter Zusammenwirken aller Aggregate / Messungen / Signalgeber / etc. als "</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Pflichtenheft</span><span style="font-size:10pt;font-family:Arial;">" für die Programmerstellung (SPS-Programmierung) sowie als [ORT_016] der Betriebsanleitung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Betriebsmittelliste ist nach Auftragserteilung zeitnah vorzulegen, um Bauteile mit langer Lieferfrist anhand der wesentlichen technischen Daten für die Bestellung freigeben zu können.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pflichtenheft und Übergabe elektrotechnische Unterlagen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id192" RNoPart="6"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überarbeitung und Ergänzung der im Rahmen der Maßnahme erstellten Fließbilder, Pläne, Anlagenbeschreibungen etc. in eine ausführliche und detailliert beschriebene und gezeichnete Bestandsdokumentation, Funktions- und Betriebsbeschreibung der gesamten maschinentechnischen Ausrüstung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">soweit nicht bereits in Pos. "Zeit-, Montage- und [PERSON_118]" enthalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung in dreifacher Ausfertigung als Loseblattsammlung, geheftet in Ordnern. Zusätzlich auf Datenträger in Windows-lesbaren Formaten (vorzugsweise "pdf-Dateien").</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Beschreibung muss die Anlage in ihrer Funktion, deren korrekte Bedienung und Wartung für den normalen Betrieb beschreiben. Für den Störungsfall sind Maßnahmen zur Beseitigung unmittelbarer Gefahr anzugeben, sowie die Wege zu zielbewusster Suche der Störungsursache und die Behebung einfacher Störungen zu erläutern. Die Funktionsbeschreibung ist spätestens zur Einweisung des Bedienpersonals in die Anlagenfunktion vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umfang und Ausführung wird nach Auftragsvergabe mit dem AG abgestimmt, auf Grundlage der Montageplanung und deren Fortschreibung zu Bestandsplänen sowie den im Zuge der Montageplanung erfolgten Abstimmungen, einschl. aller erforderlichen Pläne und Listen, zu liefern und bei  Einweisung des Betriebspersonals vor Abnahme der Anlage übergeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschl. der technischen Unterlagen aller Nebenaggregate, Armaturen, etc., TÜV-Protokolle, bakteriologische Nachweise.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einzurechnen sind:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Diesbezügliche Vorgespräche mit dem AG über Inhalt, Form und Zahl der zu liefernden Dokumente,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die eventuell erforderliche Vereinheitlichung der zu liefernden Dokumentationsunterlagen bei Arbeitsgemeinschaften oder Subunternehmerleistungen,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die Einweisung des Personals des AG in die Dokumentation</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung pauschal.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dokumentation mit Funktions- und Betriebsbeschreibung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id193" RNoPart="7"><Qty>200.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle verfahrenstechnischen Komponenten wie Apparate, Maschinen, Geräte, Armaturen und Rohrleitungen sind mit Kennzeichnungsschildern auszustatten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bezeichnungen der Apparate, Maschinen, Geräte, Armaturen und Rohrleitungen im Klartext (Art bzw. [PERSON_129], Baugröße und Funktion) und mit Kennzeichnungen gemäß R&amp;I-Fließbild nach DIN EN ISO 10628.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Schilder müssen gut sichtbar angebracht werden und weitestgehend UV-stabil, unempfindlich gegen Hitze und Kälte, beständig gegen Chemikalien und kratztest sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schilder einschließlich Halterung, Material Kunststoff, mit Nuten zum Einschieben der Beschriftung, schwarze Schrift auf weißem Grund, transparente Abdeckung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schildergröße: nicht kleiner als 10 x 5 cm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schriftgröße nicht kleiner als 7 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung nach Stück</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anlagenkennzeichnung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id194" RNoPart="8"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Änderungen von Montageplänen, Funktionsbeschreibungen, sonstige Dokumentation auf Grund AG-seitiger Veranlassung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Folgende Leistungen können nur abgerechnet werden, wenn der AG nach seiner Genehmigung der jeweiligen vom AN zu erbringenden Montageplanung, Dokumentation etc. Änderungen bzw. Ergänzungen derselben anordnet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sind Änderungen / Ergänzungen der Montageplanungsleistungen notwendig, weil erst nach deren Genehmigung (im Zuge der Ausführung) eine vom Auftragnehmer verschuldete fehlerhafte oder unvollständige Ausführung der Montagepläne zu Tage tritt, so gehen die Kosten für die Neuvorlage der Montageplanungsleistungen zu Lasten des Auftragnehmers.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Arbeiten zur turnusmäßigen Aktualisierung des vom AN zu erstellenden Bauzeitenplanes werden nicht separat vergütet.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Änderungen Fertigungszeichnungen, etc.</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id195" RNoPart="02"><LblTx><p><span>Inbetriebnahme, Nachweise und Wartung</span></p></LblTx><BoQBody><Itemlist><Item ID="id196" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fachgerechtes Desinfizieren und Nachspülen aller trinkwasserberührten Anlagenteile im Lieferumfang, einschl. Pumpen, Druckstosskessel, Filterbehälter und Reinwassertanks und sonstiger Aggregate und Armaturen, zur Inbetriebnahme mit Nachweisführung über Keimfreiheit durch ein zertifiziertes Labor.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erforderlich sind mindestens 3 Proben hintereinander mit negativen biologischen Befunden (Untersuchungsumfang Pseudomonas aeruginosa, [PERSON_160] Bakterien, Escherichia coli, Enterokokken, kultivierbare Mikroorganismen als Koloniezahl bei 22 °C und 36 °C).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Nachweisproben sind am Rohwasserzulauf und am Reinwasserausgang des Wasserwerks zu nehmen (also 3 Probennahmen an jeweils 2 Probenahmestellen).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Durchführung in mehreren Abschnitten entsprechend den Erfordernissen der Anlagenkonfiguration.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Abrechnung ggf. erforderlicher weiterer Desinfektionen erfolgt nach tatsächlichem Aufwand gegen Nachweis, jedoch nur soweit der Auftragnehmer die erneute Desinfektion nicht zu verantworten hat.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hinweis zur Behälterdesinfektion (Filter):</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Desinfektion des Filterbettes der Entarsenierungsfilter ist in einer eigenen Position im Abschnitt "Ausrüstung Arsenierungsfilter" behandelt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für die schadlose Beseitigung des Abwassers einschließlich ggf. erforderlicher Neutralisation ist ausschließlich der AN verantwortlich.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zu berücksichtigen ist, dass die Grundstücksentwässerung (Schmutzwasser) mittels Hebeanlage erfolgt, welche auf eine Fördermenge von ca. 8 m3/h ausgelegt ist. Die Entsorgung größerer Abwassermengen ist deshalb ggf. mit einem höheren Zeitaufwand verbunden, sofern keine Pufferbehälter zum Zwischenlagern von Abwasser vorgehalten werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für den Zeitraum der Desinfektion ist für die Kalkulation davon auszugehen, dass noch keine Armaturen elektrisch angeschlossen sind, d. h. entsprechender Zeitaufwand für Hand-Vor-Ort-Bedienung ist einzurechnen und wird nicht separat vergütet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Desinfektionsmittel z. B. [PERSON_065] od. gleichwertig.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Desinfektion der Gesamtanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id197" RNoPart="2"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme und Probebetrieb aller Aggregate (z. B. Aufbereitungsanlage, Druckerhöhungspumpen), Armaturen und sonstigen Funktionseinheiten dieses Leistungsverzeichnisses.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nach der Beendigung der Montage (hydraulisch/elektrisch) findet eine Begehung statt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Montageende ist schriftlich bei der Bauleitung anzuzeigen. Die Feststellung des Montageendes bezieht sich nur auf die optische Beurteilung. Dabei wird die Vollständigkeit des Lieferumfanges und der Ausführung geprüft.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nach erfolgreicher Feststellung, dass die Montage beendet ist, erfolgt die Inbetriebnahme, die schriftlich bei der Bauleitung anzuzeigen ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme und Montage liegen zeitlich getrennt voneinander. Die Inbetriebnahme kann erst nach Fertigstellung der elektrotechnischen Ausrüstung erfolgen. Die daraus entstehenden Kosten für die erneute Anreise des erf. Personals sind einschl. aller Nebenkosten, Auslösungen, Fahrtkosten etc. in die EP einzukalkulieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dabei werden folgende Prüfungen durchgeführt:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Druckprüfung der Gesamtanlage. DIN EN 805 / DIN 4279,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Prüfdruck entsprechend Anforderung PN 10 für alle Anlagenteile im Zulauf der Reinwassertanks / Prüfdruck PN 16 für alle Anlagenteile ab dem Reinwasser-Pumpwerk. Der Nachweis ist schriftlich zu dokumentieren.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überprüfung der Geräteaufstellung, Optimierung des Aufstellungsortes</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Probelauf bis der bestimmungsgemäße Betrieb aller Anlagenteile nachgewiesen ist.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Inbetriebnahme erfolgt zeitgleich mit dem AN-Elektrotechnik und gliedert sich in:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einzelinbetriebnahme für alle Aggregate / Messungen inkl. Einstellung und Justierung aller erforderlichen mechanischen und elektrischen Parameter.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme der gesamten Anlage in Verbindung des Zusammenwirkens aller Aggregate / Messungen / Signalgeber etc., inkl. Einstellung und Justierung aller erforderlichen mechanischen und elektrischen Parameter. Während der Inbetriebnahme ist das SPS-Programm zu optimieren.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dazu eigenständige Terminkoordination mit dem AN-Elektrotechnik.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nach erfolgter Inbetriebnahme wird ein Probebetrieb durchgeführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mit dem Probebetrieb ist eine intensive Betreuung des Betreiberpersonals (mindestens 1d/Woche) für die Dauer von 4 Wochen vorzusehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einzukalkulieren sind alle erforderlichen Messgeräte, Personal, Hilfsmittel und Reisekosten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es wird darauf hingewiesen, dass Unterbrechungen des Probebetriebs, die der AN zu vertreten hat, eine entsprechende Verlängerung dieses Probebetriebes zur Folge haben. Bei größeren Unterbrechungen wird der Probebetrieb abgebrochen und ist nach der Behebung der Probleme von vorne neu zu starten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Einfahr-/Optimierungsbetrieb veränderte Grundeinstellungen sind in einem Inbetriebnahmeprotokoll zu dokumentieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ziel während dieses Zeitraumes ist, den Personal- und Energieaufwand zu optimieren. Ferner ist die Automatisierung mit der Fernwirkanlage abzustimmen (Fehlermeldungen etc.).</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme und Probebetrieb</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id198" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Funktionsfähigkeit der Aufbereitungsanlage ist durch Probennahme nachzuweisen. Dazu sind folgende Analysen eines unabhängigen und zertifizierten Labors vorzulegen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Insgesamt 3 mal im Abstand von zwei Wochen bis zum Ende des Probebetriebs eine kleine chemisch-technische Analyse mit Mikrobiologie Rohwasser und Reinwasser (nach Aufbereitung)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Folgende Werte sind jeweils mindestens zu bestimmen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Temperatur und pH vor Ort</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Calcitlösekapazität</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arsen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trübung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">CO2</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sauerstoff</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Geruch</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Keimfreiheit ([PERSON_160] Bakterien, Escherichia coli, Enterokokken, kultivierbare Mikroorganismen als Koloniezahl bei 22 °C und 36 °C).</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Analytischer Nachweis Garantiewerte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id199" RNoPart="4"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übergabe der fertiggestellten Gesamtanlage an das Betriebspersonal mit Einweisung in Betrieb und Wartung aller Aggregate, wie Pumpen, Armaturen, Messgeräte, etc.,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">das letztendliche Ablaufschema,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die Schaltanlage mit Stromlaufplänen, soweit diese Gegenstand dieses LV sind,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die Störungsbehebung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Einweisung erfolgt zeitlich getrennt von Inbetriebnahme und Montage. Die daraus entstehenden Kosten für die erneute Anreise des erf. Personals sind einschl. aller Nebenkosten, Auslösungen, Fahrtkosten etc. in die EP einzukalkulieren.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einweisung des Betriebspersonals</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id200" RNoPart="5"><Qty>4.000</Qty><QU>Jahr</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wartungsvertrag für alle wartungsrelevanten Anlagenteile dieses Leistungsverzeichnisses für die Dauer der Gewährleistungszeit.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mit Abschluss des Wartungsvertrages verlängert sich der Zeitraum der Gewährleistung auf 4 Jahre.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Wartungsvertrag beinhaltet folgende jährlich durchzuführende Leistungen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1. Inspizieren der Anlage.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2. Warten der Anlage.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3. Liefern und Auswechseln der für die einwandfreie Funktion und Betriebssicherheit erforderlichen Verschleißteile der Anlage, deren Standzeit unter üblichen Betriebsbedingungen die Gewährleistungsfrist unterschreitet; einschl. ordnungsgemäße Entsorgung der Altteile und -materialien.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4. Liefern bzw. Bereitstellen aller benötigten Hilfsmittel (z.B.  Messgeräte, Werkzeuge) und Hilfsstoffe (z.B. Schmier- und Reinigungsmittel), inklusive Leitern und Fahrzeuge.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rechtzeitig vor Abnahme ist dem AG ein detaillierter Wartungsvertrag in [PERSON_097] vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der angebotene EP umfasst den Zeitraum zwischen Abnahme und Fristende Gewährleistung, also vier Jahre.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung außerhalb der Schlussrechnung, jeweils nach Ablauf eines Jahres.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Wartungsvertrag wird nach der Abnahme gemäß dem hier angebotenen Einheitspreis separat beauftragt.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wartungsvertrag</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id201" RNoPart="03"><LblTx><p><span>Stundenlohnarbeiten</span></p></LblTx><BoQBody><Itemlist><Remark ID="id202"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ZUSÄTZLICHE TECHNISCHE VERTRAGSBEDINGUNGEN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1) Stundenlohnarbeiten dürfen nur nach schriftlicher oder mündlicher Beauftragung durch die Bauleitung zur Ausführung kommen. Diese Vereinbarung hat vor der Ausführung der Arbeiten zu erfolgen. Die angefallenen Stunden müssen arbeitstäglich auf gesonderten Rapport- und Regieberichten zur Gegenzeichnung vorgelegt werden. Nicht unterzeichnete und nachgeschobene Regiestunden werden nachträglich nicht anerkannt und somit nicht vergütet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2) In den Stundenlohnverrechnungssätze sind alle lohngebundenen Unkosten, Zuschläge, Auslösen, Fahrgelder sowie die Beaufsichtigung und die Kosten für das gewerkeübliche Grundwerkzeug einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3) In den Verrechnungssätzen für Materialien, Maschinen und Abfallcontainer sind alle Unkosten für Transport, Lagerung und Aufschläge für Gemeinkosten usw. einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4) Die im Rahmen von Regierarbeiten anfallenden Stoffe und Geräteeinsätze sind auf den Rapportzetteln arbeitstäglich, zusammen mit den anfallenden Stunden der örtlichen Bauleitung zur Genehmigung und Gegenzeichnung vorzulegen. Nicht in dieser Form genehmigte Materialien und Geräteeinsätze werden nicht vergütet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">5) Die Abrechnung erfolgt im Rahmen der monatlichen Abschlagsrechnungen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzliche Technischen Vertragsbedingungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id203" RNoPart="1"><Qty>5.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ingenieur, Projektleiter</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vergütung erfolgt nur nach besonderer Anordnung der Bau-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">leitung. Angefallene Regiestunden müssen von der Bau-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">leitung täglich bestätigt werden, sonst erfolgt keine</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vergütung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sonst wie in den Zusätzlichen Technischen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertragsbedingungen beschrieben.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ingenieur, Projektleiter</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id204" RNoPart="2"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Polier oder Obermonteur in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Polier- oder Obermonteur</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id205" RNoPart="3"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">[PERSON_020] in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Facharbeiterstunde</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id206" RNoPart="4"><Qty>5.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauhelfer in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauhelfer bzw. Hilfsarbeiterstunden</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id207" RNoPart="5"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kleintransporter in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Fahrer,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kleintransporter Nutzlast 1,0 to mit Bedienung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id208" RNoPart="6"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schweißgerät in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Bedienung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schweißgerät Elektro mit Bedienung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id209" RNoPart="7"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schlagbohrer in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Bedienung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schlagbohrer 1500 Watt mit Bedienung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id210" RNoPart="8"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flex in Regie,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Bedienung,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sonst wie vor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flex 2000 Watt mit Bedienung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id211" RNoPart="9"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">An- un Abreise des Montagepersonals</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">An- un Abreise des Montagepersonals</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id212" RNoPart="10"><Qty>100.000</Qty><QU>kg</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Formstahl in [PERSON_115] V2A,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in verschiedenen Profilen, Größen und Abmessungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verarbeitung nach vorgegebenen Konstruktionsplänen bzw. Erfordernis, einschl. aller zugelassenen Befestigungen</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Formstahl</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy></BoQBody></BoQCtgy><BoQCtgy ID="id213" RNoPart="02"><LblTx><p><span>Demontagearbeiten</span></p></LblTx><BoQBody><BoQCtgy ID="id214" RNoPart="01"><LblTx><p><span>Demontage Rohrleitungen</span></p></LblTx><BoQBody><Itemlist><Item ID="id215" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Demontage, Ausbringen und Entsorgung der bestehenden Rohrleitungen, Armaturen und Formstücke inkl. Befestigungen und notwendiger Trennschnitte im Rohrkeller und Erdgeschoss der bestehenden Aufbereitungsanlage.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die demontierten Armaturen werden nach Möglichkeit wiederverwendet. Die Demontage und Wiedermontage dieser Armaturen ist im Abschnitt "Absperr- und Sicherheitseinrichtungen" separat berücksichtigt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Ausbau nicht mehr benötigter Wanddurchführungen von Rohrleitungen erfolgt im Gewerk Baumeisterarbeiten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Länge Rohrleitungen:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 100 und kleiner ca. 10 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 125 ca. 15 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 150 ca. 35 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 200 ca. 50 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrleitungen aus Stahlguss. Flanschverbindungen durchschnittlich alle 2 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrleitungsbefestigungen/-stützen aus Beton.werden bausseits nach der Rohrleitungsdemontage abgebrochen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausbringung über Treppe (siehe Pläne). Bezüglich Umgang und Zugänglichkeit ist die Baubeschreibung einschließlich der dort enthaltenen Fotos vom Altbestand zu beachten. Eine Vor-Ort-Besichtigung im Zuge der Angebotserstellung wird empfohlen. Hebezeuge und Montageöffnungen sind im Bestand nicht vorhanden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschließlich Gestellung der erforderlichen Container und Entsorgung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die saugseitige Edelstahlverrohrung von Reinwasserpumpwerk und Rückspülpumpe sowie die druckseitige Edelstahlverrohrung des Reinwasserpumpwerks bleiben erhalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Demontage, Ausbringen und Entsorgung der bestehenden Rohrleitungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id216" RNoPart="02"><LblTx><p><span>Ausbau Filermaterial und -einbauten</span></p></LblTx><BoQBody><Itemlist><Item ID="id217" RNoPart="1"><Qty>30.000</Qty><QU>m³</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die beiden offenen Dolomitfilter werden zu Entarsenierungsfiltern umgenutzt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das bisher eingebaute Filtermatierial aus halbgebranntem Dolomit ist auszubauen und zu entsorgen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Material mit Saugwagen absaugen und entsorgen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausbau und Entsorgung Filterfüllung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id218" RNoPart="2"><Qty>4.000</Qty><QU>m³</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausbau und Entsorgung der Stützschichten - vermutlich Quarzkies - aus den vorgenannten offenen Dolomitfiltern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Material mit Saugwagen absaugen und entsorgen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausbau und Entsorgung Stützschichten in Dolomitfilter</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id219" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bereitstellung der Container für die Entsorgung des abgesaugten Filtermaterials einschließlich Stützschichten,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Analyse jeder Charge nach Deponieversordnung / Deklarationsanalyse.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Entwässerungscontainer und Beprobung nach DepV</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy></BoQBody></BoQCtgy><BoQCtgy ID="id220" RNoPart="03"><LblTx><p><span>Aggregate und Maschinen</span></p></LblTx><BoQBody><BoQCtgy ID="id221" RNoPart="01"><LblTx><p><span>Pumpen</span></p></LblTx><BoQBody><Itemlist><Remark ID="id222"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Darstellung der Pumpen in den beiliegenden Plänen ist nur beispielhaft und kann von den nachstehenden Positionstexten abweichen. Mit dem Angebot sind in jedem Fall aussagekräftige Datenblätter (Kennlinie, Gesamt-Wirkungsgrad Pumpe im Betriebspunkt, Motordaten etc.) und Maßzeichnungen abzugeben. Gleiches gilt für Nebenangebote.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Bieter muss überprüfen und sicherstellen, dass die angebotenen Pumpen auf dem zur Verfügung stehenden Platz installiert werden können und dabei die Zugänglichkeit für Wartungsarbeiten gewährleistet ist sowie die notwendigen Beruhigungsstrecken vor/nach Armaturen und Messgeräten eingehalten werden. Die Leitungsführung darf insofern von der in den Planbeilagen dargestellten Leitungsführung abweichen. Nennweiten von Saug- und Druckleitungen und der darin installierten Armaturen dürfen jedoch nicht reduziert werden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Angebotsbedingungen Pumpen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id223" RNoPart="1"><Qty>4.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trockenläufer-Blockpumpe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einstufige [PERSON_054] in [PERSON_185]-Bauform für</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fundamentaufstellung inklusive Fuß am Pumpengehäuse.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schwingungs- und geräuscharme Blockbauart mit Laterne und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">starr verbundenem Standardmotor (Norm-Motor).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mit zwangsumfluteter, drehrichtungsunabhängiger Faltenbalg-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gleitringdichtung (ab 37 kW/4-polig optional mit einer Cartridge-Gleitringdichtung in Back-Pull-Out-System zum</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gleitringdichtungsaustausch ohne Demontage des Motors) und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">kavitationsreduzierendem Laufrad.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flansche mit Druckmessanschlüssen R 1/8. Alle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Graugusskomponenten sind kataphoresebeschichtet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpen mit Motoren &gt; 5,5 kW verfügen serienmäßig über</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kaltleiterfühler als Motorschutz.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Motorklemmkasten &lt; 7,5 kW kann aus Metall oder Kunststoff sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Motorklemmkästen &gt; 7,5 kW sind immer aus Metall.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Gleitringdichtung für die Wasserförderung bis Tmax. = +140°C.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpe geeignet für Betrieb an bauseitigem Frequenzumformer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Betriebsdaten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Fördermedium:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Trinkwasser</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Medientemperatur: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">10 bis 30,00 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Angefragter [PERSON_094]:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">60,00 m3 /h</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Angefragte Förderhöhe:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">6,30 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Min. Medientemperatur:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">5 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Max. Medientemperatur:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Min. Umgebungstemperatur: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">0 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Max. Umgebungstemperatur: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Maximaler Betriebsdruck:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">16 bar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mindesteffizienzindex (MEI): &gt; 0.4</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Motordaten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motor-Effizienzklasse:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">mind. IE3</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Netzanschluss:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">3~400V/50 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Spannungstoleranz:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">+-10 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motornennleistung:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1,5 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Nenndrehzahl:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1450 1/min</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Nennstrom:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">3,6 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Leistungsfaktor:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">0,71</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motorwirkungsgrad 50 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">81,3 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motorwirkungsgrad 75 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">83,4 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motorwirkungsgrad 100 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">84,6 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse: F</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart: IP55</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Motorschutz