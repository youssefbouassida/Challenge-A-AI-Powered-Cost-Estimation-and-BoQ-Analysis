                    <Qty>240.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Pilotbohrung 2</span>
                              <span style="background:#FFFFFF;"> Rohre PE DA 355.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einbringen der Pilotbohrung auf der geplanten Bohrachse entsprechend Lage und Höhenpläne,</span>
