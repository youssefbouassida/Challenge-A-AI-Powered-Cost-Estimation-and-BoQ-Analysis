                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zu der Position Kies- und Schottertragschicht für Feinplanum einschl.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Verdichtung im Bereich Straßen, Landwirtschaftlichen Wegen, Geh- und Radwegen und Seitenflächen EV 2 =&gt; 120 MN/m²  =  EVD =&gt; 65 MN/m², </span>
                            </p>
