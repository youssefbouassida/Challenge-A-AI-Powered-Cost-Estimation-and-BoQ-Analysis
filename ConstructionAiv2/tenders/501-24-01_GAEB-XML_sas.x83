                  <Item ID="GW_2007994" RNoPart="0016">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">jedoch reine Zulage zum allen Tiefbau und Rohrverlegeleistungen </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">beim Grabenaushub und Rohrverlegung DN 300 ZMU,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">für Erschwertes Arbeiten im Bereich eines Laub - Baumes mit </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">ca. 3,5 - 4,0 m Abstand zur</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">geplanten Leitungsachse bei ca. Station 1+058 wie folgt:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p>
                              <span style="background:#FFFFFF;">Baumdurchmesser 1 m über Boden ca. 40 - 50 cm,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Baumkrone bis ca. geplanter Leitungsgraben gewachsen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Baumhöhe geschätzt ca. 12 - 15 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Vorsichtiges Arbeiten generell beim Wasserleitungs- und </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Wegeaushub, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Handarbeit zur Freilegung von relevantem Wurzelwerk,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Vorsichtiges Verfüllen und Verdichten von geliefertem [PERSON_112],</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Vor Beginn der Arbeiten im Baumbereich, wird vorab die</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">beste Vorgehensweise nochmals mit den Zuständigen besprochen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ein teilweises Zurückschneiden der herunterhängenden Äste (Lichtraumprofil für die Baumaschinen) wird in diesem Zusammenhang ebenfalls festgelegt.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Das Zurückschneiden wird gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Der AG legt höchsten Wert auf den Erhalt dieses Baumes!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2030724" RNoPart="0017">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">jedoch reine Zulage zum allen Tiefbau und Rohrverlegeleistungen </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">beim Grabenaushub und Abbruch alter Schacht Neuverlegung Rohr PE 63</span>
                            </p>
                            <p style="text-align:justify;">
