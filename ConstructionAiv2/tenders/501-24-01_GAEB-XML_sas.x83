                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zu den Positionen Wasserleitungsschächte für</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Rohr- und Armaturenunterstützungen </span>
                              <span style="background:#FFFFFF;">bis ca. 250 kg</span>
                            </p>
