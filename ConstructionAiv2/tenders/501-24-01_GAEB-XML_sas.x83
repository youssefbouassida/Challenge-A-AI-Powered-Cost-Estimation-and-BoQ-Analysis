                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Sickermulde Maße nach [PERSON_125] des AN, angepasst an die örtlichen Verhältnisse</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">beim Mutterbodenabtrag und seitlichen Lagerflächen für [PERSON_093].</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Sickermulden müssen lagemäßig in den Baufeldern der Wasserleitungstrasse hergestellt und wieder verfüllt werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bei Bedarf sind dort Sedimentations- bzw. Absetzbecken (als Erdbecken) </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit vor zusehen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ein oberflächliches Ableiten des abgepumpten Grundwassers in Wiesenflächen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ist nicht gestattet!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Sickermulde Maße nach [PERSON_125] des AN, angepasst an die örtlichen Verhältnisse</span>
