                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2008279" RNoPart="05">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Notversorgungen Hausanschlüsse </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2008280">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis für die folgenden Positionen Notversorgungen Hausanschlüsse</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Diese Leistungen sind im wesentlichen für Aus, - und Wiedereinbau</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von Notversorgungen von vorhandenen Wasserleitungshausanschlüssen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">im Zuge der Gesamtmaßnahme Wasserleitungsverlegung. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Eine reibungslose Koordination mit der Tiefbaukolonne ist</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">zwingend notwendig.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Unstimmigkeiten sind intern zu klären und dürfen nicht zu Lasten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">des AG gehen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Vor Ausführung der Arbeiten ist in jedem Fall der zuständige</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Wassermeister Herr [PERSON_104] zu informieren und der Ablauf </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">mit ihm abzustimmen!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008281" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Notleitungen (Notversorgung) mit PE - Rohren DN 32 - 40 aufbauen, </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">unterhalten, </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">sichern und nach Abschluss der Maßnahme wieder beseitigen. </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Die Verbindungen und Anschlüsse sind mit komplettem Anschlussmaterial (Fittings, Abzweige u.a.) zu kalkulieren.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Ausführung für den Wasserleitungshausanschluss [PERSON_062]. 19.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="font-weight:bold;background:#FFFFFF;">Aus hygienischen Gründen sind neue Leitungen zu verwenden.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Das Abstellen der bestehenden Hausanschlussleitung und Abstimmung mit dem Hausbewohner einschl. rechtzeitiger Bekanntgabe der Betroffenen </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">ist hier mit einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Es ist sicherzustellen, dass die Anschlussnehmer ständig mit [PERSON_029] versorgt werden.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Notleitungen sind für 1 Gebäude herzustellen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Anschluss am bestehenden [PERSON_006] DZ NZ Isnyberg 401.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Anschlusslänge für das Haus bis ca. 150 m </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt 1 x pauschal.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Erforderliche Überdeckungsarbeiten erfolgen durch die Tiefbaufirma (Überfahrten, Zufahrten u.a.). </span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Notleitungen (Notversorgung) mit PE - Rohren DN 32 - 40 aufbauen, </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008282" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Nach Abbau der Notversorgungen/Überleitungen und wieder Inbetriebnahme</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">der örtlichen Wasserversorgungsleitung,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">ausbauen, reinigen und wieder einbauen der Siebeinlage an den                       </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Hausanschlussleitungen der jeweiligen Häuser.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung nach Bedarf.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Nach Abbau der Notversorgungen/Überleitungen und wieder Inbetriebnahme</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2008575" RNoPart="06">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Dichtigkeitsprüfung und Desinfektion</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2008576" RNoPart="0001">
                    <Qty>425.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2025-04</VersDate>
                          <WCtg>043</WCtg>
                          <Group>1057</Group>
                        </STLBBauCtlg>
                        <STLBBauID>
                          <ArtChrIdent>-484</ArtChrIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2136</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>2</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2770</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>112</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5603</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>121</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5606</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>6611</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>31</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>6645</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>4</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>9945</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>46</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text>
                            <span style="background:#FFFFFF;">Druckrohrleitung vor Inbetriebnahme spülen, desinfizieren DVGW W 291, für Trinkwasser, aus PE, mit [PERSON_029], Entkeimungsmittel Wasserstoffperoxid, einschl. Desinfektionsmittel, DN 355, Ausführung gemäß Einzelbeschreibung,</span>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Einzelbeschreibungs-Nr </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Ausführung im Bereich der 2 Spühlbohrungen mit den jeweiligen Übergängen auf die GGG DN 300 ZMU Rohre).'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;">.</span>
                            </ComplTail>
                          </TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckrohr spülen desinfizieren TW [PERSON_029] Wasserstoffperoxid Desinfektionsm. DN355</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008577" RNoPart="0002">
                    <Qty>655.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Druckrohr aus duktilem Gusseisen, innen zementiert </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">DN 300 PN 16, für Trinkwasser, desinfizieren</span>
                              <span style="font-weight:bold;background:#FFFFFF;">. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Druckrohrleitung DN 300 vor Inbetriebnahme mit [PERSON_029] und mit Wasserstoffperoxid – Desinfektionsmittel, nach DVGW  W 291 (jedoch unter Absprache mit dem AG, abschnittsweise (ca. 2-3 Abschnitte),</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">bzw. nach Abstimmung mit der örtlichen Bauleitung und dem AG) dosiert zu befüllen. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Desinfektionslösung  hat in der Rohrleitung für eine Zeit von 24 Stunden zu verbleiben. Enthalten sind die erforderlichen Arbeitszeiten sowie die Gestellung aller erforderlichen Geräte, Formstücke, Armaturen und Standrohre für die Rohrleitung, innen zementiert, DN 300. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Das notwendige Trinkwasser wird vom AG beigestellt und ist  durch den AN zu beseitigen. Der Nachweis der erfolgreichen Desinfektion ist zu erbringen und schriftlich mitzuteilen.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckrohr aus duktilem Gusseisen, innen zementiert </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008578" RNoPart="0003">
                    <Qty>655.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Druckrohr aus duktilem Gusseisen, innen zementiert </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">DN 300 PN 16, für Trinkwasser, spülen</span>
                              <span style="font-weight:bold;background:#FFFFFF;">. </span>
                              <span style="background:#FFFFFF;">                                   </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Leitung DN 300 GGG spülen - nur mit Trinkwasser, Behelfszuleitungen vor Gebrauch spülen, Spülgeschwindigkeit in der Leitung mindestens 0,6 m/s, Spülmenge 3 bis 6 facher Rohrinhalt. Wasserzähler dürfen nicht durchgespült werden. Wasserentnahme aus in Betrieb befindlichen Anlagen nur im Einvernehmen mit dem AG. Das Spülwasser darf nicht in im Betrieb befindliche Teile der Wasserversorgungsanlagen gelangen. Das Spülwasser aus der gespülten Leitung ist schadlos abzuleiten.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Für die Spülung wird das [PERSON_029] kostenlos vom AG zur Verfügung gestellt. Das Heranbringen des [PERSON_029]s für die Spülung ist in Abstimmung mit der örtlichen Bauüberwachung und dem AG vorzunehmen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Druckrohrleitung vor Inbetriebnahme spülen, für Trinkwasser, DN 300, abschnittsweise bzw. nach Abstimmung mit der örtlichen Bauleitung und dem AG, einschl. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Lieferung, der Ein- und Ausbau aller für Spülen erforderlicher Formstücke und Armaturen ist mit einzukalkulieren. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Alle sicherheitsrelevanten Arbeiten haben unter dem Gesichtspunkt der Gefahrenanalyse nach DVGW Richtlinien zu erfolgen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Das Spülen von [ORT_031] für Trinkwasser erfolgt nach DIN 2000, DIN 19360 und dem DVGW - Arbeitsblatt  W 291.  Das Spülwasser wird vom AG beigestellt und ist  durch den AN zu beseitigen. Fachgerechtes Spülen nach W 291 bzw. W 346 zur Entfernung unbeabsichtigt eingetragenen Fremdstoffen und Hilfsmitteln.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Durchführung der Spülung ist 1 Woche vor Durchführung schriftlich anzumelden und mit der örtlichen Bauüberwachung und dem AG abzustimmen. Die Spülung ist zu dokumentieren und der Nachweis ist dem AG schriftlich mitzuteilen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung in ca. 2 - 3  Abschnitten.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckrohr aus duktilem Gusseisen, innen zementiert </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008585">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Hinweis: Druckprüfungen PE - Rohre DN/OD 355 und GGG DN 300 ZMU</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die nachfolgenden Positionen Druckprüfungen sind nach DIN EN 805 ausgeschrieben.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">In Anlehnung an diese DIN EN 805 gelten auch die Angaben aus der DVGW</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">W 400 - 2 (2022).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Vor Ausführung einer Druckprüfung wird der zulässige Prüfdruck, sowie die Ausführungsart in Abhängigkeit des Rohrmaterials, unter Berücksichtigung der jeweiligen Tiefenlage gemeinsam durch den AG und AN festgelegt.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">In Abhängigkeit vom Bauablauf können Teilstrecken gesondert, oder zusammenhängend als Gesamtdruckprüfung durchgeführt werden.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Der jeweilige max. zulässige Prüfdruck für Guss- und PE - Rohre darf nicht überschritten werden. </span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008586" RNoPart="0004">
                    <Qty>425.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2025-04</VersDate>
                          <WCtg>043</WCtg>
                          <Group>1055</Group>
                        </STLBBauCtlg>
                        <STLBBauID>
                          <ArtChrIdent>-484</ArtChrIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2136</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>2</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3114</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>14</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5603</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>121</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5606</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>4</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5616</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>5</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>5664</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>29</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>6611</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>36</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>7583</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>8</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10852</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>16</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>20250</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>10</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>20783</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>0</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text>
                            <span style="background:#FFFFFF;">Druckprüfung DIN EN 805, als Vorprüfung, Druckabfallprüfung und Hauptdruckprüfung nach dem Wasserverlustverfahren, an [ORT_031] aus PE, für [PERSON_029], Nenndruck 1,6 MPa (16 bar), DN/OD 355,</span>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="20783">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">max. Rohrleitungslänge </span>
                            </ComplCaption>
                            <ComplBodyDec Value="430"/>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'430'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;"> m, [PERSON_029] wird beigestellt und ist abzuleiten. Ausführung gemäß Einzelbeschreibung,</span>
                            </ComplTail>
                          </TextComplement>
                          <Text>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="12" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Einzelbeschreibungs-Nr </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Ausführung in 1-2 Abschnitten im Bereich der  2 Spühlbohrungen. </span>
                              <br/>
                              <span style="background:#FFFFFF;">Ausführungsart PE Rohre mit Kontraktionsprüfung!'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;">.</span>
                            </ComplTail>
                          </TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckprüfung Wasserverlustverfahren Druckrohr [PERSON_029] DN/OD355 maxRohr-L 430 m [PERSON_029] beigestellt ableiten</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008587" RNoPart="0005">
                    <Qty>655.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2025-04</VersDate>
