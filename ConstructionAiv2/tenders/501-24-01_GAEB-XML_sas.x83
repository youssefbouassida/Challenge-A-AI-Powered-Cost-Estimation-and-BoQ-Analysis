                  <Item ID="GW_2008569" RNoPart="0014">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Membrangesteuertes 3 - Wege Be- und Entlüftungsventil</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">für Trinkwasser PN 16 wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Anschluss Flansch DN80</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">D-070-DN80-PN16</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Sanftschließendes Membran-3-Wege Be- und Entlüftungsventil für Trinkwasser </span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">und klare Medien vergleichbarer Dichte.</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">DVGW-Cert. (NW-6215 BS0200) inkl. W270 + KTW</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">ÖVGW-Cert. (W 1.436), SVGW-Cert. ([TELEFON_078]) </span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Prozessanschluss: Flansch DN80, Zu-/Abluftanschluss mit 3“ IG</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Druckstufe: PN 16 (Arbeitsdruck: 0,2 - 16 Bar)</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Große Düse: 5.153 mm², Kleine Düse:  8 mm²</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Gehäusewerkstoff: Duktilguss (GGG) mit hochwertiger Epoxid-Beschichtung (EKB)</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Spüladapter aus [PERSON_115] für Funktionskontrolle und Spülen über den großen</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Düsenquerschnitt, unter Betriebsdruck.</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Dichtungswerkstoffe: EPDM + NBR</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bauhöhe: 290 mm, Gewicht: 14 kg</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Zubehör: - Ansaug- Siebeinsatz selbsttätige Ansaugsperre bei Überflutung.</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ventilationskamin mit herausnehmbarem [PERSON_088] aus [PERSON_115] s. gesonderte Zulageposition!</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129]: D - 070</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hersteller: [FIRMA_074]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                 [ADRESSE_021], D - [ORT_012]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                 Fon [TELEFON_050]</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Membrangesteuertes 3 - Wege Be- und Entlüftungsventil</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008131" RNoPart="0015">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage</span>
                              <span style="background:#FFFFFF;"> zur Position  Membrangesteuertes 3 - Wege Be- und Entlüftungsventil </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">D - 070 AIRVALVE für:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ventilationskamin aus [PERSON_115] mit mindestens 18385 mm2 Stömungsquerschnitt und Insektenschutz (DA 160 mm) bestehend aus:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Kaminrohr mit oberem 180° Bogen und zwei seitlichen Fundamentankern nach [PERSON_125] des AN (Gesamt-Bauhöhe ca. 1600 mm (davon ca. 1000 mm [PERSON_115] und ca. 600 mm PVC - U Rohr DA 160 mm).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 x Übergang von [PERSON_115] auf PVC - Rohr,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ca. 3 Bögen PVC DA 160 mm in Lage und 1 Bogen 87° vertikal,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ca. 3,0 lfm PVC - Rohr DA 160 mm mit Kleinlängen, einschl. Muffen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_088] aus [PERSON_115] mit 0,8 mm Maschenweite, abgestimmt auf die Luftleistung des Be - Und Entlüftungsventils.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position  Membrangesteuertes 3 - Wege Be- und Entlüftungsventil </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2031315" RNoPart="0016">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Position vor Be- und Entlüftungskamin DN 160</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für alle dazu erforderlichen [ORT_030] wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Graben für PVC - Leitung DA 160 und Kamin aus [PERSON_115] auf einer Länge</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von ca. 4 m herstellen, Wiederverfüllen und Verdichten.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Grabenbreite 0,80 m, Grabentiefe ab Gel- OK bis 1,25 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Sand für Rohre DA 160 liefern und rundum 10 cm stark als Rohrumhüllung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einbauen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Verdrängtes Material im Baufeld einbauen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Eventuelle Kieslieferungen und dadurch verdrängtes Material beseitigen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">werden gesondert vergütet. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Anschluss an Betonbauwerk d = ca. 15 cm für Rohr DN 160 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mittels Kernlochbohrung und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">wasserdichter Wanddurchführung komplett herstellen.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position vor Be- und Entlüftungskamin DN 160</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008573" RNoPart="0017">
                    <Qty>5.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Absperrschieber als Keil - Flach - [PERSON_017] Baulänge Grundreihe 14,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nach DIN EN 558-1, weich dichtend, mit innenliegendem Spindelgewinde, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">geeignet für Handbetätigung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Armatur mit Innen- und Außenschutz durch Epoxidpulverbeschichtung, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Nenndruck 1,6 MPa (16 bar), </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DN 80, für Druckrohrleitung für Trinkwasser, nicht erdverlegt, </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Material:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Gehäuse: GJS - 400, [FIRMA_067] - Epoxy - Pulverbeschichtung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Spindel: nichtrostender [PERSON_089],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- [PERSON_155]: [PERSON_176],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Keil: GJS - 400, innen und außen EPDM gemäß DVGW W 270 für [PERSON_029],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Dichtungen: EPDM gemäß DVGW W 270 für [PERSON_029],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- E 3 - Kantenschutz</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Keil - Flach - [PERSON_017] mit beidseitigem Flansch nach EN 1092 - 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung als Kurzbauschieber,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einschl. passendes Handrad zur Betätigung.</span>
                            </p>
