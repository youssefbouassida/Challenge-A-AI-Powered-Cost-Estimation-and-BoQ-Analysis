                  <Item ID="GW_2008390" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Montagearbeiten des Mess-Sensors </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">AQUALINK, oder gleichwertig</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">auf die bestehenden Trinkwasserleitung, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">im Gebäude und oder Schachtbauwerk</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">inkl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einbau der AQUALINK- Mess-Sonde für </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Durchfluss, Durchflussrichtung, Druck und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Temperatur inkl. Inbetriebnahme, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einstellung und Justierung, Einweisung und </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abnahme mit dem Betreiber-Personal vor Ort</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit Protokollierung.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Inkl. Abnahme-Protokoll und Betriebsanleitung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">An- und Abfahrt des Fachpersonals durch den</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hersteller.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Montagearbeiten des Mess-Sensors </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008391" RNoPart="0002">
                    <Qty>2.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Multisensorik für die Messung mehrerer Parameter in </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Trinkwasserleitungen mittels </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Durchflusssensor mit integrierten Druck und Temperatur-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sensoren, ab DN 80 bis DN 600 PN 16</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in [PERSON_115]-Ausführung für das </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Anschlussgewinde DN 40 11/2 Zoll</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für die Installation in Gebäude und Schachtbauwerke,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">zur permanenten Messung von Druck, Temperatur, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Durchfluss und Durchflussrichtung</span>
                            </p>
