                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">jedoch </span>
                              <span style="font-weight:bold;background:#FFFFFF;">reine Zulage</span>
                              <span style="background:#FFFFFF;"> zum Grabenaushub geböscht 45 ° bis ca. 2,00 m Tiefe, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Untere Breite ca. 0,56 m,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">für senkrechten Mehraushub b = ca. 0,56 m,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">bei erforderlicher Untergrundverbesserung.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Mehraushubtiefe bis ca. 30 cm.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung erst nach ausdrücklicher Rücksprache mir der Bauleitung des AG!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
