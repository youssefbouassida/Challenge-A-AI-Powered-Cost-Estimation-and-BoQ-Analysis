                  <Item ID="GW_2030602" RNoPart="0006">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Erdaushub geböscht für neuen [PERSON_006] DN 1200</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">EZNZ Isnyberg 402 Hausanschlussschacht WWg 19 wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Aushub geböscht, lagemäßig zu bisher bestehendem Schacht ca. 1,50 m</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Richtung Straßenmitte versetzt.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(Bestehenden Schacht freilegen, abbrechen und beseitigen wird gesondert </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vergütet).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aushubtiefe bis ca. 2,0 m für komplettes Schachbauwerk einschl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Zu- und Ableitungen, einschl. Zwischenplanum für PE Rohre DA 63 und </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DA 40-50 gesamt ca. 4-5 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Sand mind. 10 cm rundum PE - Leitungen liefern und einbringen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(PE - Rohre werden gesondert vergütet).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wiederverwendbares [PERSON_093] aus Straßenkoffer wieder einbauen und verdichten, nicht wieder verwendbares Material einschl. Schachtverdrängung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">abfahren und beseitigen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Eventuell erforderliche Untergrundverbesserung und Kiesverfüllung mit [PERSON_182] 0/X, sowie Straßenwiederherstellung mit Frostschutzkies 0/45 werden einschl. Abfuhr verdrängtes Material aus Kieslieferung über Lieferscheinnachweis und Massenbilanz gesondert vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Erdaushub geböscht für neuen [PERSON_006] DN 1200</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2013465" RNoPart="0007">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_006] DN 2500</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Schachttiefe im Lichten 1,70 m von UK Abdeckplatte bis OK Schachtboden,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">zuzüglich weiteren 0,40 - 0,45 m (Abdeckplatte und Schachtboden) ergibt</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">eine Gesamthöhe Schacht von ca. 2,10 - 2,15 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung Schachtunterteil einschl. Wände monolithisch,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abdeckplatte separat (Versetzen erst nach Fertigstellung der Inneninstallation ist einzukalkulieren),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN EN 1917, DIN 4034 - 1, [PERSON_129] 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">FBS-Qualität oder vergleichbar,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schachtbauwerk in kompletter wasserdichter Ausführung wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Unterteil mit Kellersinkkasten und Rückstauverschluss DN 110,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtwände h = 1,70 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 2 Schachtdurchführungen für Hauptleitung GGG DN 300 einschl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  erforderlichen Ringraumdichtungen, Gas- und Druckwasserdicht!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Abdeckplatte mit Öffnung DN 800 mm, exzentrisch, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Betonkragen b = 20 cm, h = 20 cm werkseitig oder örtlich nach [PERSON_125] des AN,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   wasserdicht auf Betondeckenplatte herstellen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 Auflagerring DN 800 mm mit Schubsicherung,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtabdeckung für Wasserleitungen </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> l.W. 800 mm </span>
                              <span style="background:#FFFFFF;">s. gesonderte Position,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  </span>
                              <span style="font-weight:bold;background:#FFFFFF;">wird gesondert vergütet. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Festpunkte zur Fixierung der Wasserleitung im Schacht,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Edelstahlstützen und Einstiegsleiter werden gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">einschl. kompletter Auftriebssicherung </span>
                              <span style="background:#FFFFFF;">gegen anstehendes Grund- und </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_149] nach [PERSON_125] des AN örtlich oder werksseitig herstellen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hydrantenschacht komplett wasserdicht herstellen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung s. auch Zeichnung!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Be- und Entlüftungsschacht am Hochpunkt bei ca. Station 0+370.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
