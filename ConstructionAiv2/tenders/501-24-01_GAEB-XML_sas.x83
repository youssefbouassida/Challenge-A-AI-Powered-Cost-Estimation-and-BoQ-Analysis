                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>20783</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>0</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text>
                            <span style="background:#FFFFFF;">Druckprüfung DIN EN 805, als Vorprüfung, Druckabfallprüfung und Hauptdruckprüfung nach dem Wasserverlustverfahren, an [ORT_031] aus duktilem Gusseisen, für [PERSON_029], Nenndruck 1,6 MPa (16 bar), DN 300,</span>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="20783">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">max. Rohrleitungslänge </span>
                            </ComplCaption>
                            <ComplBodyDec Value="700"/>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'700'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;"> m, [PERSON_029] wird beigestellt und ist abzuleiten. Ausführung gemäß Einzelbeschreibung,</span>
                            </ComplTail>
                          </TextComplement>
                          <Text>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="12" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Einzelbeschreibungs-Nr </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Ausführung in ca. 2 Teilabschnitten.'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;">.</span>
                            </ComplTail>
                          </TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckprüfung Wasserverlustverfahren Druckrohr [PERSON_029] DN300 maxRohr-L 700 m [PERSON_029] beigestellt ableiten</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008588" RNoPart="0006">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zu den Positionen Druckprüfung für:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage zur Gussrohrverlegung und Hauptdruckprüfung DN 300</span>
                              <span style="background:#FFFFFF;"> für die Durchführung einer laufenden Druckprüfung zur verbesserten Sicherheit und Risikominimierung von Leckagen, mittels einem öl-, [PERSON_029]-, und pollenfreien Druckluftkompressors, für Trinkwasser zugelassen, zur Überprüfung jeder Rohrverbindung im Rohrstrang während der Erstellung der Gussrohrleitung DN 300 </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">inkl. aller Geräte, Maschinen, erhöhtem Personaleinsatz und Zubehör und Berücksichtigung des erhöhten Zeitaufwands aller Arbeitssicherheitsrichtlinien inkl. Wartezeiten zur Durchführung der laufenden Druckprüfung (in Absprache mit der örtlichen Bauüberwachung und dem AG) nach DVGW Richtlinie G 469 mit maximal 1,5bar Druck.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Festgestellte mögliche Leckagen sind zu orten und sofort zu auf Kosten des AN zu beseitigen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Alle sicherheitsrelevanten Arbeiten haben unter dem Gesichtspunkt der Gefahrenanalyse nach DVGW Richtlinien zu erfolgen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Gesamtlänge ca. 655 m in 2 räumlich getrennten Bereichen.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zu den Positionen Druckprüfung für:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008590">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis zur Trinkwasseruntersuchung:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Zusätzlich zu den Trinkwasseruntersuchungen an der neu zu verlegenden</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wasserleitung (in mehreren Teilabschnitten wie Druckprüfungen),  werden folgende Leistungen durchgeführt:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Vor Beginn der Wasserleitungsarbeiten wird in Absprache mit dem zuständigen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wassermeister Herrn [PERSON_104] am vorhandenen Wasserleitungsnetz zum Abgleich, eine Trinkwasserprobe entnommen und ausgewertet.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis zur Trinkwasseruntersuchung:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008290" RNoPart="0007">
                    <Qty>5.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Mikrobiologische Trinkwasseruntersuchung nach der Trinkwasserverordnung V, Anlage 1,2,5 </span>
                              <span style="font-weight:bold;background:#FFFFFF;">(E-Coli, [PERSON_160], Aeromonas, Kolonienzahl,  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">vergütet werden nur bestandene Untersuchungen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einschl. Probenahmen und Gebühren für die Analysen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Entnahmestellen sind zu dokumentieren. Die Wasseranalysen erfolgen</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">gem. Trinkwasserverordnung, DIN EN 805 und dem </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">DVGW - Arbeitsblatt W 291.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Das Prüfprotokoll ist in 3 - facher Ausführung zu erstellen und unaufgefordert zu übergeben.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Voraussetzungen der Trinkwasseruntersuchung:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Nach der Desinfektion ist die Wasserleitung mit Trinkwasser durchzuspülen,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">bis das Desinfektionsmittel nicht mehr nachweisbar ist. Vorher darf mit der</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Probenahme für die Trinkwasseruntersuchung nicht begonnen werden.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Hinweis: Die Inbetriebnahme der Leitung erfolgt erst, wenn die Untersuchung</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">               keine Coli - Organismen anzeigt und erst nach Rücksprache und </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">               Genehmigung durch den AG!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Mikrobiologische Trinkwasseruntersuchung nach der Trinkwasserverordnung V, Anlage 1,2,5 (E-Coli, [PERSON_160], Aeromonas, Kolonienzahl,  </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008291" RNoPart="0008">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Inbetriebnahme, Funktionsprüfung und Abnahme</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Inbetriebnahme für das gesamte Gewerk</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ist von dem AN komplett zu koordinieren,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Inbetriebnahme und die Funktionsprüfungen sind in Anwesenheit des AN, AG</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">unter Berücksichtigung des Gesamtterminplanes durchzuführen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Funktionsprüfung hat vor der Inbetriebnahme stattzufinden. Die Prüfung ist</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vom AN zu protokollieren und das Protokoll dem Auftraggeber bzw. dessen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Vertreter vorzulegen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Es ist davon auszugehen, dass die Anlagen stufenweise in Betrieb genommen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">werden müssen. Kosten für Teilinbetriebnahmen nach Baufortschritt soweit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nicht separat ausgeschrieben sind einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Sind mehrmalige Inbetriebnahmen aus Gründen die der Bauherr nicht zu vertreten hat erforderlich, werden diese Kosten entsprechend dem Verursacherprinzip</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">weitergegeben.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Inbetriebnahme, Funktionsprüfung und Abnahme</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="GW_2008292" RNoPart="04">
          <LblTx>
            <p>
              <span style="background:#FFFFFF;">TIEFBAU UND ROHRE WASSERLEITUNG IN GESCHLOSSENER</span>
            </p>
            <p>
              <span style="background:#FFFFFF;">BAUWEISE SPÜLBOHRUNGEN</span>
            </p>
          </LblTx>
          <NotApplBoQ>No</NotApplBoQ>
          <BoQBody>
            <BoQCtgy ID="GW_2008293" RNoPart="01">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Baustelleneinrichtung Spülbohrungen</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2008294">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis für die nachfolgenden Positionen</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Baustelleneinrichtung und Verkehrssicherung</span>
                            </p>
                            <p style="text-align:justify;">
                              <br/>
                              <span style="background:#FFFFFF;">Der Kalkulator hat für diese Positionen, die Baubeschreibung, die besonderen Vertragsbedingungen und die Ausführungsplanung als Kalkulationsgrundlage zu beachten.</span>
                            </p>
                            <p style="text-align:justify;">
                              <br/>
                              <span style="background:#FFFFFF;">Die Maßnahme wird mit 2 aneinanderliegenden </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Spülbohrungen 1 und 2 ausgeführt.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Ausführungsbereich der Spülbohrung 1 beinhaltet die Unterquerung eines Waldweges (Ziehweg, Zugweg für Holztransporte))</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung erfolgt in 1 Gesamtabschnitt von Station 0+580 bis 0+745,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">L = ca. 165 m.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Ausführungsbereich der Spülbohrung 2 beinhaltet die Unterquerung </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">eines darauffolgenden Waldverbindungsweges (Kiesweg) direkt am Anschluss an die Spülbohrung 1 von Station 0+745 bis 0+990,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung erfolgt in 1 Gesamtabschnitt, L = ca. 245 m.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Arbeiten befinden fast ausschließlich im Waldbereich.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Absperrungen und Absicherungen der Bautätigkeit, werden überwiegend für</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">die Absicherung direkt am Einsatzort benötigt.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Start- und Zielgruben befinden sich in den vorgenannten Zieh- und Waldverbindungswegen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Eine gemeinsame Zufahrtsmöglichkeit zu beiden Spülbohrungen befindet sich von der [ADRESSE_018] bis Station 0+745 ca. 600 - 700 m, sowie vom Ortsende Burg bis Station 0+745 ca. 1600 - 1700 m.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Waldwege sind überwiegend über eine Kiesschicht befahrbar und ca. 2,50 bis 3,00 m breit. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Grundposition Baustelleneinrichtung ist für die gesamten Spülbohrarbeiten,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">das heißt für die Spülbohrungen 1 und 2 zu kalkulieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Für die BE der Spülbohranlage selber, sind jeweils 2 gesonderte Positionen ausgeschrieben.</span>
                            </p>
                            <p style="text-align:justify;"/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis für die nachfolgenden Positionen</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008295" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Einrichten und Räumen der Baustelle</span>
                              <span style="background:#FFFFFF;"> für Spülbohrarbeiten PE DA = 355 mm</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Position beinhaltet Einrichten und Räumen der Baustelleneinrichtung für alle ausgeschriebenen Spülbohrarbeiten (Spülbohrung 1 und 2) </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Eingeschlossen sind die erforderlichen Lager- und Arbeitsplätze innerhalb des Baufeldes sowie deren Befestigung und Beseitigung. Genutzte Flächen sind in den früheren Zustand wieder herzustellen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Vergütung erfolgt entsprechend der erbrachten Leistung.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Kosten für Vorhalten, Unterhalten und Betreiben der Geräte, Anlagen und Einrichtungen einschl. Mieten, Pacht, Gebühren und dergleichen. werden nicht mit dieser Pauschale, sondern in den folgenden Positionen mit Einheitspreisen der betreffenden Teilleistungen vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Einrichten und Räumen der Baustelle für Spülbohrarbeiten PE DA = 355 mm</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008296" RNoPart="0002">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einrichten und Räumen der Baustelle für Spülbohrarbeiten PE DA = 355 mm</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Position beinhaltet Einrichten und Räumen der kompletten Spülbohranlage für die Spülbohrarbeiten im Bereich der Spülbohrungen 1 und 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abrechnung jeweils </span>
                              <span style="font-weight:bold;background:#FFFFFF;">pro Spülbohrung 1 Stück</span>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Des Weiteren die Kosten für Vorhalten, Unterhalten und Betreiben der Geräte, Anlagen und Einrichtungen einschl. Mieten, Pacht, Gebühren.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis: Es wird ausdrücklich der Einsatz einer Spülbohranlage mit einer </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">               Zugkraft von mindestens 28 to gefordert. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">               Eine Anlage mit weniger Zugkraft wird wegen der </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">               Randbedingungen nicht zugelassen!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">               Der Kalkulator hat dies ausdrücklich zu berücksichtigen!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Einrichten und Räumen der Baustelle für Spülbohrarbeiten PE DA = 355 mm</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008300" RNoPart="0003">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Bohrspülungskonzept für die geplanten Spülbohrungen erstellen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">das geforderte Konzept muss folgende Punkte enthalten:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">1. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Allgemeine Angaben wie:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Örtlichkeit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Bohrung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Baugrund</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Bohrausrüstung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Feststoffkontrolle</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">2.</span>
                              <span style="text-decoration:underline;background:#FFFFFF;"> Baumaßnahme</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Beschreibung der wesentlichen Merkmale der Maßnahme</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Beschreibung der Aufgaben und Eigenschaften der gewählten Bohrsuspension</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">3. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Spülungsprogramm mit Anweisungen für:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Spülungstyp</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Spülungsrezeptur</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Dichte</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Rheologie</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Filtration u.a.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Das Spülungsprogramm muss auf das Projektdesign und die geologischen         Randbestimmungen abgestimmt sein.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">4.</span>
                              <span style="text-decoration:underline;background:#FFFFFF;"> Anmachwasser und Spülungsbedarf</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Eigenschaften der zu verwendenden Suspension in Abhängigkeit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  des vorhandenen Anmachwassers</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Bohrungsvolumen und Pumpvolumen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Spülungsrezeptur</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Materialbedarf und Lieferumfang</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">5. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Bohrlochhydraulik</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Kenndaten Pilotbohrung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Kenndaten Aufweitung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Kenndaten Aufweitgang</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Hydrostatischer Druck</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">6. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Feldtests periodisch durchzuführen</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">    Die Kontrolle folgender Parameter sind dabei zu berücksichtigen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Zeit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Bohrfortschritt</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Verbrauch</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Spülungsrezeptur</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- ph - Wert, Wasserhärte und Salzgehalt des Anmachwassers</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Säuregrad der Bohrsuspension</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Scheinbare und plastische Viskosität</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Fließgrenze</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Gelstärken</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- API - Wasserverlust</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Filterkuchendicke</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Spülungsgewicht</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Sandgehalt</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Bohrkleininventar</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Organoleptische Indikatoren wie Farbe und Geruch</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">7. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Feststoffkontrolle, Wiederaufbereitung der eingesetzten Bohrspülung</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">   Betrachtung der einzelnen notwendigen Komponenten wie z.B.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">-  Vibrosiebe</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">-  Desilter</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">-  Zentrifuge</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">8. </span>
                              <span style="text-decoration:underline;background:#FFFFFF;">Stoffeinträge in die Umwelt</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">-  Aktuelle Beurteilung eines qualifizierten Hygieneinstitutes zum</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   vorgeschlagenen Spülungssystem.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Bohrspülungskonzept für die geplanten Spülbohrungen erstellen,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2008301" RNoPart="02">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Vermessung </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2008302" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Vermessungstechnische Leistungen - Absteckung</span>
                              <br/>
                              <span style="background:#FFFFFF;">Ausführung als Lageabsteckung für die geplante Leitungstrasse </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">und Zwangspunkte.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Die erforderlichen digitalen Planunterlagen  werden dem AN per DXF oder DWG - Datei zur Verfügung gestellt.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Die Vergütung erfolgt ausschließlich für elektrooptisch abgesteckte Punkte (Tachymeterabsteckung oder Roverabsteckung).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Anzahl der Absteckpunkte für alle 2 Trassen ca. 45 Stück.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Von Hand abgesteckte Punkte sind in die Gemeinkosten einzukalkulieren!</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung in 2 Abschnitten ist einzukalkulieren, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt hier pauschal für alle 2 Spülbohrungen!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Vermessungstechnische Leistungen - Absteckung</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008303" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Vermessungstechnische Leistungen - Bestand</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aufnahme aller erstellten Gewerke, Leitungen in Lage und Höhe</span>
                              <br/>
                              <span style="background:#FFFFFF;">zur Kontrolle und Anfertigung von Bestandsplänen für</span>
                              <br/>
                              <span style="background:#FFFFFF;">den AG bzw. die Bauleitung mit Tachymeter- oder Rovermessung.</span>
                              <br/>
                              <br/>
                              <span style="background:#FFFFFF;">Übergabe als digitaler CAD-Plan (dwg - Format 2007) und</span>
                              <br/>
                              <span style="background:#FFFFFF;">in Form von Listendaten (Ascii - Format). Als</span>
                              <br/>
                              <span style="background:#FFFFFF;">Koordinatensystem wird Gauß-Krüger, als Höhensystem</span>
                              <br/>
                              <span style="background:#FFFFFF;">DHHN12 vorgegeben.</span>
                              <br/>
                              <br/>
                              <span style="background:#FFFFFF;">Die Listendaten müssen den Planobjekten eindeutig</span>
                              <br/>
                              <span style="background:#FFFFFF;">zuzuordnen sein und neben Nummer, ggf. Code,</span>
                              <br/>
                              <span style="background:#FFFFFF;">Rechtswert, Hochwert und Z-Koordinate (Höhe), alle</span>
                              <br/>
                              <span style="background:#FFFFFF;">notwendigen Informationen enthalten.</span>
                            </p>
                            <p>
                              <br/>
                              <span style="background:#FFFFFF;">Die Aufnahmen dienen als Grundlage für Verlege-,</span>
                              <br/>
                              <span style="background:#FFFFFF;">Abrechnungs- und Bestandslageplan.</span>
                              <br/>
                              <br/>
                              <span style="background:#FFFFFF;">Beinhaltet sind alle erforderlichen technischen</span>
                              <br/>
                              <span style="background:#FFFFFF;">Einrichtungen, Materialien, mehrfache Anfahrten, sowie</span>
                              <br/>
                              <span style="background:#FFFFFF;">die zusätzliche Datenerhebungen beim zuständigen</span>
                              <br/>
                              <span style="background:#FFFFFF;">Vermessungsamt (Festpunkte TP, HP usw.) und bei</span>
                              <br/>
                              <span style="background:#FFFFFF;">Leitungsträgern.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Ausführung erfolgt parallel zur Spülbohrung und Erstellung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">des entsprechenden Bohrprotokolls.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Das Bohrprotokoll wird im Gewerk Spülbohrung vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Messabstände bewegen sich analog zum Bohrprotokoll bei ca. 5 - 6 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">bei Bedarf (z.B. Leitungskorrektur u.a.) können sich die Messabstände </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">bis auf 3 m verringern.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der Kalkulator hat dies zu berücksichtigen und hier mit einzurechnen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Für beide Spülbohrtrassen sind ca. 75 - 85 Messpunkte zu rechnen.</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung in 2 Abschnitten ist einzukalkulieren, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt hier pauschal für alle 2 Spülbohrungen!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Vermessungstechnische Leistungen - Bestand</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2008304" RNoPart="03">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Tiefbau Spülbohrarbeiten Wasserleitung (Hauptleitung) </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2019757">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Geotechnischer Hinweis zur Kalkulation der Positionen </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizontales Spülbohrverfahren </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Spülbohrung 1 Waldweg Station 0+580 - 0+745,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Spülbohrung 2 Waldweg Station 0+750 - 0+990.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Homogenbereiche stellen sich wie folgt dar:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB 5 B 3: Moränensand</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB 7 B 5: Grundmoräne, [PERSON_033]</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Übersicht aller Homogenbereiche im Bereich geschlossener Bauweise.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Geschlossene Bauweise Wasserleitung im Spülbohrverfahren:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Aufgeführt sind hier alle Homogenbereiche im Bereich geschlossene Bauweise ab OK Gelände, tatsächlich durchbohrt werden aber nur der HB 5 B 3 Moränesand anteilig ca. 33 % und der HB 7 B 5 Grundmoräne anteilig ca. 67 %!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Bitte bei der Kalkulation beachten!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Homogenbereich 1, mit 3 Bodengruppen, Bodengruppe 1 GU DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 2 GU* DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 3 UL DIN 18196 (leicht plastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 15,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 1 Auffüllung,Kies Bkl. 3,4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 40 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 50 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 70 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Lagerungsdichte mitteldicht,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Homogenbereich 2, mit 2 Bodengruppen, Bodengruppe 1 UL DIN 18196 (leicht plastischer [PERSON_033]), Bodengruppe 2 UM DIN 18196 (mittelplastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 2,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 2 Auffüllung, [PERSON_033] Bkl. 4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 20 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 55 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 75 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 10 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 30 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert von 20 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert bis 40 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic von 0,5,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic bis 0,75,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip von 4 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip bis 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Homogenbereich 3, mit einer Bodengruppe, Bodengruppe 1 HZ DIN 18196 (zersetzter Torf), Tiefe oberer Horizont des Homogenbereiches von 1 m, Tiefe unterer Horizont des Homogenbereiches bis 2 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich B 1 Torf Bkl. 2/4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 60 %,</span>
