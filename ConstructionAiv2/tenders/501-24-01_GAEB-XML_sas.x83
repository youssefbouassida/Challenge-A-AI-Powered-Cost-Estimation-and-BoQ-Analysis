                  <Item ID="GW_2008392" RNoPart="0003">
                    <Qty>1.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Datenlogger zur Datenübertragung der Messwerte</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von Druck, Temperatur, Durchfluss und Durchflussrichtung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">inkl. Kabel, Stecker, Batterie und Antenne. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit folgender Konfiguration:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Eingänge:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 3 Eingänge konfigurierbar (2x digitaler Zähler, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    Spannung 0-3V / 4-20mA + 1x Spannung 0-3V </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    / 4-20mA) mit programmierbarer</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    Ausgangsleistung für jeden Eingang</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 1-Wire (kompatibel mit 1–Wire </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    Temperatursensoren)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Reservierter Eingang für AQPressure – </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Niedrigspannungs-Sensor mit 0-30 bar </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Druckmessung (+- 50 mbar Genauigkeit bei 0-6  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   bar) und Temperatursensor (-20 bis +85°C)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Rs485</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional M -Bus</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausgänge:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1x Relais Ausgang mit programmierbarem 6-24V </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Spannungsausgang, Verpolungs-Schutz und bis </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  10W Puls. Direkt an impulsgesteuerte</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Magnetspule anschließbar.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Eingangstypen (einzeln konfigurierbar mit Software):</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Digital (misst Impulse von HRI, REED, Cyble, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Kurzschluss) - Zählermodus</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Analog (misst Spannung 0-3 V)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 0/4-20mA Stromschleife (2- und 4 Wire Support)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Für jeden Eingang kann eine separate Stromschleife </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">konfiguriert werden die dann die angeschlossenen Sensoren </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit Strom aus den internen Batterien versorgt. Die Versorgungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">spannung und Versorgungszeit ist für jeden Eingang separat</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> konfigurierbar (von 6V bis 30V).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Kommunikation:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Eingebauter GSM Modem (GSM/GPRS/EDGE </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   900/1800, LTE-FDD B1/B3/B7/B8/B20, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   UMTS/HSPA +B1/B8)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - GPRS/3G/4G und SMS Kommunikation mit </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   AQWeb Server (konfigurierbar)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional GPS</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Akzeptiert SIM Karten in normaler Größe</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Bluetooth zur Programmierung vor Ort (v4.2  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   BR/EDR)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Wi-Fi (802.11 b/g/n)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Lokale Anbindung mit USB Kabel </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   (Konfigurierung und Fehlerdiagnose)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Merkmale:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Gehäuse: IP68, DIN-Schiene-Option</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Maße(mm): 160 x 80 mm</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Gewicht: 800g</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Montage:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 3 Löcher im Gehäuse für Kabelbinder und   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Wandhalterungen</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Betriebsumgebung:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Temperaturbereich: Verringerte Lebensdauer  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    der Batterie außerhalb -15°C und +55°C</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Luftfeuchtigkeit: 0-100% nicht kondensierend</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Stromversorgung:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Standard 2x 3,6V Li-SOCI2 Batterie, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Optional 3 Stück</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Standard-Batterielebensdauer bis zu 6 Jahre (je </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   nach Konfiguration)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Batterien leicht austauschbar</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional Netzstromversorgung, Solarpanel oder </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   wieder aufladbare Batterien</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Firmware-Funktionen Konfiguration:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 2-Wege-Kommunikation mit Bluetooth oder Wi-Fi</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 2-Wege-Kommunikation mit AquaWeb Server</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - automatische Firmware-Aktualisierung über das  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Internet oder USB-Kabel</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - alle Parameter können über das Internet </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   konfiguriert werden</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Gesendete Daten während der Kommunikation:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - AQUALINK AQ ID</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - SIM Nummer</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Ungefährer Standort über GSM Triangulation</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Datum und Uhrzeit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Datenlogger Messwerte</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Batteriestand</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - GSM Signal</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Firmware-Version</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Eigener Stromverbrauch</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Konfigurierbare Parameter:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Datum und Uhrzeit</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Intervalle der Aufzeichnung und Übermittlung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   von Daten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Modus für jeden Eingang</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Kumulative für den digitalen Eingang-Modus</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Alarmgrenzwerte (max. Anzahl der Impulse </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   zwischen konfigurierten Intervallen, bevor der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Alarm ausgelöst wird, max. und min. Wert für</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Spannung und Stromschleife, bevor der Alarm </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   ausgelöst wird)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Mobilanbieter APN-Einstellungen für die </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   GPRS/3G/4G -Verbindung</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Datenübertragung (GPRS/3G/4G und SMS):</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Minimaler Sendeintervall der Daten ist 1 Minute </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   (GPRS/3G/4G/SMS) bis zu einmal pro Monat</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Datenaufnahme:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Datenaufzeichnung alle 0,1 Sekunden bis zu </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   einmal pro Woche</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Interner Datenspeicher für 300.000 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Speicherintervalle</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Alarme:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Unabhängig konfigurierbare Schwellenwerte für   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   jeden Eingang (max. Anzahl der Impulse </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   während eines Speicherintervall für</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Digitalmodus, min. und max. Wert für Analogen- </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  oder 4-20mA-Modus)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;"> - Wenn die festgelegten Schwellenwerte </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   überschritten werden, wird ein Alarm mit dem </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   aktuellen Eingangswert und die Art des Alarms</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   gesendet (untere Grenze, obere Grenze).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Optional:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Mast mit zusätzlicher Antenne</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Zusätzliche Eingänge</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - SIM-Chip</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Installationswerkzeuge</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Verschiedene Sensoren (Druck, Füllstand, pH,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Temperatur, Luftfeuchtigkeit u.a.)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Fabrikat: </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ARMARE-TEC AQUALINK, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] AQUALINK3 IoT AQ Meter GSM 2-4G IP68 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit Verbindungsstecker und Antenne, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">oder gleichwertig.</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">angebotenes Fabrikat: ……………………………</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">liefern, montieren und fachgerecht in Betrieb nehmen.</span>
                            </p>
