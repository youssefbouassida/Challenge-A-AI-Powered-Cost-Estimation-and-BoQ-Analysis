                  <Remark ID="GW_2008235">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Sicherheitshinweis für das Schneiden, Ausbauen und Beseitigen</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">von Rohrleitungen DN 100 - 150 ( u.a. Dimensionen ) aus Asbestzement:</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die nachfolgenden Leistungspositionen mit Trennen, ausbauen und beseitigen der asbesthaltigen Rohrleitungen müssen unter Einhaltung aller Bestimmungen der Technischen Regeln für Gefahrenstoffe TRGS 519 kalkuliert werden.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Es wird gefordert, dass sämtliche ausgeschriebenen Leistungen als Arbeiten mit geringer Exposition ausgeführt werden.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Eine geringe Exposition liegt bei einer Asbestfaserkonzentration am Arbeitsplatz unter 15.000 Fasern/m³ vor. (TRGS 519 Nr. 2.8)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Folgende Punkte sind besonders zu beachten:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Eine sachkundige Person des AN muss vorhanden sein und vor Ausführung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  benannt werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Eine Zulassungsbescheinigung der eingesetzten Geräte ist vorzulegen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Die Annahmebestätigung der Deponie für die Asbestzementabfälle</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Die Anzeige der Arbeiten bei der zuständigen Behörde</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">Sicherheitshinweis für das Schneiden, Ausbauen und Beseitigen</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">von Rohrleitungen DN 100 - 150 ( u.a. Dimensionen ) aus Asbestzement:</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">Die nachfolgenden Leistungspositionen mit Trennen, ausbauen und beseitigen der asbesthaltigen Rohrleitungen müssen unter Einhaltung aller Bestimmungen der Technischen Regeln für Gefahrenstoffe TRGS 519 kalkuliert werden.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Es wird gefordert, dass sämtliche ausgeschriebenen Leistungen als Arbeiten mit geringer Exposition ausgeführt werden.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Eine geringe Exposition liegt bei einer Asbestfaserkonzentration am Arbeitsplatz unter 15.000 Fasern/m³ vor. (TRGS 519 Nr. 2.8)</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">Folgende Punkte sind besonders zu beachten:</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">- Eine sachkundige Person des AN muss vorhanden sein und vor Ausführung</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">  benannt werden.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- Eine Zulassungsbescheinigung der eingesetzten Geräte ist vorzulegen</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- Die Annahmebestätigung der Deponie für die Asbestzementabfälle</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- Die Anzeige der Arbeiten bei der zuständigen Behörde</span>
                              </p>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008236" RNoPart="0026">
                    <Qty>7.000</Qty>
                    <QU>m</QU>
                    <Description>
