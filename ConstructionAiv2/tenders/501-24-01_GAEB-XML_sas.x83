                  <Item ID="GW_2007990" RNoPart="0018">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zur Bodenbewegung den Positionen Bodenaushub mit Wiederverfüllung</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">der Wasserleitung GGG DN 300 ZMU, Grabenwände senkrecht verbaut und </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">geböscht, für:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Aussortieren und Beseitigen von Verfüllmaterial (anstehend oder geliefert) mit einer Korngröße </span>
                              <span style="font-weight:bold;background:#FFFFFF;">&gt; 100 mm.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die zulässige Korngröße der Rohrumhüllungsmaterialien nach DVGW . Arbeitsblatt W 400-2 für Rohre mit Zementmörtel - Umhüllung beträgt </span>
                              <span style="font-weight:bold;background:#FFFFFF;">max. 100 mm.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ebenso ist das u.U. erforderliche Vorsortieren des einzubauenden </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">[PERSON_093]s direkt im Rohrbereich (gut verdichtbar) mit einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung beinhaltet sowohl Hand- wie auch Maschinenarbeit.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Kalkulator hat beides im Zusammenhang mit den vorliegenden</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Geotechnischen Bericht (Homogenbereiche mit Anteil Steine) einzurechnen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Gesamtlänge offene Bauweise verbaut und geböscht ca. 675 m.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Abrechnung Pauschal für die Gesamtmaßnahme.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Bodenbewegung den Positionen Bodenaushub mit Wiederverfüllung</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007995" RNoPart="0019">
                    <Qty>25.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">jedoch </span>
                              <span style="font-weight:bold;background:#FFFFFF;">reine Zulage</span>
                              <span style="background:#FFFFFF;"> zum Grabenaushub im Verbau bis ca. 2,00 m Tiefe,</span>
                            </p>
                            <p style="text-align:justify;">
