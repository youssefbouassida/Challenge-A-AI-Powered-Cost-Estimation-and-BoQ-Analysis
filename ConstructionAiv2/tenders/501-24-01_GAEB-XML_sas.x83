                  <Item ID="GW_2008499" RNoPart="0009">
                    <Qty>160.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Position GGG Rohr DN 300</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für längskraftschlüssige Muffenverbindungen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] Standard Vi oder SIT Dichtung mit Kennzeichnungsring,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">entsprechend der Muffenverbindung.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position GGG Rohr DN 300</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008502" RNoPart="0010">
                    <Qty>165.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Rohrposition GGG ZMU DN 300 für</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Liefern und Einbauen einer passenden</span>
                              <br/>
                              <span style="background:#FFFFFF;">Schutzmanschette für Rohre mit ZM - Umhüllung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für Tyton-  sowie zugfeste und formschlüssige Verbindungen.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Werkstoff: TPE oder EPDM, L = 190 - 200 mm.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung an allen ZM - Verbindungen.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Rohrposition GGG ZMU DN 300 für</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008503" RNoPart="0011">
                    <Qty>55.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Rohrposition GGG ZMU DN 300,</span>
                              <br/>
                              <span style="background:#FFFFFF;">Muffenverbindung für Rohre mit ZM - Umhüllung herstellen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung Mehraufwendungen an allen zusätzlichen Verbindungen gegenüber den normalen Muffenübergängen, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(z.B. Bögen, Einbauten, Leitungsverkürzungen),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">an denen das ZMU - Rohr für den Zusammenschluss extra an der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ZM - Umhüllung bearbeitet werden muss, einschl. Rohr schneiden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abgerechnet werden nur tatsächlich zu bearbeitende Spitzenden.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Rohrposition GGG ZMU DN 300,</span>
                                <br/>
                                <span style="background:#FFFFFF;">Muffenverbindung für Rohre mit ZM - Umhüllung herstellen,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008504" RNoPart="0012">
                    <Qty>10.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Rohrposition GGG ZMU DN 300 für</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Liefern und Einbauen einer</span>
                              <br/>
                              <span style="background:#FFFFFF;">TYTON- Schrumpfmuffe/-manschette offen,  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">alternativ für Rohre mit ZM - Umhüllung,</span>
                              <br/>
                              <span style="background:#FFFFFF;">[PERSON_129] MEPS, einschl. Verschlusslasche L = 300 mm.</span>
                            </p>
