                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage für Mehraufwand Abstimmung Betreiber von Medienleitungen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">jeglicher Art</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Zulage als Vergütung für Abstimmung mit Betreibern von Medien- und Versorgungsleitungen jeglicher Art. Stellenweise Prüfung der schadensfreien Bohrung, sowie Bestimmung der Tiefenlage sind einzukalkulieren. Suchgräben werden gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung ist für 2 aufeinanderfolgende Spülbohrungen einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt einmal pauschal für beide Spülbohrungen!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage für Mehraufwand Abstimmung Betreiber von Medienleitungen </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008311" RNoPart="0008">
                    <Qty>165.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Pilotbohrung 1</span>
                              <span style="background:#FFFFFF;"> Rohre PE DA 355.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einbringen der Pilotbohrung auf der geplanten Bohrachse entsprechend Lage und Höhenpläne,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">einschließlich der dazu notwendigen Nebenleistungen vom Eintritt bis zum Austritt des Bohrkopfes aus dem Erdreich mit Walk-Over- / Wire-Line .</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Abgerechnet wird nach Einzugslänge, Mehraufwand für früheres einstechen des Bohrkopfes in Gelände um mit Pilotbohrung auf Höhe zu gelangen ist einzukalkulieren. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Bereitstellung, Vorhaltung und der Betrieb einer Bohrsuspension- Recyclinganlage ist ebenfalls einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung für die Unterquerung des Waldweges und </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">1 Grabenverdolung DN 500.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung erfolgt in 1 Gesamtabschnitt.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Überdeckung von OK Gelände ca. 1,70 - 2,60,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">s. Längenschnitt ca. Station 0+580 - 0+745. Länge ca. 165 m.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die anstehende Geologie ist in der Position Spülbohrung 1 detailliert</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">beschrieben!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung für die Unterquerung des Waldweges und </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">1 Grabenverdolung DN 500. </span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Pilotbohrung 1 Rohre PE DA 355.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008312" RNoPart="0009">
                    <Qty>85.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zu Pilotbohrung 1 für Fehlbohrung PE DA 355, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zur Position Pilotbohrung für Fehlbohrungen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">beinhaltet alle Erforderlichen Aufwendungen für Geräte, Material und Personal für das Zurückziehen und Wiederansetzen bzw. Umfahren von Hindernissen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung für die Unterquerung des Waldweges und </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">1 Grabenverdolung DN 500.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zu Pilotbohrung 1 für Fehlbohrung PE DA 355, </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008313" RNoPart="0010">
                    <Qty>165.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Horizontale</span>
                              <span style="font-weight:bold;background:#FFFFFF;"> Spülbohrung 1</span>
                              <span style="background:#FFFFFF;"> für PE100RC TW AD/WD 355/32,2 mm </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">PAS 1075 [PERSON_129] 3</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Aufweitung des Bohrloches auf den benötigten Enddurchmesser Durchmesser einschließlich aller dazu notwendigen Nebenleistungen mit Einspülunterstützung sowie Zusatz von Bentonitsuspension zur Stützung der Bohrlochwandung abgestimmt für den Untergrund laut Baugrunduntersuchung, eine Unbedenklichkeitsbescheinigung ist vorzulegen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Bereitstellung, Vorhaltung und der Betrieb einer Bohrsuspension- </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Recyclinganlage ist einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ballastierung der Leitung mit [PERSON_029] gegen den Rohrauftrieb für den Rohreinzug, ist ebenfalls miteinzukalkulieren!</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Mit bohrfortschrittsbezogener Protokollierung nach DVGW GW 321, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">allen notwendigen Messungen einschl. Verlegeprotokoll,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einzug der endlosen Rohrleitung durch Zurückholen des Bohrgestänges im aufgefahrenen Hohlraum für PE100RC TW AD/WD 355/32,2 mm PAS 1075 [PERSON_129] 3, (Rohrmaterial wird gesondert vergütet,s. Position im Gewerk Rohrleitungen </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">für Spülbohrungen).</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einschl. Rollenbahn nach [PERSON_125] des AN.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zugkraftbegrenzung gemäß Herstellerangaben Rohrmaterial,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">die Bohrsuspension darf nicht im Gelände (Wald) entsorgt werden und nicht in den Wassergraben, oder auf die Grabenböschung etc. gelangen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einzurechnen ist die Beprobung des Bohrschlammes nach LAGA, sowie die fachgerechte Verwertung/Entsorgung entsprechend Abfallschlüsselnummer 010504 der Schlämme und Abfälle aus Süßwasserbohrungen,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Verwertung/Entsorgung ist nachzuweisen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Für belastete Bohrschlämme werden Zuschläge bezahlt,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Überdeckung nach PIanvorlage‚</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">einschl. Rückstellprobe der Spülsuspension vor und nach den Arbeiten.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p>
                              <span style="background:#FFFFFF;">Überdeckung von OK Gelände Spülbohrung ca. 1,70 - 2,60.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Rohr-Außendurchmesser OD 355 mm,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">die PE-Rohre sind sauber zu halten, alle Verunreinigungen des Rohres (zum Beispiel Betonit-Eintrag) sind zu vermeiden, eine eventuell nötige Reinigung des Rohres (Spülen, etc.) geht zu Lasten des AN.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Abgerechnet wird die gebohrte Länge im Erdreich einschließlich Start- u. Zielgruben entsprechend der Länge der eingebauten Rohrleitung,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Aufwendungen für die Ein- / Ausfahrstrecke zwischen Eintritt an der Geländeoberﬂäche bis zur Start- / [PERSON_034] sind einzurechnen,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Abrechnungsbereiche sind im Längsschnitt vorgegeben.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Ausführung erfolgt in 1 Gesamtabschnitt im Bereich der Unterquerung des</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Waldweges Station ca. 0+580 - 0+745. Länge ca. 165 m.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Geologie stellt sich laut den Rammkernsondierungen 4/25, 5/25 und 6/25 wie folgt dar:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Homogenbereiche nach DIN 18300,</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 4 (Spülbohrung endet ca. 10-12 m vor RKS 4/25):</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,00 - 0,40 m Mutterboden, [PERSON_033]                                                                          0,40 - 1,90 m HB B 2 Verwitterungslehm, [PERSON_033], angewitterte                                                                 Grundmoräne</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                    1,90 - 2,80 m HB B 4 Moränenkies</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                    2,80 - 4,00 m HB B 5 Grundmoräne,[PERSON_033] </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 5:       0,00 - 0,50 m  HB A 1 Auffüllung Fein- Grobkies                  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,50 - 1,70 m  HB B 2 Verwitterungslehm, [PERSON_033], angewitterte                                                                 Grundmoräne</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   1,70 - 4,00 m  HB B 5  Grundmoräne,[PERSON_033]</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 6:       0,00 - 0,40 m   HB A 1 Auffüllung Fein- Grobkies </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,40  1,50 m    HB B 2 [PERSON_033], angewitterte  Grundmoräne </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   1,50 - 3,00 m   HB B 5 Grundmoräne, [PERSON_033].</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Horizontale Spülbohrung 1 für PE100RC TW AD/WD 355/32,2 mm </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
