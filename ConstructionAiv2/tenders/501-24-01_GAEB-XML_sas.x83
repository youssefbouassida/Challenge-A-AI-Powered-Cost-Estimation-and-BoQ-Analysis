                  <Item ID="GW_2013459" RNoPart="0008">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage </span>
                              <span style="background:#FFFFFF;">zur Position Grabenaushub Wasserleitung Hauptleitung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für sämtliche Mehraufwendungen im Bereich [PERSON_006] </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">bei Station 0+370 Be- und Entlüftung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aushub geböscht, Aushubtiefe bis ca. 3,00 m einschl. Untergrundverbesserung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">und Abgang Schachtentwässerung DA 110, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wiederverfüllung mit anstehendem Material, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abfuhr und Beseitigung der Bodenverdrängung von </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_006]</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">DN 2500</span>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Abfuhr von verdrängtem Boden durch [PERSON_112] wird über die Gesamtmassenbilanz gesondert vergütet.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_112] wird gesondert vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position Grabenaushub Wasserleitung Hauptleitung </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2031309" RNoPart="0009">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_006] DN 2500</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Schachttiefe im Lichten 1,70 m von UK Abdeckplatte bis OK Schachtboden,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">zuzüglich weiteren 0,40 - 0,45 m (Abdeckplatte und Schachtboden) ergibt</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">eine Gesamthöhe Schacht von ca. 2,10 - 2,15 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung Schachtunterteil einschl. Wände monolithisch,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abdeckplatte separat (Versetzen erst nach Fertigstellung der Inneninstallation ist einzukalkulieren),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN EN 1917, DIN 4034 - 1, [PERSON_129] 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">FBS-Qualität oder vergleichbar,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schachtbauwerk in kompletter wasserdichter Ausführung wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Unterteil mit Kellersinkkasten und Rückstauverschluss DN 110,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtwände h = 1,70 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 Schachtdurchführung für Hauptleitung GGG DN 300,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 Schachtdurchführung für Hauptleitung PE DA 355 einschl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  erforderlichen Ringraumdichtungen, , Gas- und Druckwasserdicht!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Abdeckplatte mit 1. Öffnung DN 800 mm, exzentrisch,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  und 2. Öffnung DN 450 mm für Schachthydrant (Kann nach [PERSON_125] des AN auch    vor Ort hergestellt werden), Lage der Öffnungen s. Zeichnung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 2 Betonkragen für Öffnung DN 800 mm und Öffnung DN 450 mm, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  b = 20 cm, h = 20 cm werkseitig oder örtlich nach [PERSON_125] des AN,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   wasserdicht auf Betondeckenplatte herstellen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 Auflagerring DN 800 mm mit Schubsicherung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 Auflagerring DN 450 mm mit Schubsicherung,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtabdeckung für Wasserleitungen </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> l.W. 800 mm und 450 mm </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  s. gesonderte Position, </span>
                              <span style="font-weight:bold;background:#FFFFFF;">werden gesondert vergütet. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Festpunkte zur Fixierung der Wasserleitung im Schacht,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Edelstahlstützen und Einstiegsleiter werden gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">einschl. kompletter Auftriebssicherung </span>
                              <span style="background:#FFFFFF;">gegen anstehendes Grund- und </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_149] nach [PERSON_125] des AN örtlich oder werksseitig herstellen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hydrantenschacht komplett wasserdicht herstellen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung s. auch Zeichnung!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Be- und Entlüftungsschacht mit Schachthydrant am Hochpunkt </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">bei ca. Station 1+000.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">[PERSON_006] DN 2500</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2030478" RNoPart="0010">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage Grabenaushub Hauptwasserleitung für Erdaushub und Verbau für [PERSON_006] DN 2500 bei ca. Station 1+000 nach [PERSON_125] des AN wie folgt:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Geologie bei RKS 10/25:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Waldboden/[PERSON_033] OK Gelände bis - 0,10 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Verwitterungslehm, [PERSON_033] von - 0,10 m bis 1,20 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Moränensand,Feinsand      von - 1,20 m bis 4,00 m Endtiefe.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_029] beim Bohren zunächst nicht angetroffen, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_029] nach Bohrende in den Moränesanden bei - 1,40 m gemessen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(kein Ruhewasserspiegel).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Voraushub bis ca. - 1,20 m unter Gelände ausführen, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Maße ca. 4,0 x 4,0 m für Einbringen von rundum geschlossenem Verbau</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nach [PERSON_125] des AN.(Moränensand darf nicht nachfließen)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Restaushub ca. 1,80 m bis Aushubsohle ca. - 3,00 m unter Gelände im Verbau,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Verbau im Moränensand bis Sohle abteufen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Komplette Wasserhaltung ist im geschlossenen Verbau ca. 1,0 l/s mit auszuführen, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Geotextil RKl. 3 zur Filterstabilen Trennung Kies/Schotterverfüllung und anstehendem Boden in Sohle und aufgehend rundum bis ca. - 0,50 m unter OK Gel</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">liefern und einbringen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der gesamte Schachtaushub ca. 50 - 60 cbm wird auf das Zwischenlager zur Beprobung abgefahren und dort gelagert.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Schachtgründung mit Schotter, sowie Wiederanfüllung des Schachtbau-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">werkes wird gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Hier sind alle sonstigen erforderlichen Leistungen wie Aushub, Verbau einbringen und wieder beseitigen, Wasserhaltung und Geotextil einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt pauschal.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage Grabenaushub Hauptwasserleitung für Erdaushub und Verbau für [PERSON_006] DN 2500 bei ca. Station 1+000 nach [PERSON_125] des AN wie folgt:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2030603" RNoPart="0011">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Hindernis im Boden, aus Beton, abbrechen,                                  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">das Abbruchmaterial wird Eigentum des AN und ist zu beseitigen. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einzelgröße des Hindernisses 1000 bis 1200 mm,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schachttiefen bis ca. 2,00 m.                                      </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Art des [PERSON_084] als Wasserleitungsschächte mit </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schachtabdeckungen aus Guss.                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung punktuell, einschl. aller erforderlichen [ORT_030] für Freilegen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Material seitlich lagern und nach Ausbau der Betonteile wieder einbauen und verdichten.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung alter Hausanschlussschacht bei WWg 19 und Be- und Entlüftungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schacht am Bauende.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hindernis im Boden, aus Beton, abbrechen,                                  </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008115">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Wasserleitungsschächte eckige Form, Bauweise als Fertigteilschachtbauwerke</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Wasserleitungsschächte eckige Form, Bauweise als Fertigteilschachtbauwerke</span>
                              </p>
                            </TextOutlTxt>
