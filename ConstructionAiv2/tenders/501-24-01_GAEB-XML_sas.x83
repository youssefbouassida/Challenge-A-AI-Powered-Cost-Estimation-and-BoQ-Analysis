                  <Item ID="GW_2008041" RNoPart="0047">
                    <Qty>12.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Position Grabenaushub und Verlegung der Wasserleitung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für Liefern und Einbauen von Lehmriegeln mit nachweislich </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schadstofffreiem Lehm. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einbau von Aushubsohle bis ca. 1,0 m über Rohrscheitel auf der gesamten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Grabenbreite, auf ca. 1,50 m Grabenlänge. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung nach vorheriger Rücksprache und Festlegung der Einzelstellen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit der Bauleitung!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abrechnung nach Aufmaß und Nachweis mit Lieferscheinen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Lehmriegel sind vom AN in Planunterlagen lagemäßig </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">festzuhalten.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position Grabenaushub und Verlegung der Wasserleitung</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008042">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Kabelarbeiten Stromversorgung und Steuerkabel im Zuge der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wasserleitungsarbeiten.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Kabelarbeiten Stromversorgung und Steuerkabel im Zuge der </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008043" RNoPart="0048">
                    <Qty>100.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-size:11pt;background:#FFFFFF;">Z</span>
                              <span style="background:#FFFFFF;">ulage zu allen Grabenpositionen der Wasserleitung DN 300</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">für die kompletten Tiefbauarbeiten zur Mitverlegung eines Kabelleerrohres wie folgt beschrieben:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Verlegen eines Kabelschutzrohres PE DN/OD 110 parallel zur Wasserleitung</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">DN 300 am linken oder rechten Grabenrand  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">ca. 20 - 30 cm über OK Leitung DN 300 (ca. - 1,00 bis 1,20 m unter OK Gelände) einschließlich entsprechendem Zwischenplanum.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Sand liefern und Rohr DN/OD 110 rundum mind. 10 cm stark umhüllen,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">dadurch verdrängtes Material im Baufeld mit einbauen, oder nach [PERSON_125] des AN beseitigen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Kabelschutzrohr wird gesondert vergütet.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Verlegung muss planmäßig auf dem Zwischenplanum erfolgen! </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Alle erforderlichen [ORT_030] für einen zusätzlichen Kabelzugschächte</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">sind hier mit einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Abstand zwischen dem Schachtbauwerk Wasserleitung und Kabelschacht beträgt ca. 100 m!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Das Kabelschutzsystem ist außerhalb der Schächte geschlossen herzustellen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Entsprechende Schweiß- oder Steckmuffenverbindungen PE DN/OD 110 </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">werden gesondert vegütet.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung vom WL - Schacht Baubeginn 0+000 bis ca. 0+095 in der Asphaltstraße für spätere Stromzuführung von Burg.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zu allen Grabenpositionen der Wasserleitung DN 300</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008045" RNoPart="0049">
                    <Qty>100.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Liefern und einbauen von Trassenband Breite 40 mm,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aufdruck entsprechend dem verlegten Kabel / Leerrohrsystem</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">"Achtung Stromkabel"</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Farbe: gelb; Dicke: 0,15 mm; Breite 40 mm,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Einbau ca. 30 cm über Leitung, einschl. Zwischenplanung bei der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Grabenverfüllung.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Liefern und einbauen von Trassenband Breite 40 mm,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008055" RNoPart="0050">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Komplette Kernlochbohrung DN 120 - 140 </span>
                              <span style="background:#FFFFFF;">zur Herstellung von</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einer wasserdichten Kabeldurchführungen DA 110 für Leerrohrleitung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung in Betonschächten (Wasserleitungsschächte, Kabelzugschächte),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wanddicken bis ca. 10 - 15 cm</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">einschl. passenden Wanddurchführungen wasserdicht</span>
                              <span style="background:#FFFFFF;"> für Leerrohrleitung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DA 110</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Anfallendes Material beseitigen.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Komplette Kernlochbohrung DN 120 - 140 zur Herstellung von</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008056" RNoPart="0051">
                    <Qty>100.000</Qty>
