                  <Item ID="GW_2008440" RNoPart="0018">
                    <Qty>1.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Schubsicherung Eingangsflansch DN 300 PN 16 </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">zusätzliche Schubsicherung des ersten Flanschen (duktiler Guss) nach Wanddurchführung durch Fixierung des Flansches an vier Punkten durch Gewindestangen und Fixierungsplatten an der Schachtwand. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Alle Materialien aus [PERSON_115] A4 </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Position muss mindestens folgendes Material zur Herstellung der Schubsicherung:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">4 Schwerlast-Dübel 	für M 24 Gewindestange</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">4 Gewindestangen 	Länge ca. 350 mm</span>
                              <br/>
                              <span style="background:#FFFFFF;">		Gewinde M 24</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">4 Fixierungsplatten: 	Unterkante abgerundet entsprechend Rohrleitung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">		mind zwei Bohrungen für  Schraubverbindung mit 				Flansch (M 24) </span>
                              <br/>
                              <span style="background:#FFFFFF;">		ein  Bohrung zur Fixierung der Gewindestande (M 24)</span>
                              <br/>
                              <span style="background:#FFFFFF;">		Plattenstärke mind. 32 mm </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">8 Schrauben 	M 24  Länge ca. 130 mm</span>
                              <br/>
                              <span style="background:#FFFFFF;">		zur Fixierung der Fixierplatte am Flansch </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">		</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">16 Muttern		M 24  inkl. Unterlagsscheiben </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">einschl. galvanischer Trennung der Flanschverbindung mit der Fixierplatte </span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Folgendes Bild stellt ein Ausführungsbeispiel dar:</span>
                            </p>
                            <p>
                              <image width="459" Type="image/jpeg"></image>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Schubsicherung Eingangsflansch DN 300 PN 16 </span>
                              </p>
