                  <Item ID="GW_2008023" RNoPart="0034">
                    <Qty>700.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Geotextil Robustheitsklasse 3                                  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Werkstoff: Polypropylen, einschichtig,                            </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">mechanisch verfestigter Vliesstoff, detektorgeprüft   </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Stempeldurchdrückkraft (DIN EN ISO 12236) mindestens 1800 N Fabrikat: </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Secutex 201-GRK 3 C  oder gleichwertiger Art, für Gräben aller Art.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zur Trennung der Bodenersatzkörper vom umgebenden Baugrund einschließlich Mehraufwand im senkrechten Grabenbereich bei der Grabenverfüllung und</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Abdeckung von Leichtschüttung Schaumglasschotter MISAPOR </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Standard Plus 10/50.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Ausführung und Abrechnung nach Rücksprache mit der Bauleitung!</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis</span>
                              <span style="background:#FFFFFF;">: Das Geotextil für den Zwischenlagerplatz wird in der Pos. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zwischenlagerplatz vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Geotextil Robustheitsklasse 3                                  </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008025">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis</span>
                              <span style="background:#FFFFFF;"> zu den Positionen [PERSON_121] und Leitungsquerungen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Alle Handaushubarbeiten und Sucharbeiten direkt 50 cm rundum den freizulegenden Leitungen, sind in den jeweiligen Positionen Leitungsquerungen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Für diesen Bereich wird kein [PERSON_121] vergütet!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Position [PERSON_121] ist zusätzlich zu den vorgenannten Positionen vorgesehen und wird links, rechts, vor oder nach den Leitungen zur Feststellung</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">der genauen Lage für die Freilegung verrechnet!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis zu den Positionen [PERSON_121] und Leitungsquerungen:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008026" RNoPart="0035">
                    <Qty>10.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Boden für [PERSON_121] als Zulage zu allen Aushubpositionen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">einschließlich Handaushub, ausheben, zur Freilegung von Leitungen, ab Geländeoberfläche, Aushub seitlich lagern, verfüllen und verdichten,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Aushubtiefe bis 1,75 m,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Sohlenbreite in m nach Bedarf,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung überwiegend als Suchschlitze im Bereich von Leitungen mit unbekannter, bzw. ungenauer Kenntnis der Lage.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der [PERSON_121] direkt an den Leitungsquerungen ist in die entsprechenden Positionen einzukalkulieren und wird hier nicht vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Boden für [PERSON_121] als Zulage zu allen Aushubpositionen, </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008027" RNoPart="0036">
                    <Qty>3.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Unterquerung bestehender Leitungen und Kabel</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">aller Art, für Verbau, Rohrverlegung, [ORT_030] und Grabenverfüllung </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">als</span>
                              <span style="font-weight:bold;background:#FFFFFF;"> Zulage</span>
                              <span style="background:#FFFFFF;"> zu den Aushubpositionen.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Hierbei sind sämtliche Hand-, Such-, Sicherungs- und Freilegearbeiten sowie Kabelgraben, die Wiedereinbettung mit Sand, Trassenband Kabelsteinen etc. sowie die Behinderung durch den Verbau und der sonstigen Arbeiten einzukalkulieren.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Liegen mehrere Leitungen bis zu einem Abstand von 1,0 m beieinander, so wird dies wie eine Querung behandelt.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Abrechnung: pro Unterquerung 1 mal für alle oben genannten und weiteren Arbeiten.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;"/>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis:</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="font-weight:bold;background:#FFFFFF;">Unterquerungen/Querungen von Felddrainagen und Gasleitungen werden in gesonderten Positionen vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Unterquerung bestehender Leitungen und Kabel</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008028" RNoPart="0037">
                    <Qty>10.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              <br/>
                              <span style="background:#FFFFFF;">jedoch längs laufende, parallel liegende Leitungen, freilegen, sichern,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">seitlich lagern (bei Notwendigkeit im Böschungsbereich aufhängen)</span>
                              <br/>
                              <span style="background:#FFFFFF;">neuen Graben herstellen und zuvor seitlich gelagertes Kabel wieder einbringen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung auch im Aushub/Böschungsbereich von herzustellenden Schachtbauwerken.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008031" RNoPart="0038">
                    <Qty>675.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Warn- und Ortungsband mit Aufdruck                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">"Achtung Wasserleitung" mit Metallflachband aus rostfreiem [PERSON_115] liefern und verlegen für Haupt- und Nebenleitungen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in Längstrasse zusammen 1 x,                             </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Fabrikat: Weiss, [FIRMA_039] o.ä.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Warn- und Ortungsband mit Aufdruck                     </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008032" RNoPart="0039">
                    <Qty>2.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Festpunkte für Wasserleitungsrohre bis GGG DN 300 ZMU,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">aus Beton gem. DVGW GW 310 herstellen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung in verschiedenen Teilbereichen nach Rücksprache mit dem AG.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis</span>
                              <span style="background:#FFFFFF;">: Diese Leistung wird nur bei Bedarf ausgeführt!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Die ausgeschriebenen zu verlegenden Gussleitungen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               sind alle längskraftschlüssig herzustellen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Die entsprechenden Verbindungen sind mit ausgeschrieben</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Festpunkte für Wasserleitungsrohre bis GGG DN 300 ZMU,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008033" RNoPart="0040">
                    <Qty>3.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Dynamischer Plattendruckversuch nach TP-BF [ORT_016] B 8.3                         </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">mittels dynamischem Plattendruckgerät oder leichtem Fallgewicht zur Ermittlung der Bodenverdichtung. Bei Rohrleitungsgräben in befestigten Wegen und Straßen, mindestens alle 25 m in der Leitungszone.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung nach vorheriger Rücksprache mit der Bauleitung.                </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Über Korrelation zwischen den Messwerten und der bodenspezifischen Proctordichte ist der Nachweis der Verdichtung zu führen und zu dokumentieren.           </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die aufgestellten Protokolle sind dem AG bzw. der Bauleitung zu übergeben.     </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Mindestanforderungen gemäß A-139 sind einzuhalten.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Dynamischer Plattendruckversuch nach TP-BF [ORT_016] B 8.3                         </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008034">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Der Einbau von zu liefernden Bodenaustauschmaterialien ist wie folgt vorgesehen:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Rohrumhüllung/ Grabenverfüllung sowie der Straßen- und Wegebau werden wie folgt ausgeführt: </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Untergrundverbesserung nur bei Bedarf mit [PERSON_182] 0/X, Schotter, Kies 16/32   oder Wacken, nach vorherigen Rücksprache mit der Bauleitung des AG !</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Untere Bettungsschicht Hauptwasserleitung DN 300 ZMU d = 10 cm Kies 0/16.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Seitliche und obere Abdeckung ZMU Rohr DN 300 mit anstehendem wieder        verwendbarem Bodenmaterial der HB A und B.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Restgrabenverfüllung über Abdeckung bis UK Frostschutzschicht 0/45 Straße,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">  b.z.w. UK [PERSON_182] 0/X Wegekoffer, ebenfalls mit  anstehendem wieder              verwendbarem Bodenmaterial HB A und B.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Ausnahme Restgrabenverfüllung mit zu lieferndem [PERSON_182] 0/X in Bereichen    mit nicht wieder einbaufähigem anstehenden Bodenmaterial, b.z.w. unter </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Asphaltflächen, aber nur nach vorheriger Rücksprache mit der Bauleitung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  des AG !</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- [PERSON_182] 0/45 nur im Bereich befestigter Oberflächen </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">  Asphalt oder Pflaster, in unbefestigten Bereichen wie Feldwege [PERSON_182] 0/X. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Grabenbreite in Aushubsohle nach EN 1610  GGG Rohr DN 300 ZMU</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 1,20 m senkrecht mit Verbau</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Grabenbreite nach EN 1610 geböscht 45° bis 60°,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Grabenbreite unten (OK Bettungsschicht = UK Rohr)</span>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">für 1 x GGG DN 300 ZMU oder 1 x PE DA 355,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 0,75 m ohne Verbau</span>
                              <span style="background:#FFFFFF;">, (B = Aushubsohle von 0,55 m/45° - 0,65 m/60°).</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Maße gerundet.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis für alle zu liefernden Stoffe mit Einbau im Bereich von </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">anstehendem Grundwasser:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die gesamten Mehraufwendungen für die Einhaltung aller Vorschriften bezüglich Sicherheit und Hygiene zum Schutz des Grundwassers sind in die entsprechenden Positionen Materiallieferung einzurechnen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Alle bei der Neubaumaßnahme verwendeten Stoffe, Bauteile und Bauhilfsmittel dürfen das [PERSON_029] weder hygienisch noch chemisch nachteilig beeinflussen. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Der Einbau der zu liefernden Stoffen ist in der Grundposition Wasserleitungsgraben einzukalkulieren!</span>
                            </p>
                            <p style="text-align:justify;"/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Der Einbau von zu liefernden Bodenaustauschmaterialien ist wie folgt vorgesehen:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008035" RNoPart="0041">
                    <Qty>55.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2025-04</VersDate>
                          <WCtg>002</WCtg>
                          <Group>532</Group>
                        </STLBBauCtlg>
                        <STLBBauID>
                          <ArtChrIdent>-484</ArtChrIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>334</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>41</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>2136</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3631</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>80</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3701</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>10</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3866</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3870</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>15</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>3</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>19343</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>13</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text>
                            <span style="background:#FFFFFF;">Liefern von Stoffen frei Baustelle, Mengenermittlung nach Aufmaß in eingebautem Zustand, Kies-Sand-Gemisch, natürliche Gesteinskörnung TL Gestein, Körnung 0/16, Ausführung gemäß Einzelbeschreibung,</span>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Einzelbeschreibungs-Nr </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Zusätzlicher Nachweis mit Wiegekarten.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Ausführung als untere Bettungsschicht 10 cm stark für GGG DN 300 ZMU Rohre, weitere Rohrumhüllung und Abdeckung mit anstehendem [PERSON_093].</span>
                              <br/>
                              <span style="background:#FFFFFF;">PE Rohre DA 355 werden komplette mit Kies 0/16 umhüllt.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Ausführung mit Rundkornmaterial in Bereichen ohne Grundwasser!'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;">.</span>
                            </ComplTail>
                          </TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Liefern Kies-Sand-Gemisch 0/16</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008036" RNoPart="0042">
                    <Qty>25.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <STLBBau>
                        <STLBBauCtlg>
                          <CtlgName>STLB-Bau</CtlgName>
                          <VersDate>2025-04</VersDate>
                          <WCtg>002</WCtg>
