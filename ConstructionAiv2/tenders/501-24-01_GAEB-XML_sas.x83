                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zugfeste Kupplung - DN 300 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Körper und Anpressringe aus duktilem Gusseisen GGG45 nach </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">EN - GJS - 450 - 10,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Epoxy - Pulver - Beschichtung entsprechend GSK - Standard und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">EN 14901,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">NBR oder EPDM Dichtungsring; NBR nach EN 682,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">EPDM nach EN 681-1,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Auswinkelbarkeit max. 8° je Seite; bezogen auf die Mitte des Spannbereiches,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_115] A4 (AISI 316) Uni/ Fikser,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schrauben A2 PTFE beschichtet, Muttern A2 galvanisch verzinkt</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">und Unterlegscheiben A$ AISI 316,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] Multi/Joint 3007 Plus,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">längskraftschlüssig Uni/ Fikser,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_029] PN 16 bar </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">oder gleichwertig</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">...............................................</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">angebotenes Fabrikat - [PERSON_129]</span>
                            </p>
                          </Text>
                        </DetailTxt>
