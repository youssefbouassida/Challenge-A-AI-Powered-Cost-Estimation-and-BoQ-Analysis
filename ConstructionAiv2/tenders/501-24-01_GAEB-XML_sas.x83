                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3631</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>80</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3701</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>9</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>3866</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
