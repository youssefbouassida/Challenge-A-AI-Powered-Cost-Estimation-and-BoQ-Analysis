                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Zulage zur Position Schweißverbindung Heizelement - Stumpfschweißung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">PE AD/WD 355/32,2 mm für:</span>
