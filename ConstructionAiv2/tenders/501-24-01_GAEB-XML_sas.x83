                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Leistung wie Position vor,</span>
                              <br/>
                              <span style="background:#FFFFFF;">jedoch dynamischer Lastplattenversuch mit EvD - Wert</span>
                              <br/>
                              <span style="background:#FFFFFF;">in Korrelation mit den statischen EV 2 Werten,</span>
                              <br/>
                              <span style="background:#FFFFFF;">EV 2 =&gt; 120 MN/m²  =  EVD =&gt; 65 MN/m² (ZTV- SoB),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">auf Erdplanum EV 2 =&gt; 45 MN/m2 = EVD  =&gt; 25 MN/m².</span>
                            </p>
                          </Text>
                        </DetailTxt>
