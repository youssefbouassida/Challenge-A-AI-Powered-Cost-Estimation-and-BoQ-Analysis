                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[ORT_030] für die Herstellung einer neuen Hausanschlussleitung </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">PE DA 63 </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">für das Gebäude 19.</span>
