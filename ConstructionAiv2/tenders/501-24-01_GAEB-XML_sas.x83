                  </Item>
                  <Item ID="GW_2030635" RNoPart="0013">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage</span>
                              <span style="background:#FFFFFF;"> zur Position [PERSON_006] eckig lichte Maße 2,00 x 3,00 m</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">bei Station 0+000 liefern und einbauen für:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Baustraße für Schwerlastkran wie folgt herstellen und nach Abschluss der Schachtherstellungsarbeiten wieder komplett, rückstandslos </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">beseitigen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Länge ca. 100 m von Asphaltweg bis Einbauort,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Breite mit 2 parallellaufenden Fahrspuren ca. 3,5 - 4,5 m außen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung nach Abtrag Oberboden in Wasserleitungstrasse.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung mit 2 - spurigen Stahlplatten, Maße ca. 1,80 x 6,00 , </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ca. 35 - 40 Stück o.ä. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für Befahrung mit Schwerlastkran und anderen Maschinen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Eine Ausführung als Baustraße mit Kies/Schotter ist nicht zugelassen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Der in Anspruch genommene Untergrund (Boden) ist unbedingt </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vor Auftrag Oberboden zu lockern und in den Urzustand wieder zu versetzen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Abrechnung pauschal 1 mal.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Hinweis: Sollten nur Teilleistungen in geringem Umfang erfolgen, behält sich der                AG vor, diese Position im Verhältnis der Teilleistungen zur </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">              Gesamtleistung zu vergüten.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position [PERSON_006] eckig lichte Maße 2,00 x 3,00 m</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008000" RNoPart="0014">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage</span>
                              <span style="background:#FFFFFF;"> zur Position Grabenaushub Wasserleitung Hauptleitung </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für sämtliche Mehraufwendungen im Bereich [PERSON_006],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aushub geböscht, Aushubtiefe bis ca. 3,0 m einschl. Untergrundverbesserung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">und Abgang Schachtentwässerung DA 110,  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wiederverfüllung mit anstehendem Material, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abfuhr und Beseitigung der Bodenverdrängung von </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_006] </span>
                              <span style="font-weight:bold;background:#FFFFFF;">2,00 x 3,00 m</span>
                              <span style="background:#FFFFFF;"> im lichten Maß.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Bestehende Wasserleitung GGG DN 300 suchen, zur Rohreinbindung rundum freilegen, sichern einschl. aller erforderlichen Hand- und Sucharbeiten.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Achtung: Leitung darf vor der Rohreinbindung nicht beschädigt werden!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der Mehraufwand für die Schachtversetzung und Rohreinbindung binnen 1 Arbeitstages, wird gesondert vergütet.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wasserhaltung von austretendem Leitungswasser nach Rohreinschnitt ist ebenfalls einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Suchen und freilegen eines bestehenden Betonrohres DN 100 (Schachtentwässerung bestehender Wasserschacht daneben),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Herstellen eines Zwischenplanums in der Baugrube für die Umlegung der Leitung im Bereich des neuen Schachtbauwerkes sind einzukalkulieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Rohre werden gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Abfuhr von verdrängtem Boden durch [PERSON_112] wird über die Gesamtmassenbilanz gesondert vergütet.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_112] wird gesondert vergütet.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage zur Position Grabenaushub Wasserleitung Hauptleitung </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
