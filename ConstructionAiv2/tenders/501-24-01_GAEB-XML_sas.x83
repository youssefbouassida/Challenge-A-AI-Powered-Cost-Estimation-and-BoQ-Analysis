                  <Item ID="GW_2008315" RNoPart="0012">
                    <Qty>120.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zu Pilotbohrung 2 für Fehlbohrung PE DA 355, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Zulage zur Position Pilotbohrung für Fehlbohrungen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">beinhaltet alle Erforderlichen Aufwendungen für Geräte, Material und Personal für das Zurückziehen und Wiederansetzen bzw. Umfahren von Hindernissen.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung für Ausführung und Abrechnung für die </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Unterquerung von Waldweg und 2 Grabenverdolungen DN 300,</span>
                            </p>
                            <p style="text-align:justify;">
