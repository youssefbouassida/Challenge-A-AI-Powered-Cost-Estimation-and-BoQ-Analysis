    <BoQ ID="GW_2007862">
      <BoQInfo>
        <Name>[PROJEKT_001]</Name>
        <LblBoQ>501-24-01 [PROJEKT_001] Tiefbau und Verlegung</LblBoQ>
        <Date>2025-06-27</Date>
        <OutlCompl>AllTxt</OutlCompl>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Item</Type>
          <Length>4</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Index</Type>
          <Length>1</Length>
          <Num>No</Num>
          <Alignment>left</Alignment>
        </BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="GW_2007865" RNoPart="01">
          <LblTx>
            <p>
              <span style="background:#FFFFFF;">STRASSENBAU / WIEDERHERSTELLUNG</span>
            </p>
          </LblTx>
          <NotApplBoQ>No</NotApplBoQ>
          <BoQBody>
            <BoQCtgy ID="GW_2007866" RNoPart="01">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Baustelleneinrichtung für Straßenbau / Wiederherstellungsarbeiten </span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">im gesamten Trassenbereich der geplanten [PROJEKT_001].</span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">BE Tiefbau Wasserleitung im Gewerk Tiefbau Wasserleitung</span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">BE Liefern und Verlegen der Wasserleitung im Gewerk Liefern und </span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">Verlegen der Wasserleitung.</span>
                </p>
                <p/>
                <p>
                  <span style="background:#FFFFFF;">Verkehrssicherung für </span>
                  <span style="text-decoration:underline;background:#FFFFFF;">alle</span>
                  <span style="background:#FFFFFF;"> ausgeschriebenen Leistungen </span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">- Straßenbau / Wiederherstellung</span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">- Tiefbau Wasserleitung</span>
                </p>
                <p>
                  <span style="background:#FFFFFF;">- Liefern und Verlegen der Wasserleitung</span>
                </p>
                <p/>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2031323">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Naturschutzrechtliche Vorgaben zur Durchführung der Gesamtmaßnahme</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PROJEKT_001]. </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Alle nachfolgend aufgeführten Punkte werden im Hinblick auf die Realisierung der Maßnahme Vertragsgegenstand und sind unbedingt einzuhalten:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Baustelleneinrichtungen aller Art dürfen ausschließlich nur außerhalb des</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  ausgewiesenen FFH - Gebietes (Natura2000) s. Übersicht Schutzgebiete,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  erstellt und betrieben werden. Sie müssen Straßen- und Wege nah liegen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Betankungen von Fahrzeugen und Maschinen sind ausschließlich außerhalb</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  des FFH - Gebietes (Waldbereich) , sowie der angrenzenden Bereiche </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  vorzunehmen. s. vor Baustelleneinrichtungen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Um eine Beeinträchtigung der Lebensstätten des Großen Mausohrs             (Fledermaus) im FFH - Gebiet " Obere Argen und Seitentäler" </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">  auszuschließen, sind die Arbeiten im und direkt angrenzend an das </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">  FFH - Gebiet nur bei Tageslicht auszuführen.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">  Eine Beleuchtung der Baustelle ist verboten!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Die WL - Trasse verläuft zwischen Station 0+580 und 0+600 mittels </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Spülbohrung durch das Offenlandbiotop Feuchtgebiet im Bereich der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Rückgasse Waldweg. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Der Bereich außerhalb der Rückgasse darf nicht beeinträchtigt werden und ist</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  seitens des AN mit Bauzäunen abzugrenzen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Grundsätzlich dürfen keine wassergefährdenden Stoffe auf die Baustelle </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  geliefert und eingebaut werden.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Generell hat sich der AN vor Beginn der Arbeiten genau über diese Sachverhalte auch mittels Planübersichten, ggf. vor Ort Besichtigung zu informieren.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Alle daraus resultierenden Mehrkosten sind in die Baustellengemeinkosten einzukalkulieren und werden nicht gesondert vergütet! </span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Naturschutzrechtliche Vorgaben zur Durchführung der Gesamtmaßnahme</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007867">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis für alle im Gesamt - LV ausgeschriebenen Positionen </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Baustelleneinrichtung und Verkehrssicherung.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Kalkulator hat für diese Positionen, die Baubeschreibung, die besonderen Vertragsbedingungen und die Ausführungsplanung als Kalkulationsgrundlage zu beachten.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die hier ausgeschriebene Baustelleneinrichtung und ist für das Gewerk Straßenbauarbeiten, die Verkehrssicherung für alle Leistungen im Gesamt LV</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">zu kalkulieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Eventuell zusätzliche Leistungen bei einer möglichen Winterpause sind vom AN einzukalkulieren!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Baustelleneinrichtungen der anderen Gewerke Tiefbauarbeiten Wasserleitung, Liefern und Verlegen Wasserleitung, sowie der 2 Spülbohrungen, sind in den jeweiligen Gewerken ausgeschrieben.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Die Maßnahme kann nach [PERSON_125] des AN jahresübergreifend  2025 und 2026 in bis zu 2 Durchgängen ausgeführt werden.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Es ist auch eine Ausführungszeit mit 1 Durchgang in 2025 oder 2026 </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">möglich,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Die Gesamtmaßnahme muss bis spätestens Ende Juni 2026 abgeschlossen sein.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Es können zeitgleich Arbeiten in verschiedenen Bereichen (Mehrere Einsatzstellen) durchgeführt werden,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Die Koordination der einzelnen Einsatzstellen obliegt dem AN in Absprache mit der Bauleitung des AG.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der Einsatz von gleichzeitig bis zu 2 Kolonnen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(Tiefbau und Verlegung = 1 Kolonne), an bis zu 2 örtlich getrennten Einsatz-</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">stellen ist mit einzukalkulieren!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Hierbei ist für die erforderlichen verkehrsrechtlichen Anordnungen, eine genaue Absprache mit der zuständigen Straßenverkehrsbehörde zu halten.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Die komplette inner- und überörtliche Umleitung wird durch den AN veranlasst und durchgeführt.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Es ist zwingend darauf zu achten, dass die Anlieger vor Ort eine ständige Zu- und [PERSON_043], soweit möglich, besitzen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die einzelnen Teilabschnitte sind dementsprechend festzulegen und ggf. mit Übergangsprovisorien in Kreuzungsbereichen zu realisieren.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Arbeiten im Waldbereich sind zusätzlich mit dem Zuständigen der </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Waldbesitzergemeinschaft (Herr [PERSON_079]) zu koordinieren.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Eine zusätzliche Vergütung über die ausgeschriebenen BE- und Verkehrssicherungspositionen Positionen hinaus, erfolgt nicht!</span>
                            </p>
                            <p style="text-align:justify;"/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis für alle im Gesamt - LV ausgeschriebenen Positionen </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007868" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1010110721</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Geräte, Werkzeuge und sonstige Betriebsmittel, die zur</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vertragsgemäßen Ausführung der Bauleistungen erforder-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">lich sind, auf die Baustelle bringen, bereitstellen und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- soweit der Geräteeinsatz nicht gesondert vergütet</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">wird - betriebsfertig aufstellen einschl. der dafür</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">notwendigen Arbeiten. Die erforderlichen festen Anlagen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">herstellen. Baubüros, Unterkünfte, Werkstätten, Lager-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schuppen und dgl., soweit erforderlich, antransportie-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ren, aufbauen und einrichten. Strom-, [PERSON_029]-, Fern-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sprechanschluss sowie Entsorgungseinrichtungen und dgl.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für die Baustelle, soweit erforderlich, herstellen. Bei</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bedarf Lagerplätze, sonstige Platzbefestigungen und We-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ge im Baustellenbereich anlegen. Oberbodenarbeiten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Beseitigen von Aufwuchs für die Baustellenein-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">richtung, soweit erforderlich, ausführen. Flächen be-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schaffen, sofern die vom AG zur Verfügung gestellten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nicht ausreichen. Kosten für Vorhalten, Unterhalten und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Betreiben der Geräte, Anlagen und Einrichtungen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Mieten, Pacht, Gebühren und dgl. werden nicht</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit dieser Pauschale, sondern mit den Einheitspreisen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">der betreffenden Teilleistungen vergütet. Soweit nicht</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für bestimmte Leistungen für das Einrichten der Bau-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">stelle gesonderte Positionen im Leistungsverzeichnis</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">enthalten sind, gilt die Pauschale</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für alle Leistungen dieses Abschnittes des Leistungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">verzeichnisses.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Zufahrt zur Baustelle vorhanden.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Baustelle einrichten</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Dies.LV-Abschn.*Zufahrt vorh.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007869" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1010111202</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Baustelle von allen Geräten, Anlagen, Einrichtungen und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">dgl. räumen. Benutzte Flächen und Wege entsprechend dem</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ursprünglichen Zustand herrichten. Soweit nicht für be-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">stimmte Leistungen für das Räumen der Baustelle geson-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">derte Positionen im Leistungsverzeichnis enthalten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sind, gilt die Pauschale</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für alle Leistungen dieses Abschnittes des Leistungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">verzeichnisses.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Baustelle räumen</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Dies. LV-Abschn.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007871" RNoPart="0003">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Einrichtungen zur Verkehrssicherung und Verkehrsregelung nach StVO  bei Bauarbeiten auf einbahnigen Straßen für </span>
                              <span style="font-weight:bold;background:#FFFFFF;">innerörtliche Verkehrsumleitung</span>
                              <span style="background:#FFFFFF;"> einschließlich Abschrankung und Beleuchtung der Baustelle für die gesamte Bauzeit bei Voll- und Teilsperrung des Durchgangsverkehrs s. Hinweisposition, sowie die Beschaffung der verkehrsrechtlichen Anordnung, einschl. Gebühr.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Aufbauen, ständig unterhalten und betreiben, ggf. umsetzen und abbauen, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung für die gesamte Bauwerkserstellung, für alle Gewerke.  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Beschädigte und abhanden gekommene Teile ersetzen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Der Anliegerverkehr wird an der Baustrecke ermöglicht.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">60 v.H. der Pauschale werden nach betriebsfertigem Aufbau, der Rest nach Abbau der Verkehrssicherungseinrichtungen vergütet.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Sicherung mit elektrischen Warnleuchten</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Verkehrszeichen, -einrichtungen und Geräte werden vom AN gestellt und vorgehalten.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Werden für das Abdecken von Baugruben und Gräben ( zum provisorischen Überleiten des Verkehrs ) glatte Stahlplatten verwendet, so hat der Verkehrssicherungspflichtige durch Beschilderung auf die damit verbundenen Gefahren hinzuweisen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die zusätzlichen Technischen Vertragsbedingungen (ZTV-A), sowie die Richtlinien für die Sicherung von Arbeitsstellen an Straßen ( RSA 95 ) sind Grundlage des Bauvertrages und strikt einzuhalten.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Ausführung nach vom AN vorgelegten Verkehrszeichenplan.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Kontrolle der gesamten Arbeitsstellensicherung gem. ZTV - SA zweimal täglich, an arbeitsfreien Tagen einmal täglich durchführen, erfassen und dokumentieren.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis: Ausführung und Abrechnung für alle ausgeschriebenen Gewerke                 in dieser Position, eine Abrechnung für einzelne Gewerke </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">                erfolgt nicht gesondert!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Einrichtungen zur Verkehrssicherung und Verkehrsregelung nach StVO  bei Bauarbeiten auf einbahnigen Straßen für innerörtliche Verkehrsumleitung einschließlich Abschrankung und Beleuchtung der Baustelle für die gesamte Bauzeit bei Voll- und Teilsperrung des Durchgangsverkehrs s. Hinweisposition, sowie die Beschaffung der verkehrsrechtlichen Anordnung, einschl. Gebühr.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007872" RNoPart="0004">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">jedoch Einrichtungen zur Verkehrssicherung und Verkehrsregelung nach StVO,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Überörtliche Verkehrsumleitung.</span>
                              <span style="background:#FFFFFF;">	</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung bei Vollsperrungen von Gemeindeverbindungswegen, landwirtschaftlichen Wegen und Waldwegen als Verbindungs- und Zufahrtswege für die Landwirtschaft, Waldbewirtschaftung und weiterem Verkehr in kleinerem Rahmen. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Dem Kalkulator wird dringend eine Besichtigung vor Ort empfohlen!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007875" RNoPart="0005">
                    <Qty>60.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Bauzaun H = 2,0 m liefern, aufstellen, unterhalten und wieder nach Abschluss der Arbeiten beseitigen.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">In Bereichen zusätzlich zu den Grundabsperreinrichtungen, welche in der Position Baustellensicherung einzukalkulieren sind. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Ausführung und Abrechnung nur bei vom AG zusätzlich geforderten </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Korridoren, wie provisorische Durchgänge oder separate Zufahrten, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">ausschließlich nach vorheriger Rücksprache mit der Bauleitung!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Bauzaun H = 2,0 m liefern, aufstellen, unterhalten und wieder nach Abschluss der Arbeiten beseitigen.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007885" RNoPart="0006">
                    <Qty>5.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Provisorische Überfahrten/Durchfahrten im Ausführungsbereich für Anlieger und oder Waldarbeiten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">herstellen und wieder beseitigen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung mit Stahlplatten und/oder Kies ein- und wieder ausbauen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nach [PERSON_125] des AN.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abrechnung nur bei erfolgter Ausführung und Zufahrt/Durchfahrt,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 x für die gesamte Maßnahme nach Aufmaß!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Provisorische Überfahrten/Durchfahrten im Ausführungsbereich für Anlieger und oder Waldarbeiten</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2007892" RNoPart="02">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">[ORT_030] Straßen, Straßennebenflächen, Waldwege </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2007893">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Für die Ausführung gelten                              </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">die Zusätzlichen Technischen Vertragsbedingungen und   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Richtlinien für [ORT_030] im Straßenbau (ZTVE-StB),  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">die Zusätzlichen Technischen Vertragsbedingungen und   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Richtlinien für die Ausführung von Tragschichten im </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Straßenbau (ZTVT-StB),                                 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">die Zusätzlichen Technischen Vertragsbedingungen und   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Richtlinien für die Ausführung von Bodenverfestigungen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">und Bodenverbesserungen im Straßenbau (ZTVV-StB),      </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">die Technischen Lieferbedingungen für Mineralstoffe    </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">im Straßenbau (TL Min-StB).                            </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Zusätzlichen Technischen Vertragsbedingungen und   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Richtlinien für Aufgrabungen in Verkehrsflächen (ZTVA-StB).                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Das Merkblatt für das Verfüllen von Leitungsgräben.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Des Weiteren folgende DIN Normen mit entsprechenden ATV`:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] außerhalb von Gebäuden</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (für Oberbodenarbeiten)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Für die Ausführung gelten                              </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007894">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Die Leistungen werden abgerechnet nach den jeweilig zuständigen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN Normen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] außerhalb von Gebäuden</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (für Oberbodenarbeiten)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Die Leistungen werden abgerechnet nach den jeweilig zuständigen</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007895">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Die Mengenermittlung für die Abrechnung der Leistungen erfolgt nach Aufmaß und Ausführungszeichnungen.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Die Mengenermittlung für die Abrechnung der Leistungen erfolgt nach Aufmaß und Ausführungszeichnungen.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007896">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Bei der Ermittlung für Bodenaushub wird abgezogen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">das Raummaß der Leitungen mit einem äußeren Querschnitt </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von mehr als 0,1 m²,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">das Raummaß von Baukörpern mit einem Rauminhalt </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von mehr als 0,10 m³.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Bei der Ermittlung für Bodenaushub wird abgezogen</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007897">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweise zu allen [ORT_030] im Bereich [PROJEKT_001]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">zum sachgerechten Umgang mit kulturfähigem Bodenmaterial.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Grundlage hierfür bildet das erstellte Bodenschutzkonzept für diese </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Maßnahme.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizont Ah Mutterboden/ Kulturfähiger Oberboden</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Sachgerechter Umgang Oberboden ab- und wieder auftragen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Sofern Oberboden in Haufwerken zwischen gelagert wird, sind im Vorfeld des</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Oberbodenabtrags so gut wie möglich, oberirdische Pflanzenteile zu entfernen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">um schädliche Umsetzungen bei der Zwischenlagerung in Haufwerken</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">minimieren zu können.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Oberbodenmieten sind in einer lockeren Schüttung, mit einer max. Höhe</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">von 2,00 m anzulegen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Miete ist trapezförmig zu profilieren und muss geglättet werden, um witterungsbedingte Vernässung zu vermeiden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bei der Zwischenlagerung soll die biologische Aktivität des Oberbodens </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">erhalten bleiben.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Notwendig sind daher ausreichende Belüftung, Schutz vor Vernässung und bei länger lagerndem Oberbodenmaterial eine Bepflanzung mit Lippenblütlern.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizont Bv Kulturfähiger [PERSON_057] unterhalb vom Ah Horizont,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">bis ca. - 0,80 m unter Gel OK</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_057] ausheben, seitlich lagern und wieder einbauen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Material kann und soll zum An- und Wiederverfüllen unter einer ausreichend mächtigen Ah - Schicht verwendet werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der kulturfähige [PERSON_057] (Verwitterungslehm/[PERSON_033])) ist mit Sorgfalt aus- und wieder einzubauen, eine zu starke Verdichtung und dadurch bedingte </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Gefügeveränderung und Vernässung muss vermieden werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Unterbodenmieten sind mit geglätteten Flanken von max. 3 m Höhe anzulegen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizont C I</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ab einer Tiefe von - 0,80 m unter Gel OK äolisch geprägte </span>
                              <span style="font-weight:bold;background:#FFFFFF;">"Deckschichten"</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Gering bis schwach tonige, sandige, sowie schwach kiesige Schluffe.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizont C II </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Tieferer Untergrund Decklehme und Moränesedimente </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Moränensand, Moränenkies und Grundmoräne.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Generelle Anforderungen für den Umgang mit allen Horizonten:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die einzelnen Horizonte sollten nach Möglichkeit wieder in ihrer ursprünglichen Reihenfolge eingebaut werden, also A über B über C.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Eine Durchmischung des Materials der einzelnen Horizonte ist zu vermeiden.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Verdrängter, übriger Aushub muss auf einen Lagerplatz in Haufwerke </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">aufgesetzt werden nach EBV/VwV Baden Württemberg beprobt und anschließend zu einer geeigneten Verwertungsstelle verbracht werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hierfür sind in der Ausschreibung entsprechende Positionen vorgesehen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Minimierung der Flächenbefahrung und maximale Reduktion der Transportstrecken, Einsatz von Kettenbaggern mit langstieligen Löffeln; </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Verzicht auf Schubraupen, Einsatz von Schleppern mit günstigem Reifendruck auf sensiblem Untergrund.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Kein Befahren der umgebenden Freiflächen = Tabuflächen (z.B. landwirtschaftliche Flächen); unvermeidliche Überfahrung nur mit Fahrzeugen geringer Bodenpressung (Kettenfahrzeuge, Traktoren mit Muldenkipper, Radfahrzeuge nur in Verbindung mit geeigneten Unterlagen).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Im Bereich der Leitungstrasse in öffentlichen Wegen mit Ausführung </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">senkrecht im Verbau, hat der AN mit Arbeitsabläufen im </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Überkopfverfahren, sowohl für den Wegebau, wie auch für den Tiefbau Wasserleitung zu kalkulieren.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Ein entsprechender zusätzlicher Einsatz von Maschinen und Personal ist hier unbedingt zu berücksichtigen!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Die Gesamtlänge der betroffenen Weg- und Verlegestrecken im verbauten Graben beträgt ca. 90 - 100 m, davon ca. 80 m im Waldwegbereich von</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">ca. Station 0+990 - bis 1+070 Bauende.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Die Ausführung der Arbeiten generell, sind nach vorheriger Abstimmung mit den jeweiligen Grundstücksbesitzern, b.z.w. Pächtern der betroffenen Grundstücke auch im Hinblick auf notwendige Wiesenschnitte und Waldarbeiten auszuführen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Dies gilt für Abtrags- und Auftragsflächen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Dem Kalkulator wird dringend empfohlen, Einsicht in das entsprechend,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">vorliegende Bodenschutzkonzept zu nehmen!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis: Im Gewerk Tiefbau Wasserleitung ist eine Erschwernisposition                     für alle Mehraufwendungen, für alle Gewerke im Hinblick auf das                  einzuhaltende Bodenschutzkonzept ausgeschrieben.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Dort hat der Kalkulator den gesamten Mehraufwand der </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">                Gesamtmaßnahme einzukalkulieren!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweise zu allen [ORT_030] im Bereich [PROJEKT_001]</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007898">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis</span>
                              <span style="background:#FFFFFF;"> zur Abfuhr und Weiterverwertung/Deponierung von</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">zwischengelagertem, beprobtem [PERSON_093] Straßen- und Wegebau:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt über die entsprechenden Positionen im Gewerk Tiefbau Wasserleitung!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hier im Gewerk Straßen- und Wegebau sind nur die Leistungen Aushub und Abfuhr auf den Zwischenlagerplatz zur Beprobung ausgeschrieben.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Der Kalkulator hat dies zu beachten!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis zur Abfuhr und Weiterverwertung/Deponierung von</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2019551">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Hinweis zu allen [ORT_030]:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Tiefbauarbeiten sind im Wesentlichen nach der neuen DIN 18300 (2015-08)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[ORT_030] in Anlehnung an die DIN 4020 Geotechnische Untersuchungen für bautechnische Zwecke mit den entsprechenden Homogenbereichen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ausgeschrieben.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Grundlage ist der Geotechnische Bericht von fm - Geotechnik</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ingenieurbüro für Geotechnik.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die hier aufgeführten Homogenbereiche sind in den maßgebenden </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Aushubpositionen detailliert mit ihren jeweiligen, geschätzten anteiligen Mengen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">beschrieben:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A1: Auffüllungen Kies</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   3, 4, </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A2: Auffüllung [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 1: Torf</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   2/4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 2:  Verwitterungslehm/angewitterte Grundmoräne</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 3:  Moränesand</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   2,3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 4:  Moränekies</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 5:  Grundmoräne, [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           Bodenklasse DIN 18300 (2012-09)   4</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Da die angetroffenen bindigen Böden teilweise wasserempfindlich sind, können diese Böden bei nicht fachgerechter Zwischenlagerung und bei starken Niederschlägen während eines Transports oder durch mechanische Beanspruchung aufweichen, so dass diese ggf. in die Bodenklasse 2 nach DIN 18300 (2012-09) b.z.w. in eine breiige Konsistenz übergehen können.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Der AN</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">hat Sorge dafür zu tragen,</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">dass diese empfindlichen Böden nicht</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">in die Bodenklasse 2 übergehen.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Eine Vergütung der Bodenklasse 2 erfolgt nicht!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis zu allen [ORT_030]:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2019756">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Übersicht der Homogenbereiche im Straßen- und Wegebau mit einer Aushubtiefe bis ca, 0,80 m ab OK Gelände:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogenbereich 1</span>
                              <span style="background:#FFFFFF;">, mit 3 Bodengruppen, Bodengruppe 1 GU DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 2 GU* DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 3 UL DIN 18196 (leicht plastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 90,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 1 Auffüllung,Kies Bkl. 3,4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 40 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 50 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 70 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Lagerungsdichte mitteldicht,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogenbereich 2</span>
                              <span style="background:#FFFFFF;">, mit 2 Bodengruppen, Bodengruppe 1 UL DIN 18196 (leicht plastischer [PERSON_033]), Bodengruppe 2 UM DIN 18196 (mittelplastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 10,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 2 Auffüllung, [PERSON_033] Bkl. 4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 20 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 55 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 75 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 10 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 30 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert von 20 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert bis 40 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic von 0,5,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic bis 0,75,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip von 4 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip bis 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Übersicht der Homogenbereiche im Straßen- und Wegebau mit einer Aushubtiefe bis ca, 0,80 m ab OK Gelände:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007899" RNoPart="0001">
                    <Qty>100.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Boden für Verkehrsflächen, ab Geländeoberfläche,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nach Abtrag von Oberflächenbefestigungen (Asphalt), falls vorhanden,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">oder ab OK Kies- und Waldwege,</span>
                              <br/>
                              <span style="background:#FFFFFF;">profilgerecht lösen und direkt laden, Arbeiten mit Gerät, auf LKW des AN laden, transportieren und auf Zwischenlager des AN bis ca. 5 KM einfache  Entfernung zur Beprobung fahren und abladen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Bereich Verkehrsflächen (Zufahrten Ortswege/Straßen mit Asphaltbefestigung) und unbefestigte Wald- und Verbindungswege (Kieswege).</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Ausführung und Abrechnung nur außerhalb vom Wasserleitungsgraben!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Innerhalb vom Wasserleitungsgraben erfolgt die Abrechnung Aushub im Gewerk Tiefbau Wasserleitung bis OK Gel.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die Wiederaufnahme und Weiterverwertung/Entsorgung nach Analyseergebnis wird im Gewerk Tiefbau Wasserleitung in entsprechenden Positionen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">gesondert vergütet.  </span>
                              <br/>
                              <span style="background:#FFFFFF;">Abtragtiefe bis 0,80 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung einschl. Herstellen des Erdplanums zur Aufnahme der Kiesschicht,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Straßen- und Wegebau.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Mengenermittlung nach Aufmaß und Abtragprofilen.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Hinweis:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Sollten im Zuge der Baumaßnahme Aushubmengen nicht auf das </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Zwischenlager, sondern direkt von der Aushubstelle auf Weiterverwertungsstellen nach Angabe der Gemeinde oder Landwirte gefahren werden, so sind diese Mengen zur Abrechnung für die Gesamtmassenbilanz </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nach Fuhrberichten zu dokumentieren.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Die Abrechnung erfolgt ebenfalls hier in dieser Position!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Vor Ausführung ist die Bauleitung des AG zu informieren!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Betreffende Homogenbereiche nachfolgend:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogenbereich 1</span>
                              <span style="background:#FFFFFF;">, mit 3 Bodengruppen, Bodengruppe 1 GU DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 2 GU* DIN 18196 (Kies-[PERSON_033]-Gemisch), Bodengruppe 3 UL DIN 18196 (leicht plastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 90,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 1 Auffüllung,Kies Bkl. 3,4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 40 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 50 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 70 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Lagerungsdichte mitteldicht,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogenbereich 2</span>
                              <span style="background:#FFFFFF;">, mit 2 Bodengruppen, Bodengruppe 1 UL DIN 18196 (leicht plastischer [PERSON_033]), Bodengruppe 2 UM DIN 18196 (mittelplastischer [PERSON_033]), Tiefe oberer Horizont des Homogenbereiches von 0 m, Tiefe unterer Horizont des Homogenbereiches bis 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">geschätzter Anteil des Homogenbereiches an der Gesamtaushubmenge 10,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">ortsübliche Bezeichnung Homogenbereich A 2 Auffüllung, [PERSON_033] Bkl. 4, nach DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Baumaßnahme der Geotechnischen Kategorie 2 DIN 4020, Kornverteilungsbereich DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] unterer Wert 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] oberer Wert 20 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] unterer Wert 55 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] oberer Wert 75 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand unterer Wert 10 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Sand oberer Wert 30 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies unterer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteile Kies oberer Wert 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) unterer Wert 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Massenanteil Steine DIN EN ISO 14688-1 (Co) oberer Wert 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Feuchtdichte Boden DIN EN ISO 17892-2 oder DIN 18125-2 über 2000 bis 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert von 20 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Scherfestigkeit undräniert bis 40 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Wassergehalt bis 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic von 0,5,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Konsistenzzahl DIN EN ISO 17892-12 Ic bis 0,75,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip von 4 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Plastizitätszahl DIN EN ISO 17892-12 Ip bis 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- Organischer Masseanteil DIN 18128 größer 5 %.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Boden Verkehrsfläche lösen mit Gerät laden transp. LKW AN entsorgen Vergüt.Entsorg. AN AVV170504 Abtrag-T 1m GW GI GU GT GU*</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007900" RNoPart="0002">
                    <Qty>85.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">jedoch </span>
                              <span style="font-weight:bold;background:#FFFFFF;">verwertbares [PERSON_112]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für Verkehrsflächen profilgerecht lösen, innerhalb der Gesamtmaßnahme </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. eventuell  erforderlichem Zwischenlager nach [PERSON_125] des AN, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">umfahren </span>
                              <span style="font-weight:bold;background:#FFFFFF;">und wieder als Restgrabenverfüllung oder Untergrundverbesserung in Gräben einbauen und verdichten.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Abtragtiefe ca. 0,25 bis 0,30 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Mengenermittlung nach Abtragprofilen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung einschließlich Herstellen von Erdplanum.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bereich Verkehrsflächen (Zufahrten Ortswege/Straßen, Hofzufahrten,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Angleichungen) und unbefestigte Wald- und Verbindungswege </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung und Abrechnung nur nach ausdrücklicher Rücksprache mit der Bauleitung! </span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Leistung wie Position zuletzt in vollem Wortlaut beschrieben,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
