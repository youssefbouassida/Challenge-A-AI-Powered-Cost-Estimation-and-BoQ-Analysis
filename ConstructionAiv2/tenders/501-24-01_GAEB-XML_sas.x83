                  <Remark ID="GW_2008496">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_076]</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">[PERSON_076]</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2008497">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis</span>
                              <span style="background:#FFFFFF;"> für die Lieferung und Verlegung der GGG Rohre DN 300 ZMU im </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hinblick auf die Ausführung des Grabens und der Muffenverbindungen:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Die folgenden Position ist für die Verlegung in verbaute und geböschte Gräben zu kalkulieren!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Der Anteil verbauter Graben beträgt   ca.   95 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">der Anteil geböschter Graben beträgt ca.  580 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">In der Grundposition sind die duktilen [PERSON_076] DN 300 ZMU einschl.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Muffenverbindung mit Dichtung [PERSON_129] TYTON/STD ausgeschrieben.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Die GGG Rohre DN 300 ZMU werden zusätzlich komplett mit zugfesten </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Verbindungen [PERSON_129] Standard Vi oder SIT Dichtung mit </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Kennzeichnungsring verlegt.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Hierfür ist eine Zulageposition ausgeschrieben.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Der Kalkulator hat dies zu beachten.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Hinweis für die Lieferung und Verlegung der GGG Rohre DN 300 ZMU im </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
