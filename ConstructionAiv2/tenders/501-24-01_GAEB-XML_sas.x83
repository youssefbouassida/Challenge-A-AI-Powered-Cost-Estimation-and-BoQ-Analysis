                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <ComplTSB>Yes</ComplTSB>
                        <DetailTxt>
                          <Text>
                            <span style="background:#FFFFFF;">Druckrohr aus duktilem Gusseisen für Trinkwasser, DIN EN 545, DN 300, Muffenverbindung [PERSON_129] TYTON/STD,</span>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="21743">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">zulässiger Bauteilbetriebsdruck PFA </span>
                            </ComplCaption>
                            <ComplBodyDec Value="16"/>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'16'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;"> bar, Baulängen von 6 m, werkseitige Faserzementmörtel-Umhüllung, werkseitige Zementmörtelauskleidung, Verlegung DIN EN 805, in vorh. Graben, abgeböscht, Bettung wird gesondert vergütet, Verlegetiefe über 1,75 bis 4 m, Ausführung gemäß Einzelbeschreibung,</span>
                            </ComplTail>
                          </TextComplement>
                          <Text>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="12" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Einzelbeschreibungs-Nr </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Verlegung gilt auch für verbaute Gräben.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Rohr einschl. Tytondichtung,</span>
                              <br/>
                              <span style="background:#FFFFFF;">zugfeste Vebindungen werden gesondert vergütet.'</span>
                            </ComplBody>
                            <ComplTail/>
                          </TextComplement>
                          <TextComplement Kind="Bidder" MarkLbl="13" Empty="Yes" ArtChrIdent="-24">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Hersteller und [PERSON_129] </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'....................................................'</span>
                            </ComplBody>
                            <ComplTail>
                              <br/>
                              <span style="background:#FFFFFF;">vom Bieter einzutragen.</span>
                            </ComplTail>
                          </TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Druckrohr dukt.Guss TW DN300 Muffenverb. PFA 16 bar Graben abgeböscht T 1,75-4m</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
