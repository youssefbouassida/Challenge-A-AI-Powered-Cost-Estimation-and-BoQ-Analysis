                  <Item ID="GW_2013463" RNoPart="0004">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Sickerschacht für Entwässerungsleitung von Wasserleitungsschächten </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">rund DN 1000</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Schacht komplett ohne Schachtabdeckung</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">liefern und einbauen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Schachttiefe bis ca. 1,60 m OK Konus 625/1000, bis UK Schachtringe</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN EN 1917, DIN 4034 - 1, [PERSON_129] 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">FBS-Qualität oder vergleichbar,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschließlich:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtdurchführung für PE DA 110 wird vor Ort hergestellt und gesondert </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  vergütet.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtringe H = ca. 1,00 m ohne Boden auf Betonfundament versetzen,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Betonfundament 30 x 45 mit Beton C 20/25 umläufig unter Schachtringe </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  komplett herstellen, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Teilverfüllung Schacht DN 1000, h = ca .50 - 60 cm mit zu lieferndem </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Sickerkies 16/32.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtkonus DN 1000 mit Öffnung DN 625 mm, exzentrisch, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  2 Auflagerringe DN 625 mm mit Schubsicherung,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Steigbügel [PERSON_115] ca. 6 Stück.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Schachtabdeckung für Wasserleitungen </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> l.W. 625 mm </span>
                              <span style="background:#FFFFFF;">s. gesonderte Position,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  </span>
                              <span style="font-weight:bold;background:#FFFFFF;">wird gesondert vergütet.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Mehraufwand Aushub Schacht seitlich im Bereich geböschter Graben 45° Hauptwasserleitung ist hier ebenfalls einzukalkulieren!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Ausführung s. auch Zeichnung!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Sickerschacht bei ca. Station 0+100 Asphaltweg.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Sickerschacht für Entwässerungsleitung von Wasserleitungsschächten </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2031306" RNoPart="0005">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_006] rund DN 1200</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Schacht komplett ohne Schachtabdeckung</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">liefern und einbauen</span>
                            </p>
