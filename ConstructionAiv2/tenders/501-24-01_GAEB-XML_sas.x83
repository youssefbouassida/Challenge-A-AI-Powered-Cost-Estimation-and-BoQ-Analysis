                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Plattendruckversuche</span>
                              <br/>
                              <span style="background:#FFFFFF;">für Erdplanum bzw. Frostschutzschicht,</span>
                              <br/>
                              <span style="background:#FFFFFF;">einschließlich Auswertung und Protokoll.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Ev1/Ev2 =&lt; 2,2 muss erreicht werden.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Statische Ausführung mit Druckplatte.</span>
                              <br/>
                              <span style="background:#FFFFFF;">EV 2 Wert  =&gt; 120 MN/m²,</span>
                            </p>
                            <p>
