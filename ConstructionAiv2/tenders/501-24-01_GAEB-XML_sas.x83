        <BoQCtgy ID="GW_2008479" RNoPart="03">
          <LblTx>
            <p>
              <span style="background:#FFFFFF;">LIEFERN UND VERLEGEN DER WASSERLEITUNG OFFENE BAUWEISE</span>
            </p>
          </LblTx>
          <NotApplBoQ>No</NotApplBoQ>
          <BoQBody>
            <Remark ID="GW_2008480">
              <Description>
                <CompleteText>
                  <DetailTxt>
                    <Text>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Für die ausgeschriebenen Leistungen verlangt der Auftraggeber  einen Qualifikationsnachweis.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Die Rohrleitungsfirma muss dazu den fachlichen Eignungsnachweis erbringen durch:</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">1. Die DVGW - Zertifizierung, oder</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">2. dass, von ihm ausgeführte Leistungen in den letzten drei abgeschlossenen Geschäftsjahren mit den vergebenen Leistungen vergleichbar sind.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">Dazu sind Referenzen der entsprechenden Auftraggeber bei der Angebotsabgabe mit einzureichen!</span>
                      </p>
                      <p style="text-align:justify;"/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p/>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <Remark ID="GW_2008481">
              <Description>
                <CompleteText>
                  <ComplTSB>Yes</ComplTSB>
                  <DetailTxt>
                    <Text>
                      <p>
                        <span style="font-weight:bold;background:#FFFFFF;">Hinweis zur Kalkulation "Hersteller/[PERSON_129] XXXX / XXXX oder gleichwertig":</span>
                      </p>
                      <p>
                        <span style="background:#FFFFFF;">Trägt der Bieter bei der Vorgabe eines Produkts</span>
                      </p>
                      <p/>
                      <p>
                        <span style="background:#FFFFFF;">Hersteller/[PERSON_129] XXXX / XXXX</span>
                      </p>
                      <p>
                        <span style="background:#FFFFFF;">oder gleichwertig</span>
                      </p>
                    </Text>
                    <TextComplement Kind="Bidder" MarkLbl="60" Empty="Yes" ArtChrIdent="-25">
                      <ComplCaption>
                        <span style="background:#FFFFFF;">Hersteller/[PERSON_129] </span>
                      </ComplCaption>
                      <ComplBody>
                        <span style="background:#FFFFFF;">'....................................................'</span>
                      </ComplBody>
                      <ComplTail>
                        <br/>
                        <span style="background:#FFFFFF;">vom Bieter einzutragen.</span>
                      </ComplTail>
                    </TextComplement>
                    <Text>
                      <p/>
                      <p>
                        <span style="background:#FFFFFF;">kein von ihm zu lieferndes Produkt ein, wird die Produktvorgabe des Auftraggebers bindend.</span>
                      </p>
                      <p/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p>
                          <span style="background:#FFFFFF;">Hinweis zur Kalkulation "Hersteller/[PERSON_129] XXXX / XXXX oder gleichwertig":</span>
                        </p>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <Remark ID="GW_2008482">
              <Description>
                <CompleteText>
                  <DetailTxt>
                    <Text>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Hinweise zur Rohrleitung und Abrechnung:</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Werkseitiger Rohrschutz                                </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">für Druckrohre, Form- und Verbindungsstücke            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">aus duktilem Gusseisen,                                 </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Außenschutz</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">werkseitige Faserzementmörtel-Umhüllung,  Zementmörtelauskleidung</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">für das Hauptrohr DN 300,                                            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">DIN 30674-3 Zinküberzug mit Deckbeschichtung für Übergangs- und </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Formstücke      </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Innenschutz                                            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">werkseitige Zementmörtelauskleidung DIN 2614.</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Für sämtliche nachfolgende Armaturen, Form- und Verbindungsstücke sind bei Flanschverbindungen die Flachdichtungen und Schrauben, bei Muffenverbindungen die dazu gehörigen Dichtringe für Guss-, PVC oder PE- Rohre in den Einheitspreisen mit einzukalkulieren. </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Anzubieten sind die Armaturen, Formstücke und Rohre als liefern, abladen und fertig montiert  verlegen.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Zugsicherungen bei Muffenverbindungen werden, wenn nicht in der Grundposition beschrieben, gesondert als Zulage vergütet.</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Sämtliche Form- und Verbindungsstücke sind als Zulage zur </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Grundposition Druckrohrleitung zu kalkulieren.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Bei der Abrechnung werden diese Form- und Verbindungsstücke durchgemessen!</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Rohrschnitte an der neuen Rohrleitung an Rohrstücken ohne Muffe vor / nach Bögen, oder Kreuzungs- und Übergabepunkten, sind in die jeweiligen dafür erforderlichen Form- und Verbindungsstücke einzukalkulieren!</span>
                      </p>
                      <p style="text-align:justify;"/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p>
                          <span style="background:#FFFFFF;">Hinweise zur Rohrleitung und Abrechnung:</span>
                        </p>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <BoQCtgy ID="GW_2008483" RNoPart="01">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Baustelleneinrichtung Liefern und Verlegen der Wasserleitung</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2008484" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1310110721</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Geräte, Werkzeuge und sonstige Betriebsmittel, die zur</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vertragsgemäßen Ausführung der Bauleistungen erforder-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">lich sind, auf die Baustelle bringen, bereitstellen und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- soweit der Geräteeinsatz nicht gesondert vergütet</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">wird - betriebsfertig aufstellen einschl. der dafür</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">notwendigen Arbeiten. Die erforderlichen festen Anlagen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">herstellen. Baubüros, Unterkünfte, Werkstätten, Lager-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schuppen und dgl., soweit erforderlich, antransportie-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ren, aufbauen und einrichten. Strom-, [PERSON_029]-, Fern-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sprechanschluss sowie Entsorgungseinrichtungen und dgl.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für die Baustelle, soweit erforderlich, herstellen. Bei</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Bedarf Lagerplätze, sonstige Platzbefestigungen und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Wege im Baustellenbereich anlegen. Oberbodenarbeiten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Beseitigen von Aufwuchs für die Baustellenein-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">richtung, soweit erforderlich, ausführen. Flächen be-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">schaffen, sofern die vom AG zur Verfügung gestellten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">nicht ausreichen. Kosten für Vorhalten, Unterhalten und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Betreiben der Geräte, Anlagen und Einrichtungen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">einschl. Mieten, Pacht, Gebühren und dgl. werden nicht</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">mit dieser Pauschale, sondern mit den Einheitspreisen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">der betreffenden Teilleistungen vergütet. Soweit nicht</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für bestimmte Leistungen für das Einrichten der Bau-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">stelle gesonderte Positionen im Leistungsverzeichnis</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">enthalten sind, gilt die Pauschale</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für alle Leistungen dieses Abschnittes des Leistungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">verzeichnisses.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Zufahrt zur Baustelle vorhanden.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Baustelle einrichten </span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Dies.LV-Abschn.*Zufahrt vorh.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008485" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1010111202</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Baustelle von allen Geräten, Anlagen, Einrichtungen und</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">dgl. räumen. Benutzte Flächen und Wege entsprechend dem</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ursprünglichen Zustand herrichten. Soweit nicht für be-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">stimmte Leistungen für das Räumen der Baustelle geson-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">derte Positionen im Leistungsverzeichnis enthalten</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sind, gilt die Pauschale</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">für alle Leistungen dieses Abschnittes des Leistungs-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">verzeichnisses.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Baustelle räumen</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Dies. LV-Abschn.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2008487" RNoPart="02">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Rohrleitungsbau DN 300 WV Offene Bauweise</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2010164" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage</span>
                              <span style="background:#FFFFFF;"> - </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Position für alle Rohrverlege- und Montagearbeiten</span>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">im Anschlussbereich neue Leitung/</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vorhandene Bestandsleitung GGG DN 300 am Baubeginn DZ NZ Isnyberg 400-401. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Folgende Leistungen sind einzukalkulieren:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Die gesamte Anschlussleistung Rohrlieferung- und Montage, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  einschl. der erforderlichen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Mitarbeiterstärke (bis zu 2. Kolonnen), einschl. aller erforderlichen Maschinen,    Werkzeuge und Materialien (Schachtinstallation, Formstücke u.a.) muss </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  innerhalb eines Zeitraumes von 6 - max. 8 h am selben Arbeitstag ausgeführt </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  und abgeschlossen werden.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Alle zeitlich erforderlichen Koordinationsarbeiten ([PERSON_029] absagen, abstellen</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  wieder in Betrieb gehen) sind rechtzeitig vor der geplanten Durchführung mit       dem zuständigen Wassermeister zu besprechen und abzustimmen. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Nach Abschluss der Arbeiten muss die Wasserleitung wieder zwingend in </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Betrieb genommen werden!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Die Zulage - Position für die Tiefbauarbeiten wird im Gewerk Tiefbau </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Wasserleitung gesondert vergütet.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Die Koordination Tiefbau- und Montagearbeiten hat intern zwischen der </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  Tiefbau- und Rohrverlegefirma zu erfolgen.</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Hinweis:</span>
                              <span style="background:#FFFFFF;"> Ein Abweichen der hier ausgeschriebenen Zeitvorgabe ist nicht </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               zugelassen , der Anschluss am Bauende der Wasserleitung DZ NZ </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Isnyberg - 365 ist zeitlich getrennt auszuführen und wird auch </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               getrennt vergütet! </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Der Kalkulator hat bezüglich Arbeitsaufwand und Logistik alle </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Mehraufwendungen gegenüber der sonst ausgeschriebenen </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               LV - Positionen hier in der Zulage - Position einzurechnen.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">              </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> Eine Vergütung darüber hinaus erfolgt nicht!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Zulage - Position für alle Rohrverlege- und Montagearbeiten </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2010165" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Zulage</span>
                              <span style="background:#FFFFFF;"> - </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Position für alle Tiefbauarbeiten</span>
                              <span style="background:#FFFFFF;"> im Anschlussbereich neue Leitung/</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">vorhandene Bestandsleitung GGG DN 300 am Bauende DZ NZ Isnyberg - 365 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Folgende Leistungen sind einzukalkulieren:</span>
                            </p>
                            <p/>
